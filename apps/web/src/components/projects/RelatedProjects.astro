---
import type { CaseStudy } from '@netmarket/schemas';
import Container from '@/components/layout/Container.astro';
import Section from '@/components/layout/Section.astro';
import SectionHeading from '@/components/content/SectionHeading.astro';
import ProjectCard from '@/components/content/ProjectCard.astro';
import { projectClient, projectPath } from '@/lib/projects/content';
import { projectPresentation } from '@/lib/projects/presentation';
interface Props {
  projects: CaseStudy[];
}
const { projects } = Astro.props;
---

{
  projects.length > 0 && (
    <Section labelledby="case-related-title">
      <Container wide>
        <div class="nm-stack" style="--stack-gap: var(--nm-space-xl)">
          <SectionHeading
            id="case-related-title"
            eyebrow="Continua a esplorare"
            title="Progetti con sfide affini."
          />
          <div class="project-rail">
            {projects.map((project) => {
              const image = project.cover ?? project.image;
              const presentation = projectPresentation(project);
              return (
                image && (
                  <ProjectCard
                    title={projectClient(project)}
                    category={presentation.projectType}
                    description={presentation.intro}
                    image={image.url}
                    alt={image.alt}
                    width={image.width ?? undefined}
                    height={image.height ?? undefined}
                    srcset={image.srcset ?? undefined}
                    href={projectPath(project.slug)}
                  />
                )
              );
            })}
          </div>
        </div>
      </Container>
    </Section>
  )
}

---
import type { Metric } from '@netmarket/schemas';
import Container from '@/components/layout/Container.astro';
import Section from '@/components/layout/Section.astro';

interface Props {
  outcome?: string | undefined;
  metrics: Metric[];
}
const { outcome, metrics } = Astro.props;
const visibleMetrics = metrics.slice(0, 4);
---

{
  (outcome || visibleMetrics.length > 0) && (
    <Section class="case-results" labelledby="case-results-title">
      <Container wide>
        <div class="case-results__panel" data-reveal="up">
          <header>
            <p>Impatto</p>
            <h2 id="case-results-title">Cosa ha prodotto il progetto.</h2>
            {outcome && <p>{outcome}</p>}
          </header>
          {visibleMetrics.length > 0 && (
            <div class="case-results__metrics">
              {visibleMetrics.map((metric, index) => (
                <article class:list={[index === 0 && 'case-results__metric--primary']}>
                  <strong>{metric.value}</strong>
                  <span>{metric.label}</span>
                  {metric.context && <p>{metric.context}</p>}
                </article>
              ))}
            </div>
          )}
        </div>
      </Container>
    </Section>
  )
}

<style>
  .case-results {
    background: #fff;
  }
  .case-results__panel {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: clamp(2.5rem, 7vw, 8rem);
    padding: clamp(2rem, 5vw, 5rem);
    color: #fff;
    background: var(--case-ink);
    border-radius: var(--nm-radius-lg);
  }
  header {
    align-self: center;
  }
  header > p:first-child {
    margin: 0 0 1rem;
    color: var(--case-accent-light);
    font-size: 0.78rem;
    font-weight: 600;
    text-transform: uppercase;
  }
  h2 {
    max-width: 12ch;
    margin: 0;
    color: #fff;
    font-size: clamp(2.5rem, 5vw, 5rem);
    font-weight: 500;
    line-height: 0.98;
    letter-spacing: 0;
    text-wrap: balance;
  }
  header > p:last-child {
    max-width: 38rem;
    margin: 1.4rem 0 0;
    color: rgb(255 255 255 / 0.72);
    font-size: clamp(1.02rem, 1.3vw, 1.16rem);
    line-height: 1.58;
  }
  .case-results__metrics {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-top: 1px solid rgb(255 255 255 / 0.18);
    border-left: 1px solid rgb(255 255 255 / 0.18);
  }
  article {
    display: flex;
    flex-direction: column;
    min-height: 12rem;
    padding: clamp(1rem, 2vw, 1.5rem);
    border-right: 1px solid rgb(255 255 255 / 0.18);
    border-bottom: 1px solid rgb(255 255 255 / 0.18);
  }
  strong {
    margin-top: auto;
    color: #fff;
    font-size: clamp(2.5rem, 4.5vw, 4.5rem);
    font-weight: 500;
    line-height: 0.9;
    letter-spacing: 0;
  }
  span {
    margin-top: 0.8rem;
    color: #fff;
    font-size: 0.95rem;
    font-weight: 600;
  }
  article p {
    margin: 0.35rem 0 0;
    color: rgb(255 255 255 / 0.62);
    font-size: 0.8rem;
    line-height: 1.4;
  }
  @media (max-width: 800px) {
    .case-results__panel {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 520px) {
    .case-results__panel {
      margin-inline: calc(var(--nm-page-margin) * -0.35);
      padding: 1.4rem;
      border-radius: 1.1rem;
    }
    .case-results__metrics {
      grid-template-columns: 1fr;
    }
    article {
      min-height: 9rem;
    }
  }
</style>

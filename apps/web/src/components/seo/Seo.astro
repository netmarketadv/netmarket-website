---
import {
  absoluteCanonical,
  buildTitle,
  organizationJsonLd,
  webPageJsonLd,
  webSiteJsonLd
} from '@netmarket/seo';
import type { MediaAsset } from '@netmarket/schemas';
import { currentRobots } from '@/lib/seo/robots';
import { getPublicEnv } from '@/lib/env';

interface Props {
  title: string;
  description: string;
  path?: string;
  noindex?: boolean;
  noindexFollow?: boolean;
  canonicalSiteUrl?: string | undefined;
  structuredData?: Array<Record<string, unknown>>;
  socialTitle?: string | undefined;
  socialDescription?: string | undefined;
  socialImage?: MediaAsset | null | undefined;
}

const {
  title,
  description,
  path = '/',
  noindex = false,
  noindexFollow = false,
  canonicalSiteUrl,
  structuredData = [],
  socialTitle,
  socialDescription,
  socialImage
} = Astro.props;
const env = getPublicEnv();
const pageTitle = buildTitle(title);
const seoSiteUrl = canonicalSiteUrl ?? env.PUBLIC_SITE_URL;
const canonical = absoluteCanonical(seoSiteUrl, path);
const faviconUrl = absoluteCanonical(seoSiteUrl, '/icon-192.png');
const faviconLargeUrl = absoluteCanonical(seoSiteUrl, '/icon-512.png');
const appleTouchIconUrl = absoluteCanonical(seoSiteUrl, '/apple-touch-icon.png');
const manifestUrl = absoluteCanonical(seoSiteUrl, '/site.webmanifest');
const robots = currentRobots(noindex, noindexFollow);
const socialImageUrl = socialImage?.url
  ? absoluteCanonical(seoSiteUrl, socialImage.url)
  : undefined;
const jsonLd = [
  organizationJsonLd(seoSiteUrl),
  webSiteJsonLd(seoSiteUrl),
  webPageJsonLd({
    title: pageTitle,
    description,
    canonicalPath: path,
    siteUrl: seoSiteUrl,
    robots
  }),
  ...structuredData
];
---

<title>{pageTitle}</title>
<meta name="description" content={description} />
<meta name="robots" content={robots} />
<meta name="application-name" content="Netmarket" />
<meta name="theme-color" content="#155BFF" />
<meta name="msapplication-TileColor" content="#155BFF" />
<meta name="msapplication-TileImage" content={faviconUrl} />
<link rel="canonical" href={canonical} />
<link rel="icon" type="image/png" sizes="192x192" href={faviconUrl} />
<link rel="icon" type="image/png" sizes="512x512" href={faviconLargeUrl} />
<link rel="shortcut icon" type="image/png" href={faviconUrl} />
<link rel="apple-touch-icon" sizes="180x180" href={appleTouchIconUrl} />
<link rel="manifest" href={manifestUrl} />
<meta property="og:title" content={socialTitle || pageTitle} />
<meta property="og:description" content={socialDescription || description} />
<meta property="og:type" content={socialImageUrl ? 'article' : 'website'} />
<meta property="og:url" content={canonical} />
{socialImageUrl && <meta property="og:image" content={socialImageUrl} />}
{
  socialImageUrl && socialImage?.width && (
    <meta property="og:image:width" content={String(socialImage.width)} />
  )
}
{
  socialImageUrl && socialImage?.height && (
    <meta property="og:image:height" content={String(socialImage.height)} />
  )
}
{
  socialImageUrl && (
    <meta property="og:image:alt" content={socialImage?.alt || socialTitle || pageTitle} />
  )
}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={socialTitle || pageTitle} />
<meta name="twitter:description" content={socialDescription || description} />
{socialImageUrl && <meta name="twitter:image" content={socialImageUrl} />}
<script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

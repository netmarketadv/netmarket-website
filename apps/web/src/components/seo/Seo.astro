---
import {
  absoluteCanonical,
  buildTitle,
  organizationJsonLd,
  webPageJsonLd,
  webSiteJsonLd
} from '@netmarket/seo';
import type { MediaAsset } from '@netmarket/schemas';
import { currentRobots } from '@/lib/seo/robots';
import { getPublicEnv } from '@/lib/env';

interface Props {
  title: string;
  description: string;
  path?: string;
  noindex?: boolean;
  noindexFollow?: boolean;
  canonicalSiteUrl?: string | undefined;
  structuredData?: Array<Record<string, unknown>>;
  socialTitle?: string | undefined;
  socialDescription?: string | undefined;
  socialImage?: MediaAsset | null | undefined;
  socialType?: 'website' | 'article';
}

const {
  title,
  description,
  path = '/',
  noindex = false,
  noindexFollow = false,
  canonicalSiteUrl,
  structuredData = [],
  socialTitle,
  socialDescription,
  socialImage,
  socialType = 'website'
} = Astro.props;
const env = getPublicEnv();
const pageTitle = buildTitle(title);
const seoSiteUrl = canonicalSiteUrl ?? env.PUBLIC_SITE_URL;
const canonical = absoluteCanonical(seoSiteUrl, path);
const robots = currentRobots(noindex, noindexFollow);
const socialImageUrl = socialImage?.url
  ? absoluteCanonical(seoSiteUrl, socialImage.url)
  : undefined;
const jsonLd = [
  organizationJsonLd(seoSiteUrl),
  webSiteJsonLd(seoSiteUrl),
  webPageJsonLd({
    title: pageTitle,
    description,
    canonicalPath: path,
    siteUrl: seoSiteUrl,
    robots
  }),
  ...structuredData
];
---

<title>{pageTitle}</title>
<meta name="description" content={description} />
<meta name="robots" content={robots} />
<meta name="application-name" content="Netmarket" />
<meta name="apple-mobile-web-app-title" content="Netmarket" />
<meta name="theme-color" content="#155BFF" />
<meta name="msapplication-TileColor" content="#155BFF" />
<meta name="msapplication-TileImage" content="/mstile-150x150.png" />
<meta name="msapplication-config" content="/browserconfig.xml" />
<link
  rel="preload"
  href="/fonts/MonaSans-Regular.woff2"
  as="font"
  type="font/woff2"
  crossorigin="anonymous"
/>
<link
  rel="preload"
  href="/fonts/MonaSans-Medium.woff2"
  as="font"
  type="font/woff2"
  crossorigin="anonymous"
/>
<link
  rel="preload"
  href="/fonts/MonaSans-SemiBold.woff2"
  as="font"
  type="font/woff2"
  crossorigin="anonymous"
/>
<link rel="canonical" href={canonical} />
<link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="32x32" />
<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
<link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png" />
<link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png" />
<link rel="icon" type="image/png" sizes="512x512" href="/icon-512.png" />
<link rel="shortcut icon" type="image/x-icon" href="/favicon.ico" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />
<meta property="og:title" content={socialTitle || pageTitle} />
<meta property="og:description" content={socialDescription || description} />
<meta property="og:type" content={socialType} />
<meta property="og:url" content={canonical} />
{socialImageUrl && <meta property="og:image" content={socialImageUrl} />}
{
  socialImageUrl && socialImage?.width && (
    <meta property="og:image:width" content={String(socialImage.width)} />
  )
}
{
  socialImageUrl && socialImage?.height && (
    <meta property="og:image:height" content={String(socialImage.height)} />
  )
}
{
  socialImageUrl && (
    <meta property="og:image:alt" content={socialImage?.alt || socialTitle || pageTitle} />
  )
}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={socialTitle || pageTitle} />
<meta name="twitter:description" content={socialDescription || description} />
{socialImageUrl && <meta name="twitter:image" content={socialImageUrl} />}
{
  socialImageUrl && (
    <meta name="twitter:image:alt" content={socialImage?.alt || socialTitle || pageTitle} />
  )
}
<script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

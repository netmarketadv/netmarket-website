---
import {
  absoluteCanonical,
  buildTitle,
  organizationJsonLd,
  webPageJsonLd,
  webSiteJsonLd
} from '@netmarket/seo';
import { currentRobots } from '@/lib/seo/robots';
import { getPublicEnv } from '@/lib/env';

interface Props {
  title: string;
  description: string;
  path?: string;
  noindex?: boolean;
  noindexFollow?: boolean;
  canonicalSiteUrl?: string | undefined;
  structuredData?: Array<Record<string, unknown>>;
}

const {
  title,
  description,
  path = '/',
  noindex = false,
  noindexFollow = false,
  canonicalSiteUrl,
  structuredData = []
} = Astro.props;
const env = getPublicEnv();
const pageTitle = buildTitle(title);
const seoSiteUrl = canonicalSiteUrl ?? env.PUBLIC_SITE_URL;
const canonical = absoluteCanonical(seoSiteUrl, path);
const faviconUrl = absoluteCanonical(seoSiteUrl, '/icon-192.png');
const faviconLargeUrl = absoluteCanonical(seoSiteUrl, '/icon-512.png');
const appleTouchIconUrl = absoluteCanonical(seoSiteUrl, '/apple-touch-icon.png');
const manifestUrl = absoluteCanonical(seoSiteUrl, '/site.webmanifest');
const robots = currentRobots(noindex, noindexFollow);
const jsonLd = [
  organizationJsonLd(seoSiteUrl),
  webSiteJsonLd(seoSiteUrl),
  webPageJsonLd({
    title: pageTitle,
    description,
    canonicalPath: path,
    siteUrl: seoSiteUrl,
    robots
  }),
  ...structuredData
];
---

<title>{pageTitle}</title>
<meta name="description" content={description} />
<meta name="robots" content={robots} />
<meta name="application-name" content="Netmarket" />
<meta name="theme-color" content="#155BFF" />
<meta name="msapplication-TileColor" content="#155BFF" />
<meta name="msapplication-TileImage" content={faviconUrl} />
<link rel="canonical" href={canonical} />
<link rel="icon" type="image/png" sizes="192x192" href={faviconUrl} />
<link rel="icon" type="image/png" sizes="512x512" href={faviconLargeUrl} />
<link rel="shortcut icon" type="image/png" href={faviconUrl} />
<link rel="apple-touch-icon" sizes="180x180" href={appleTouchIconUrl} />
<link rel="manifest" href={manifestUrl} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:type" content="website" />
<meta property="og:url" content={canonical} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
<script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

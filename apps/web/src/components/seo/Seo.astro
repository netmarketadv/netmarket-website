---
import {
  absoluteCanonical,
  buildTitle,
  organizationJsonLd,
  webPageJsonLd,
  webSiteJsonLd
} from '@netmarket/seo';
import { currentRobots } from '@/lib/seo/robots';
import { getPublicEnv } from '@/lib/env';

interface Props {
  title: string;
  description: string;
  path?: string;
  noindex?: boolean;
}

const { title, description, path = '/', noindex = false } = Astro.props;
const env = getPublicEnv();
const pageTitle = buildTitle(title);
const canonical = absoluteCanonical(env.PUBLIC_SITE_URL, path);
const robots = currentRobots(noindex);
const jsonLd = [
  organizationJsonLd(env.PUBLIC_SITE_URL),
  webSiteJsonLd(env.PUBLIC_SITE_URL),
  webPageJsonLd({
    title: pageTitle,
    description,
    canonicalPath: path,
    siteUrl: env.PUBLIC_SITE_URL,
    robots
  })
];
---

<title>{pageTitle}</title>
<meta name="description" content={description} />
<meta name="robots" content={robots} />
<link rel="canonical" href={canonical} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:type" content="website" />
<meta property="og:url" content={canonical} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
<script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

---
import { IconArrowUpRight } from '@tabler/icons-astro';
import type { Insight } from '@netmarket/schemas';
import { formatDate, insightDescription, insightPath } from '@/lib/insights/content';

interface Props {
  insight: Insight;
  headingLevel?: 'h2' | 'h3';
  priority?: boolean;
}

const { insight, headingLevel = 'h3', priority = false } = Astro.props;
const Heading = headingLevel;
---

<article class="insight-card-editorial">
  <a href={insightPath(insight.slug)} aria-label={`Leggi: ${insight.title}`}>
    <span class="insight-card-editorial__media">
      {
        insight.image ? (
          <img
            src={insight.image.url}
            srcset={insight.image.srcset || undefined}
            sizes="(max-width: 767px) 92vw, (max-width: 1100px) 46vw, 32vw"
            alt={insight.image.alt}
            width={insight.image.width || 1200}
            height={insight.image.height || 800}
            loading={priority ? 'eager' : 'lazy'}
            fetchpriority={priority ? 'high' : 'auto'}
            decoding="async"
          />
        ) : (
          <span class="insight-card-editorial__placeholder" aria-hidden="true">Netmarket / Insight</span>
        )
      }
    </span>
    <span class="insight-card-editorial__body">
      <span class="insight-card-editorial__meta">
        <span>{insight.categories[0]?.name || 'Insight'}</span>
        <time datetime={insight.publishedAt}>{formatDate(insight.publishedAt)}</time>
      </span>
      <Heading>{insight.title}</Heading>
      <span class="insight-card-editorial__excerpt">{insightDescription(insight)}</span>
      <span class="insight-card-editorial__footer">
        <span>{insight.readingTime} min</span>
        <IconArrowUpRight stroke={1.7} aria-hidden="true" />
      </span>
    </span>
  </a>
</article>

<style>
  .insight-card-editorial,
  a {
    min-width: 0;
    height: 100%;
  }
  a {
    display: grid;
    grid-template-rows: auto 1fr;
    gap: 1.05rem;
    color: inherit;
    text-decoration: none;
  }
  .insight-card-editorial__media {
    display: block;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: var(--nm-radius-md);
    background: var(--nm-color-canvas);
  }
  img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--nm-motion-duration-slow) var(--nm-motion-ease-emphasized);
  }
  .insight-card-editorial__placeholder {
    width: 100%;
    height: 100%;
    display: grid;
    align-items: end;
    padding: 1.25rem;
    background: var(--nm-color-ink);
    color: rgb(255 255 255 / 0.62);
    font-size: var(--nm-text-small);
  }
  .insight-card-editorial__body {
    display: grid;
    align-content: start;
    gap: 0.8rem;
  }
  .insight-card-editorial__meta,
  .insight-card-editorial__footer {
    display: flex;
    justify-content: space-between;
    gap: 0.8rem;
    color: var(--nm-color-muted);
    font-size: 0.8rem;
    line-height: 1.3;
  }
  h2,
  h3 {
    font-size: clamp(1.45rem, 2vw, 2rem);
    font-weight: var(--nm-weight-medium);
    line-height: 1.07;
    letter-spacing: 0;
    text-wrap: balance;
  }
  .insight-card-editorial__excerpt {
    display: -webkit-box;
    overflow: hidden;
    color: var(--nm-color-muted);
    line-height: 1.5;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
  }
  .insight-card-editorial__footer {
    align-items: center;
    margin-top: auto;
    padding-top: 0.25rem;
  }
  svg {
    width: 1.2rem;
    height: 1.2rem;
    color: var(--nm-color-blue);
    transition: transform var(--nm-motion-duration-fast) var(--nm-motion-ease-standard);
  }
  @media (hover: hover) {
    a:hover img {
      transform: scale(1.025);
    }
    a:hover svg {
      transform: translate(0.15rem, -0.15rem);
    }
  }
  a:focus-visible {
    outline: 2px solid var(--nm-color-blue);
    outline-offset: 0.35rem;
    border-radius: var(--nm-radius-md);
  }
  @media (prefers-reduced-motion: reduce) {
    img,
    svg {
      transition: none;
    }
  }
</style>

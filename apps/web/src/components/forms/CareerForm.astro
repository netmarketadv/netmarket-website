---
import {
  IconArrowRight,
  IconChevronDown,
  IconFileText,
  IconLock,
  IconUpload
} from '@tabler/icons-astro';

const areas = [
  'Design e comunicazione',
  'Sviluppo web e software',
  'Marketing digitale',
  'Contenuti e produzione',
  'Organizzazione e account',
  'Altro'
];
---

<form
  class="contact-form career-form"
  data-career-form
  aria-describedby="career-form-status"
  novalidate
>
  <div class="contact-form__field contact-form__field--hidden" aria-hidden="true">
    <label for="career-website">Sito web</label>
    <input id="career-website" name="website" type="text" tabindex="-1" autocomplete="off" />
  </div>

  <div class="contact-form__grid">
    <label class="contact-form__field" for="career-name">
      <span>Nome <em>Obbligatorio</em></span>
      <input
        id="career-name"
        name="name"
        type="text"
        autocomplete="given-name"
        placeholder="Nome"
        required
        minlength="2"
        maxlength="60"
        aria-describedby="career-name-error"
      />
      <small id="career-name-error" class="contact-form__error" data-error-for="name"></small>
    </label>
    <label class="contact-form__field" for="career-surname">
      <span>Cognome <em>Obbligatorio</em></span>
      <input
        id="career-surname"
        name="surname"
        type="text"
        autocomplete="family-name"
        placeholder="Cognome"
        required
        minlength="2"
        maxlength="60"
        aria-describedby="career-surname-error"
      />
      <small id="career-surname-error" class="contact-form__error" data-error-for="surname"></small>
    </label>
    <label class="contact-form__field" for="career-email">
      <span>Email <em>Obbligatorio</em></span>
      <input
        id="career-email"
        name="email"
        type="email"
        autocomplete="email"
        inputmode="email"
        placeholder="nome@email.it"
        required
        aria-describedby="career-email-error"
      />
      <small id="career-email-error" class="contact-form__error" data-error-for="email"></small>
    </label>
    <label class="contact-form__field" for="career-area">
      <span>Area <em>Obbligatorio</em></span>
      <span class="contact-form__select">
        <select id="career-area" name="area" required aria-describedby="career-area-error">
          <option value="">Scegli l’area più vicina a te</option>
          {areas.map((area) => <option value={area}>{area}</option>)}
        </select>
        <IconChevronDown aria-hidden="true" stroke={1.8} />
      </span>
      <small id="career-area-error" class="contact-form__error" data-error-for="area"></small>
    </label>
  </div>

  <label class="contact-form__field" for="career-portfolio">
    <span>Portfolio o LinkedIn <em>Facoltativo</em></span>
    <input
      id="career-portfolio"
      name="portfolio"
      type="url"
      inputmode="url"
      autocomplete="url"
      placeholder="https://"
      maxlength="300"
      aria-describedby="career-portfolio-error"
    />
    <small id="career-portfolio-error" class="contact-form__error" data-error-for="portfolio"
    ></small>
  </label>

  <label class="contact-form__field" for="career-cv">
    <span>Curriculum vitae <em>Obbligatorio</em></span>
    <span class="career-file">
      <IconFileText aria-hidden="true" stroke={1.7} />
      <span
        ><strong data-cv-label>Seleziona il tuo CV</strong><small
          >PDF, DOC o DOCX · massimo 5 MB</small
        ></span
      >
      <IconUpload aria-hidden="true" stroke={1.7} />
      <input
        id="career-cv"
        name="cv"
        type="file"
        accept=".pdf,.doc,.docx,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document"
        required
        aria-describedby="career-cv-error"
      />
    </span>
    <small id="career-cv-error" class="contact-form__error" data-error-for="cv"></small>
  </label>

  <label class="contact-form__field" for="career-message">
    <span>Cosa sai fare e cosa vorresti costruire <em>Obbligatorio</em></span>
    <textarea
      id="career-message"
      name="message"
      rows="6"
      placeholder="Raccontaci brevemente esperienze, competenze e cosa stai cercando."
      required
      minlength="20"
      maxlength="2500"
      aria-describedby="career-message-hint career-message-error"></textarea>
    <span id="career-message-hint" class="contact-form__hint">Bastano poche righe concrete.</span>
    <small id="career-message-error" class="contact-form__error" data-error-for="message"></small>
  </label>

  <label class="contact-form__check" for="career-privacy">
    <input
      id="career-privacy"
      name="privacyConsent"
      type="checkbox"
      required
      aria-describedby="career-privacy-error"
    />
    <span
      >Ho letto l’<a
        href="https://www.iubenda.com/privacy-policy/69986431"
        target="_blank"
        rel="noopener noreferrer">informativa privacy</a
      > e autorizzo il trattamento dei dati per la candidatura.</span
    >
    <small id="career-privacy-error" class="contact-form__error" data-error-for="privacyConsent"
    ></small>
  </label>

  <div class="contact-form__footer">
    <button type="submit" class="contact-form__submit" data-motion-magnetic>
      <span data-submit-label>Invia candidatura</span>
      <IconArrowRight aria-hidden="true" stroke={1.9} />
    </button>
    <p class="contact-form__security">
      <IconLock aria-hidden="true" stroke={1.8} /> CV e dati vengono usati solo per valutare la candidatura.
    </p>
  </div>
  <p
    id="career-form-status"
    class="contact-form__status"
    role="status"
    aria-live="polite"
    tabindex="-1"
  >
  </p>
</form>

<script>
  import { pushEvent } from '@netmarket/analytics';
  import { submitCareerForm } from '@/lib/api/forms';

  const form = document.querySelector<HTMLFormElement>('[data-career-form]');
  const status = form?.querySelector<HTMLElement>('.contact-form__status');
  const button = form?.querySelector<HTMLButtonElement>('button[type="submit"]');
  const buttonLabel = button?.querySelector<HTMLElement>('[data-submit-label]');
  const cvInput = form?.querySelector<HTMLInputElement>('input[name="cv"]');
  const cvLabel = form?.querySelector<HTMLElement>('[data-cv-label]');
  const startedAt = Date.now();
  let started = false;
  let submitting = false;

  const errorMessages: Record<
    string,
    (input: HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement) => string
  > = {
    name: () => 'Inserisci il tuo nome.',
    surname: () => 'Inserisci il tuo cognome.',
    email: (input) =>
      input.validity.typeMismatch
        ? 'Inserisci un indirizzo email valido.'
        : 'Inserisci il tuo indirizzo email.',
    area: () => 'Scegli l’area più vicina alle tue competenze.',
    portfolio: () => 'Inserisci un indirizzo completo, per esempio https://portfolio.it.',
    cv: (input) => input.validationMessage || 'Allega il tuo curriculum vitae.',
    message: (input) =>
      input.validity.tooShort
        ? 'Raccontaci qualcosa in almeno 20 caratteri.'
        : 'Raccontaci cosa sai fare e cosa vorresti costruire.',
    privacyConsent: () => 'Per inviare la candidatura devi accettare l’informativa privacy.'
  };

  function validateCv(input: HTMLInputElement) {
    const file = input.files?.[0];
    input.setCustomValidity('');
    if (!file) return;
    const extension = file.name.split('.').pop()?.toLowerCase();
    if (!extension || !['pdf', 'doc', 'docx'].includes(extension)) {
      input.setCustomValidity('Allega un file PDF, DOC o DOCX.');
    } else if (file.size > 5 * 1024 * 1024) {
      input.setCustomValidity('Il CV non può superare 5 MB.');
    }
  }

  function setFieldState(
    input: HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement,
    showError = true
  ) {
    if (input instanceof HTMLInputElement && input.type === 'file') validateCv(input);
    const field = input.closest<HTMLElement>('.contact-form__field, .contact-form__check');
    const error = form?.querySelector<HTMLElement>(`[data-error-for="${input.name}"]`);
    const invalid = !input.validity.valid;
    field?.classList.toggle('contact-form__field--invalid', invalid && showError);
    input.setAttribute('aria-invalid', invalid && showError ? 'true' : 'false');
    if (error)
      error.textContent =
        invalid && showError
          ? (errorMessages[input.name]?.(input) ?? 'Controlla questo campo.')
          : '';
  }

  function firstInvalidControl() {
    return form?.querySelector<HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement>(
      'input:invalid, textarea:invalid, select:invalid'
    );
  }

  form?.addEventListener('input', (event) => {
    if (!started) {
      started = true;
      pushEvent({ event: 'contact_form_start', form_id: 'career-page' });
    }
    const target = event.target;
    if (
      target instanceof HTMLInputElement ||
      target instanceof HTMLTextAreaElement ||
      target instanceof HTMLSelectElement
    )
      setFieldState(target, false);
  });

  form?.addEventListener('change', (event) => {
    const target = event.target;
    if (
      target instanceof HTMLInputElement ||
      target instanceof HTMLTextAreaElement ||
      target instanceof HTMLSelectElement
    ) {
      setFieldState(target);
      if (target === cvInput && cvLabel)
        cvLabel.textContent = target.files?.[0]?.name || 'Seleziona il tuo CV';
    }
  });

  form?.addEventListener('focusout', (event) => {
    const target = event.target;
    if (
      target instanceof HTMLInputElement ||
      target instanceof HTMLTextAreaElement ||
      target instanceof HTMLSelectElement
    )
      setFieldState(target);
  });

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!form || !status || !button || !buttonLabel || submitting) return;
    const controls = [
      ...form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement>(
        'input:not([name="website"]), textarea, select'
      )
    ];
    controls.forEach((control) => setFieldState(control));
    if (!form.checkValidity()) {
      status.textContent = 'Ci sono alcuni campi da controllare.';
      status.dataset.state = 'error';
      firstInvalidControl()?.focus();
      return;
    }

    const data = new FormData(form);
    const cv = data.get('cv');
    if (!(cv instanceof File) || cv.size === 0) return;
    const area = String(data.get('area') || '');
    const portfolio = String(data.get('portfolio') || '').trim();
    const message = String(data.get('message') || '').trim();
    status.textContent = '';
    status.dataset.state = '';
    pushEvent({ event: 'contact_form_submit', form_id: 'career-page' });
    submitting = true;
    button.disabled = true;
    button.setAttribute('aria-busy', 'true');
    button.dataset.state = 'loading';
    buttonLabel.textContent = 'Invio in corso';

    try {
      await submitCareerForm(
        {
          name: `${String(data.get('name') || '').trim()} ${String(data.get('surname') || '').trim()}`,
          email: String(data.get('email') || ''),
          company: 'Candidatura spontanea',
          service: 'lavora-con-noi',
          message: `Area: ${area}\n${portfolio ? `Portfolio o LinkedIn: ${portfolio}\n` : ''}\n${message}`,
          privacyConsent: true,
          marketingConsent: false,
          website: String(data.get('website') || ''),
          sourceUrl: window.location.href,
          referrer: document.referrer || undefined,
          elapsedMs: Date.now() - startedAt
        },
        cv
      );
      pushEvent({ event: 'contact_form_success', form_id: 'career-page' });
      button.dataset.state = 'success';
      buttonLabel.textContent = 'Candidatura inviata';
      status.textContent = 'Candidatura inviata correttamente. Ti portiamo alla conferma.';
      status.dataset.state = 'success';
      window.location.assign('/grazie/');
    } catch (error) {
      const code = error instanceof Error ? error.message : 'career_form_failed';
      status.textContent =
        'Non siamo riusciti a inviare la candidatura. Puoi scriverci a segreteria@netmarket.it.';
      status.dataset.state = 'error';
      status.focus();
      pushEvent({ event: 'contact_form_error', form_id: 'career-page', error_code: code });
      submitting = false;
      button.disabled = false;
      button.removeAttribute('aria-busy');
      button.dataset.state = '';
      buttonLabel.textContent = 'Invia candidatura';
    }
  });
</script>

<style>
  .contact-form {
    display: grid;
    gap: clamp(1.15rem, 2vw, 1.6rem);
    margin: 0;
  }

  .contact-form__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1.15rem, 2vw, 1.5rem);
  }

  .contact-form__field {
    display: grid;
    gap: 0.55rem;
    min-width: 0;
    color: var(--nm-color-ink);
    font-size: 0.93rem;
    font-weight: 600;
  }

  .contact-form__field > span:first-child {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
  }

  .contact-form__field em {
    color: var(--nm-color-subtle);
    font-size: 0.68rem;
    font-style: normal;
    font-weight: 500;
    text-transform: uppercase;
  }

  .contact-form input,
  .contact-form textarea,
  .contact-form select {
    width: 100%;
    min-width: 0;
    border: 1px solid var(--nm-color-border-strong);
    border-radius: var(--nm-radius-control);
    padding: 0.95rem 1rem;
    background: var(--nm-color-surface);
    color: var(--nm-color-ink);
    font: inherit;
    font-weight: 400;
    transition:
      border-color var(--nm-motion-duration-fast) var(--nm-motion-ease-hover),
      box-shadow var(--nm-motion-duration-fast) var(--nm-motion-ease-hover),
      background var(--nm-motion-duration-fast) var(--nm-motion-ease-hover);
  }

  .contact-form input,
  .contact-form select {
    min-height: 3.4rem;
  }

  .contact-form textarea {
    min-height: 10.5rem;
    resize: vertical;
    line-height: 1.55;
  }

  .contact-form input::placeholder,
  .contact-form textarea::placeholder {
    color: #6e7683;
    opacity: 1;
  }

  .contact-form input:hover,
  .contact-form textarea:hover,
  .contact-form select:hover,
  .career-file:hover {
    border-color: #9ba6b5;
  }

  .contact-form input:focus-visible,
  .contact-form textarea:focus-visible,
  .contact-form select:focus-visible {
    border-color: var(--nm-color-blue);
    outline: 0;
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--nm-color-blue) 17%, transparent);
  }

  .contact-form__select {
    position: relative;
    display: block;
  }

  .contact-form__select select {
    appearance: none;
    padding-right: 3rem;
  }

  .contact-form__select svg {
    position: absolute;
    top: 50%;
    right: 1rem;
    width: 1.05rem;
    height: 1.05rem;
    color: var(--nm-color-muted);
    pointer-events: none;
    transform: translateY(-50%);
  }

  .career-file {
    position: relative;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: 0.9rem;
    align-items: center;
    min-height: 4.75rem;
    border: 1px solid var(--nm-color-border-strong);
    border-radius: var(--nm-radius-control);
    padding: 0.8rem 1rem;
    background: var(--nm-color-surface);
    cursor: pointer;
    transition:
      border-color var(--nm-motion-duration-fast) var(--nm-motion-ease-hover),
      box-shadow var(--nm-motion-duration-fast) var(--nm-motion-ease-hover);
  }

  .career-file > svg {
    width: 1.35rem;
    height: 1.35rem;
    color: var(--nm-color-blue);
  }

  .career-file > span {
    display: grid;
    gap: 0.15rem;
    min-width: 0;
  }

  .career-file strong,
  .career-file small {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .career-file strong {
    color: var(--nm-color-ink);
    font-size: 0.9rem;
    font-weight: 600;
  }

  .career-file small {
    color: var(--nm-color-muted);
    font-size: var(--nm-text-small);
    font-weight: 400;
  }

  .career-file input {
    position: absolute;
    inset: 0;
    min-height: 0;
    opacity: 0;
    cursor: pointer;
  }

  .career-file:has(input:focus-visible) {
    border-color: var(--nm-color-blue);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--nm-color-blue) 17%, transparent);
  }

  .contact-form__field--invalid input,
  .contact-form__field--invalid textarea,
  .contact-form__field--invalid select,
  .contact-form__field--invalid .career-file {
    border-color: var(--nm-color-error);
    background: color-mix(in srgb, var(--nm-color-error) 3%, white);
  }

  .contact-form__hint {
    color: var(--nm-color-muted);
    font-size: var(--nm-text-small);
    font-weight: 400;
  }

  .contact-form__error {
    color: var(--nm-color-error);
    font-size: 0.8rem;
    font-weight: 500;
    line-height: 1.4;
  }

  .contact-form__error:empty {
    display: none;
  }

  .contact-form__check {
    display: grid;
    grid-template-columns: 1.35rem minmax(0, 1fr);
    gap: 0.75rem;
    align-items: start;
    border-top: 1px solid var(--nm-color-border);
    padding-top: 1.25rem;
    color: var(--nm-color-ink-2);
    font-size: var(--nm-text-small);
    line-height: 1.55;
  }

  .contact-form__check input {
    appearance: none;
    display: grid;
    place-content: center;
    width: 1.35rem;
    min-height: 1.35rem;
    height: 1.35rem;
    margin: 0.08rem 0 0;
    border: 1px solid var(--nm-color-border-strong);
    border-radius: var(--nm-radius-xs);
    padding: 0;
    cursor: pointer;
  }

  .contact-form__check input::before {
    width: 0.68rem;
    height: 0.38rem;
    border-bottom: 2px solid #fff;
    border-left: 2px solid #fff;
    content: '';
    opacity: 0;
    transform: rotate(-45deg) scale(0.7);
  }

  .contact-form__check input:checked {
    border-color: var(--nm-color-blue);
    background: var(--nm-color-blue);
  }

  .contact-form__check input:checked::before {
    opacity: 1;
    transform: rotate(-45deg) scale(1);
  }

  .contact-form__check a {
    color: inherit;
    font-weight: 600;
    text-underline-offset: 0.18em;
  }

  .contact-form__check .contact-form__error {
    grid-column: 2;
  }

  .contact-form__footer {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .contact-form__submit {
    display: inline-flex;
    justify-content: space-between;
    align-items: center;
    gap: 2rem;
    min-width: 14rem;
    min-height: 3.5rem;
    border: 1px solid var(--nm-color-blue);
    border-radius: var(--nm-radius-pill);
    padding: 0.9rem 1.15rem 0.9rem 1.35rem;
    background: var(--nm-color-blue);
    color: #fff;
    font: inherit;
    font-weight: 600;
    cursor: pointer;
  }

  .contact-form__submit svg {
    width: 1.1rem;
    height: 1.1rem;
  }

  .contact-form__submit:hover:not(:disabled) {
    background: var(--nm-color-blue-deep);
    transform: translateY(-2px);
  }

  .contact-form__submit:focus-visible,
  .contact-form__check input:focus-visible {
    outline: 3px solid color-mix(in srgb, var(--nm-color-blue) 28%, transparent);
    outline-offset: 3px;
  }

  .contact-form__security {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--nm-color-muted);
    font-size: var(--nm-text-small);
    line-height: 1.45;
  }

  .contact-form__security svg {
    width: 1rem;
    height: 1rem;
    flex: none;
  }

  .contact-form__status {
    min-height: 1.5rem;
    color: var(--nm-color-muted);
  }

  .contact-form__status[data-state='error'] {
    color: var(--nm-color-error);
  }

  .contact-form__status[data-state='success'] {
    color: var(--nm-color-success);
  }

  .contact-form__field--hidden {
    position: absolute;
    left: -100vw;
  }

  @media (max-width: 680px) {
    .contact-form__grid {
      grid-template-columns: 1fr;
    }

    .contact-form__footer {
      align-items: stretch;
      flex-direction: column;
    }

    .contact-form__submit {
      width: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .contact-form input,
    .contact-form textarea,
    .contact-form select,
    .career-file,
    .contact-form__submit {
      transition: none;
    }
  }
</style>

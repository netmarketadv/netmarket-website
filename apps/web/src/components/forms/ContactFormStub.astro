<form class="contact-form" aria-describedby="contact-form-note">
  <input
    type="text"
    name="website"
    tabindex="-1"
    autocomplete="off"
    class="visually-hidden"
    aria-hidden="true"
  />
  <div class="field">
    <label for="contact-name">Nome</label>
    <input id="contact-name" name="name" type="text" autocomplete="name" disabled />
  </div>
  <div class="field">
    <label for="contact-email">Email</label>
    <input id="contact-email" name="email" type="email" autocomplete="email" disabled />
  </div>
  <div class="field">
    <label for="contact-message">Messaggio</label>
    <textarea id="contact-message" name="message" rows="4" disabled></textarea>
  </div>
  <label class="checkbox">
    <input type="checkbox" disabled />
    <span>Consenso privacy richiesto prima dell'invio.</span>
  </label>
  <button type="button" disabled>Invio non ancora attivo</button>
  <p id="contact-form-note">
    Il flusso form e l'endpoint sicuro saranno completati nella fase CMS.
  </p>
</form>

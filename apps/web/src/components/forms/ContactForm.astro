---
import Button from '@/components/ui/Button.astro';
import '@/styles/forms.css';
import { IconArrowRight, IconChevronDown, IconLock } from '@tabler/icons-astro';
import { getServiceArchiveData } from '@/lib/services/content';

const { services } = await getServiceArchiveData();
const interestOptions = [
  ...services.map((service) => ({ value: service.slug, label: service.title })),
  { value: 'nod', label: 'NØD' },
  { value: 'progetto-integrato', label: 'Progetto integrato' },
  { value: 'altro', label: 'Altro' }
];
---

<form class="contact-form" data-contact-form aria-describedby="contact-form-status" novalidate>
  <div class="contact-form__field contact-form__field--hidden" aria-hidden="true">
    <label for="contact-website">Sito web</label>
    <input id="contact-website" name="website" type="text" tabindex="-1" autocomplete="off" />
  </div>

  <div class="contact-form__grid">
    <label class="contact-form__field" for="contact-name">
      <span>Nome <em>Obbligatorio</em></span>
      <input
        id="contact-name"
        name="name"
        type="text"
        autocomplete="name"
        placeholder="Nome e cognome"
        required
        minlength="2"
        maxlength="120"
        aria-describedby="contact-name-error"
      />
      <small id="contact-name-error" class="contact-form__error" data-error-for="name"></small>
    </label>

    <label class="contact-form__field" for="contact-email">
      <span>Email <em>Obbligatorio</em></span>
      <input
        id="contact-email"
        name="email"
        type="email"
        autocomplete="email"
        inputmode="email"
        placeholder="nome@azienda.it"
        required
        aria-describedby="contact-email-error"
      />
      <small id="contact-email-error" class="contact-form__error" data-error-for="email"></small>
    </label>

    <label class="contact-form__field" for="contact-company">
      <span>Azienda <em>Facoltativo</em></span>
      <input
        id="contact-company"
        name="company"
        type="text"
        autocomplete="organization"
        placeholder="Nome dell’azienda"
        maxlength="120"
        aria-describedby="contact-company-error"
      />
      <small id="contact-company-error" class="contact-form__error" data-error-for="company"
      ></small>
    </label>

    <label class="contact-form__field" for="contact-phone">
      <span>Telefono <em>Facoltativo</em></span>
      <input
        id="contact-phone"
        name="phone"
        type="tel"
        autocomplete="tel"
        inputmode="tel"
        placeholder="+39"
        maxlength="40"
        aria-describedby="contact-phone-error"
      />
      <small id="contact-phone-error" class="contact-form__error" data-error-for="phone"></small>
    </label>
  </div>

  <label class="contact-form__field" for="contact-service">
    <span>Su cosa vuoi lavorare? <em>Obbligatorio</em></span>
    <span class="contact-form__select">
      <select id="contact-service" name="service" required aria-describedby="contact-service-error">
        <option value="">Scegli un ambito</option>
        {interestOptions.map((option) => <option value={option.value}>{option.label}</option>)}
      </select>
      <IconChevronDown aria-hidden="true" stroke={1.8} />
    </span>
    <small id="contact-service-error" class="contact-form__error" data-error-for="service"></small>
  </label>

  <label class="contact-form__field" for="contact-message">
    <span>Raccontaci brevemente il progetto <em>Obbligatorio</em></span>
    <textarea
      id="contact-message"
      name="message"
      rows="6"
      placeholder="Obiettivo, situazione attuale, eventuali scadenze o priorità."
      required
      minlength="10"
      maxlength="3000"
      aria-describedby="contact-message-hint contact-message-error"></textarea>
    <span id="contact-message-hint" class="contact-form__hint"
      >Bastano poche righe per iniziare.</span
    >
    <small id="contact-message-error" class="contact-form__error" data-error-for="message"></small>
  </label>

  <label class="contact-form__check" for="contact-privacy">
    <input
      id="contact-privacy"
      name="privacyConsent"
      type="checkbox"
      required
      aria-describedby="contact-privacy-error"
    />
    <span>
      Ho letto l’<a
        href="https://www.iubenda.com/privacy-policy/69986431"
        target="_blank"
        rel="noopener noreferrer">informativa privacy</a
      > e autorizzo il trattamento dei dati per essere ricontattato.
    </span>
    <small id="contact-privacy-error" class="contact-form__error" data-error-for="privacyConsent"
    ></small>
  </label>

  <div class="contact-form__footer">
    <Button type="submit" size="large" class="contact-form__submit" magnetic>
      <span data-submit-label>Invia la richiesta</span>
      <IconArrowRight aria-hidden="true" stroke={1.9} />
    </Button>
    <p class="contact-form__security">
      <IconLock aria-hidden="true" stroke={1.8} /> I dati vengono usati solo per rispondere alla richiesta.
    </p>
  </div>

  <p
    id="contact-form-status"
    class="contact-form__status"
    role="status"
    aria-live="polite"
    tabindex="-1"
  >
  </p>
</form>

<script>
  import { pushEvent } from '@netmarket/analytics';
  import { submitContactForm } from '@/lib/api/forms';

  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
  const status = form?.querySelector<HTMLElement>('.contact-form__status');
  const button = form?.querySelector<HTMLButtonElement>('button[type="submit"]');
  const buttonLabel = button?.querySelector<HTMLElement>('[data-submit-label]');
  try {
    const draft = sessionStorage.getItem('nm_contact_email_draft');
    const email = form?.querySelector<HTMLInputElement>('input[name="email"]');
    if (draft && email && !email.value) email.value = draft;
    sessionStorage.removeItem('nm_contact_email_draft');
  } catch {
    /* The form remains usable when storage is unavailable. */
  }
  const startedAt = Date.now();
  let started = false;
  let submitting = false;

  const trackingKeys = [
    'utm_source',
    'utm_medium',
    'utm_campaign',
    'utm_content',
    'utm_term',
    'gclid',
    'fbclid',
    'ttclid',
    'oppref'
  ];

  const errorMessages: Record<
    string,
    (input: HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement) => string
  > = {
    name: (input) =>
      input.validity.tooShort
        ? 'Inserisci almeno nome e cognome, oppure il tuo nome completo.'
        : 'Inserisci il tuo nome.',
    email: (input) =>
      input.validity.typeMismatch
        ? 'Inserisci un indirizzo email valido.'
        : 'Inserisci il tuo indirizzo email.',
    service: () => 'Scegli l’ambito su cui vuoi lavorare.',
    message: (input) =>
      input.validity.tooShort
        ? 'Raccontaci il progetto in almeno 10 caratteri.'
        : 'Raccontaci brevemente il progetto.',
    privacyConsent: () => 'Per inviare la richiesta devi accettare l’informativa privacy.'
  };

  function persistTracking() {
    const params = new URLSearchParams(window.location.search);
    const stored = JSON.parse(sessionStorage.getItem('nm_contact_tracking') || '{}') as Record<
      string,
      string
    >;
    const next = { ...stored };
    for (const key of trackingKeys) {
      const value = params.get(key);
      if (value) next[key] = value;
    }
    if (!next.referrer && document.referrer) next.referrer = document.referrer;
    if (Object.keys(next).length > 0) {
      sessionStorage.setItem('nm_contact_tracking', JSON.stringify(next));
    }
  }

  function collectTracking() {
    const stored = JSON.parse(sessionStorage.getItem('nm_contact_tracking') || '{}') as Record<
      string,
      string
    >;
    const params = new URLSearchParams(window.location.search);
    return Object.fromEntries(
      trackingKeys
        .map((key) => [key, params.get(key) || stored[key] || ''])
        .filter(([, value]) => value)
    );
  }

  function setFieldState(
    input: HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement,
    showError = true
  ) {
    const field = input.closest<HTMLElement>('.contact-form__field, .contact-form__check');
    const error = form?.querySelector<HTMLElement>(`[data-error-for="${input.name}"]`);
    const invalid = !input.validity.valid;
    field?.classList.toggle('contact-form__field--invalid', invalid && showError);
    input.setAttribute('aria-invalid', invalid && showError ? 'true' : 'false');
    if (error) {
      error.textContent =
        invalid && showError
          ? (errorMessages[input.name]?.(input) ?? 'Controlla questo campo.')
          : '';
    }
    return invalid;
  }

  function firstInvalidControl() {
    return form?.querySelector<HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement>(
      'input:invalid, textarea:invalid, select:invalid'
    );
  }

  persistTracking();

  form?.addEventListener('input', (event) => {
    if (!started) {
      started = true;
      pushEvent({ event: 'contact_form_start', form_id: 'contact-page' });
    }
    const target = event.target;
    if (
      target instanceof HTMLInputElement ||
      target instanceof HTMLTextAreaElement ||
      target instanceof HTMLSelectElement
    ) {
      setFieldState(target, false);
    }
  });

  form?.addEventListener('change', (event) => {
    const target = event.target;
    if (
      target instanceof HTMLInputElement ||
      target instanceof HTMLTextAreaElement ||
      target instanceof HTMLSelectElement
    ) {
      setFieldState(target);
    }
  });

  form?.addEventListener('focusout', (event) => {
    const target = event.target;
    if (
      target instanceof HTMLInputElement ||
      target instanceof HTMLTextAreaElement ||
      target instanceof HTMLSelectElement
    ) {
      setFieldState(target);
    }
  });

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!form || !status || !button || !buttonLabel || submitting) return;

    const controls = [
      ...form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement>(
        'input:not([name="website"]), textarea, select'
      )
    ];
    controls.forEach((control) => setFieldState(control));
    if (!form.checkValidity()) {
      status.textContent = 'Ci sono alcuni campi da controllare.';
      status.dataset.state = 'error';
      firstInvalidControl()?.focus();
      return;
    }

    const data = new FormData(form);
    const hasPrivacyConsent = data.get('privacyConsent') === 'on';
    if (!hasPrivacyConsent) {
      status.textContent = 'Per inviare la richiesta devi accettare l’informativa privacy.';
      status.dataset.state = 'error';
      form.querySelector<HTMLInputElement>('input[name="privacyConsent"]')?.focus();
      return;
    }

    status.textContent = '';
    status.dataset.state = '';
    pushEvent({ event: 'contact_form_submit', form_id: 'contact-page' });
    submitting = true;
    button.disabled = true;
    button.setAttribute('aria-busy', 'true');
    button.dataset.state = 'loading';
    buttonLabel.textContent = 'Invio in corso';

    try {
      await submitContactForm({
        name: String(data.get('name') || ''),
        email: String(data.get('email') || ''),
        company: String(data.get('company') || ''),
        phone: String(data.get('phone') || ''),
        service: String(data.get('service') || ''),
        message: String(data.get('message') || ''),
        privacyConsent: true,
        marketingConsent: false,
        website: String(data.get('website') || ''),
        utm: collectTracking(),
        sourceUrl: window.location.href,
        referrer:
          document.referrer ||
          JSON.parse(sessionStorage.getItem('nm_contact_tracking') || '{}').referrer ||
          undefined,
        elapsedMs: Date.now() - startedAt
      });
      pushEvent({ event: 'contact_form_success', form_id: 'contact-page' });
      sessionStorage.setItem('nm_generate_lead_pending', 'contact-page');
      button.dataset.state = 'success';
      buttonLabel.textContent = 'Richiesta inviata';
      status.textContent = 'Richiesta inviata correttamente. Ti portiamo alla conferma.';
      status.dataset.state = 'success';
      window.location.assign('/grazie/');
    } catch (error) {
      const message = error instanceof Error ? error.message : 'contact_form_failed';
      status.textContent = 'Non siamo riusciti a inviare il messaggio. Puoi scriverci via email.';
      status.dataset.state = 'error';
      status.focus();
      pushEvent({ event: 'contact_form_error', form_id: 'contact-page', error_code: message });
      submitting = false;
      button.disabled = false;
      button.removeAttribute('aria-busy');
      button.dataset.state = '';
      buttonLabel.textContent = 'Invia la richiesta';
    }
  });
</script>

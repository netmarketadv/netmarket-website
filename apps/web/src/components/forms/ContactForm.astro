---
import { getServiceArchiveData } from '@/lib/services/content';

const { services } = await getServiceArchiveData();
---

<form class="contact-form" data-contact-form aria-describedby="contact-form-status">
  <div class="contact-form__field contact-form__field--hidden" aria-hidden="true">
    <label for="contact-website">Sito web</label>
    <input id="contact-website" name="website" type="text" tabindex="-1" autocomplete="off" />
  </div>

  <div class="contact-form__grid">
    <label>
      <span>Nome</span>
      <input name="name" type="text" autocomplete="name" required minlength="2" />
    </label>
    <label>
      <span>Email</span>
      <input name="email" type="email" autocomplete="email" required />
    </label>
    <label>
      <span>Azienda</span>
      <input name="company" type="text" autocomplete="organization" maxlength="120" />
    </label>
    <label>
      <span>Telefono</span>
      <input name="phone" type="tel" autocomplete="tel" maxlength="40" />
    </label>
  </div>

  <label>
    <span>Interesse</span>
    <select name="service">
      <option value="">Seleziona un servizio</option>
      {services.map((service) => <option value={service.slug}>{service.title}</option>)}
      <option value="altro">Altro</option>
    </select>
  </label>

  <label>
    <span>Messaggio</span>
    <textarea name="message" rows="6" required minlength="10" maxlength="3000"></textarea>
  </label>

  <label class="contact-form__check">
    <input name="privacyConsent" type="checkbox" required />
    <span
      >Ho letto l’informativa privacy e autorizzo il trattamento dei dati per essere ricontattato.</span
    >
  </label>
  <label class="contact-form__check">
    <input name="marketingConsent" type="checkbox" />
    <span>Autorizzo l’invio di comunicazioni informative e commerciali Netmarket.</span>
  </label>

  <p>
    <a href="https://www.iubenda.com/privacy-policy/69986431">Privacy policy</a>
  </p>

  <button type="submit" class="button button--primary" data-motion-magnetic>Invia richiesta</button>
  <p id="contact-form-status" class="contact-form__status" role="status" aria-live="polite"></p>
</form>

<script>
  import { pushEvent } from '@netmarket/analytics';
  import { submitContactForm } from '@/lib/api/forms';

  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
  const status = form?.querySelector<HTMLElement>('.contact-form__status');
  let started = false;

  function collectTracking() {
    const params = new URLSearchParams(window.location.search);
    const keys = [
      'utm_source',
      'utm_medium',
      'utm_campaign',
      'utm_content',
      'utm_term',
      'gclid',
      'fbclid',
      'ttclid',
      'oppref'
    ];
    return Object.fromEntries(
      keys.map((key) => [key, params.get(key) || '']).filter(([, value]) => value)
    );
  }

  form?.addEventListener('input', () => {
    if (started) return;
    started = true;
    pushEvent({ event: 'contact_form_start', form_id: 'contact-page' });
  });

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!form || !status) return;
    if (!form.checkValidity()) {
      form.reportValidity();
      return;
    }
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    const data = new FormData(form);
    status.textContent = '';
    pushEvent({ event: 'contact_form_submit', form_id: 'contact-page' });
    button?.setAttribute('disabled', 'true');
    try {
      await submitContactForm({
        name: String(data.get('name') || ''),
        email: String(data.get('email') || ''),
        company: String(data.get('company') || ''),
        phone: String(data.get('phone') || ''),
        service: String(data.get('service') || ''),
        message: String(data.get('message') || ''),
        privacyConsent: true,
        marketingConsent: data.get('marketingConsent') === 'on',
        website: String(data.get('website') || ''),
        utm: collectTracking(),
        sourceUrl: window.location.href,
        referrer: document.referrer || undefined
      });
      form.reset();
      status.textContent = 'Grazie, abbiamo ricevuto la richiesta.';
      status.focus();
      pushEvent({ event: 'contact_form_success', form_id: 'contact-page' });
    } catch (error) {
      const message = error instanceof Error ? error.message : 'contact_form_failed';
      status.textContent = 'Non siamo riusciti a inviare il messaggio. Puoi scriverci via email.';
      pushEvent({ event: 'contact_form_error', form_id: 'contact-page', error_code: message });
    } finally {
      button?.removeAttribute('disabled');
    }
  });
</script>

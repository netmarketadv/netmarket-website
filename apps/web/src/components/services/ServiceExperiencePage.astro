---
import ContactCTA from '@/components/blocks/ContactCTA.astro';
import SectionHeading from '@/components/content/SectionHeading.astro';
import type { RelationSummary, Service } from '@netmarket/schemas';
import {
  IconArrowRight,
  IconBolt,
  IconBrandInstagram,
  IconBrush,
  IconChartBar,
  IconCheck,
  IconCode,
  IconFileText,
  IconLink,
  IconMapPin,
  IconPhoto,
  IconSearch,
  IconShoppingBag,
  IconSparkles,
  IconTargetArrow
} from '@tabler/icons-astro';
import FAQBlock from '@/components/blocks/FAQBlock.astro';
import ProjectCard from '@/components/content/ProjectCard.astro';
import Button from '@/components/ui/Button.astro';
import { serviceExperiences, type ServiceExperienceSlug } from '@/data/service-experiences';
import { serviceTechnicalFocus } from '@/data/service-pilots';
import { relationPath, textItems } from '@/lib/services/content';

interface Props {
  service: Service;
  related: {
    caseStudies: RelationSummary[];
    insights: RelationSummary[];
    resources: RelationSummary[];
    services: RelationSummary[];
  };
  faqItems: [string, string][];
  variant: ServiceExperienceSlug;
}

const { service, related, faqItems, variant } = Astro.props;
const experience = serviceExperiences[variant];
const values = textItems(service.valueProps).slice(0, 4);
const problems = textItems(service.problems).slice(0, 4);
const process = textItems(service.process).slice(0, 4);
const technical = serviceTechnicalFocus(service).slice(0, 3);
const results = service.results
  .filter((item) => Boolean(item) && typeof item === 'object')
  .map((item) => {
    const record = item as Record<string, unknown>;
    return {
      label: typeof record.label === 'string' ? record.label : '',
      value: typeof record.value === 'string' ? record.value : '',
      context: typeof record.context === 'string' ? record.context : ''
    };
  })
  .filter((item) => item.label && item.value)
  .slice(0, 3);
const capabilities = service.capabilities.slice(0, 6);
const projects = related.caseStudies.filter((item) => item.image).slice(0, 3);
const accentIndex = experience.h1.indexOf(experience.accent);
const hasH1Accent = accentIndex >= 0;
const h1Before = hasH1Accent ? experience.h1.slice(0, accentIndex) : experience.h1;
const h1After = hasH1Accent ? experience.h1.slice(accentIndex + experience.accent.length) : '';

const iconSet = {
  ecommerce: [IconShoppingBag, IconSearch, IconTargetArrow, IconChartBar],
  'software-e-integrazioni': [IconLink, IconCode, IconBolt, IconChartBar],
  seo: [IconSearch, IconFileText, IconLink, IconChartBar],
  advertising: [IconTargetArrow, IconSparkles, IconChartBar, IconArrowRight],
  'social-media': [IconBrandInstagram, IconFileText, IconSparkles, IconChartBar],
  'branding-e-comunicazione': [IconBrush, IconSparkles, IconFileText, IconPhoto],
  'content-production': [IconPhoto, IconFileText, IconSparkles, IconBrandInstagram],
  'concorsi-a-premi': [IconSparkles, IconFileText, IconCode, IconCheck]
} as const;
const icons = iconSet[variant];
const valueItems = values.map((item, index) => ({
  ...item,
  icon: icons[index] as typeof IconSparkles
}));
const technicalItems = technical.map((item, index) => ({
  ...item,
  icon: icons[(index + 1) % icons.length] as typeof IconSparkles
}));

const projectCopy: Record<string, { client: string; description: string }> = {
  'sviluppo-e-commerce-per-tavoli-e-sedie-per-la-casa': {
    client: 'Pazzo Design',
    description: 'Ecommerce e strategia digitale per far crescere un catalogo di arredamento.'
  },
  'casi-studio-strategia-digitale-ecommerce-brb': {
    client: 'BRB',
    description: 'Ecommerce, contenuti, social e SEO coordinati in un unico progetto.'
  },
  'app-mobile-programma-fedelta-sirene-blu': {
    client: 'Sirene Blu',
    description: 'App loyalty e integrazione con i sistemi operativi dei punti vendita.'
  },
  'sviluppo-crm-custom-venitaly': {
    client: 'Venitaly',
    description: 'CRM su misura costruito attorno ai flussi operativi del team.'
  },
  'sviluppo-sito-web-allestimenti-fieristici-albertini': {
    client: 'Albertini',
    description: 'Sito, architettura e contenuti per gli allestimenti fieristici.'
  },
  'sviluppo-sito-web-fotovoltaico-progetto-e': {
    client: 'Progetto-e',
    description: 'Sito e contenuti SEO per il fotovoltaico industriale.'
  },
  'sviluppo-sito-web-e-shooting-fotografico-per-rigomar-una-presenza-digitale-piu-autorevole-per-il-mondo-della-produzione-moda':
    {
      client: 'Rigomar',
      description: 'Sito e shooting fotografico per raccontare una produzione moda B2B.'
    },
  'concorso-a-premi-sirene-blu-2024-ideazione-sviluppo-e-gestione-completa': {
    client: 'Sirene Blu',
    description: 'Concept, piattaforma e gestione di un concorso a premi multicanale.'
  }
};
---

<article class:list={['service-x', `service-x--${variant}`]}>
  <section class="service-x-hero" aria-labelledby="page-title">
    <nav class="breadcrumb service-page-breadcrumb" aria-label="Breadcrumb">
      <a href="/">Home</a><span aria-hidden="true">/</span><a href="/servizi/">Servizi</a><span
        aria-hidden="true">/</span
      ><span>{service.title}</span>
    </nav>
    <div class="service-x-hero__copy" data-reveal="line">
      <p class="nm-meta">{experience.eyebrow}</p>
      <h1 id="page-title">
        {h1Before}{hasH1Accent && <span class="nm-heading-accent">{experience.accent}</span>}{
          h1After
        }
      </h1>
      <p>{service.shortDescription}</p>
      <div class="service-x-actions">
        <Button href="#contatti" magnetic>Parliamone</Button>
        <a href="#come-lavoriamo"
          >Come lavoriamo <IconArrowRight stroke={1.8} aria-hidden="true" /></a
        >
      </div>
    </div>
  </section>

  <section class="service-x-intro" aria-labelledby="service-x-intro-title">
    <div class="service-x-heading" data-reveal="line">
      <p class="nm-meta">Il punto di partenza</p>
      <h2 id="service-x-intro-title">{experience.introTitle}</h2>
      <p>{service.excerpt}</p>
      <p class="service-x-territory">
        <IconMapPin stroke={1.7} aria-hidden="true" />{experience.territoryText}
      </p>
    </div>
    <div class="service-x-values" data-reveal="up" data-reveal-stagger="1">
      {
        valueItems.map(({ title, description, icon: Icon }) => (
          <article>
            <span class="service-icon-medallion">
              <Icon stroke={1.7} aria-hidden="true" />
            </span>
            <h3>{title}</h3>
            {description && <p>{description}</p>}
          </article>
        ))
      }
    </div>
  </section>

  <section class="service-x-problems" aria-labelledby="service-x-problems-title">
    <SectionHeading
      id="service-x-problems-title"
      eyebrow="Cosa risolviamo"
      title={experience.problemsTitle}
      tone="inverse"
      reveal
    />
    <div data-reveal="up" data-reveal-stagger="1">
      {
        problems.map((item, index) => (
          <article>
            <>
              <span>{String(index + 1).padStart(2, '0')}</span>
              <div>
                <h3>{item.title}</h3>
                {item.description && <p>{item.description}</p>}
              </div>
            </>
          </article>
        ))
      }
    </div>
  </section>

  <section class="service-x-system" aria-labelledby="service-x-system-title">
    <SectionHeading
      id="service-x-system-title"
      eyebrow="Il sistema"
      title={experience.systemTitle}
      reveal
    />
    <div class="service-x-system__list" data-reveal="up" data-reveal-stagger="1">
      {
        technicalItems.map(({ title, description, icon: Icon }) => (
          <article>
            <span class="service-icon-medallion">
              <Icon stroke={1.7} aria-hidden="true" />
            </span>
            <div>
              <h3>{title}</h3>
              <p>{description}</p>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  {
    results.length > 0 && (
      <section class="service-x-proof" aria-labelledby="service-x-proof-title">
        <SectionHeading
          id="service-x-proof-title"
          eyebrow="Evidenze"
          title={experience.proofTitle}
          text={experience.proofText}
          reveal
        />
        <div class="service-x-proof__grid" data-reveal="up" data-reveal-stagger="1">
          {results.map((item) => (
            <article>
              <span>{item.label}</span>
              <strong>{item.value}</strong>
              {item.context && <p>{item.context}</p>}
            </article>
          ))}
        </div>
      </section>
    )
  }

  <section class="service-x-process" id="come-lavoriamo" aria-labelledby="service-x-process-title">
    <SectionHeading
      id="service-x-process-title"
      eyebrow="Metodo"
      title={experience.processTitle}
      reveal
    />
    <ol data-reveal="up" data-reveal-stagger="1">
      {
        process.map((item, index) => (
          <li>
            <>
              <span>{String(index + 1).padStart(2, '0')}</span>
              <div>
                <h3>{item.title}</h3>
                {item.description && <p>{item.description}</p>}
              </div>
            </>
          </li>
        ))
      }
    </ol>
  </section>

  {
    projects.length > 0 && (
      <section class="service-x-projects" aria-labelledby="service-x-projects-title">
        <SectionHeading
          id="service-x-projects-title"
          eyebrow="Progetti"
          title={experience.projectsTitle}
          text={experience.projectsText}
          reveal
        />
        <div class="service-x-project-grid" data-reveal="up" data-reveal-stagger="1">
          {projects.map((project) => {
            const copy = projectCopy[project.slug];
            return (
              <ProjectCard
                title={copy?.client ?? project.title}
                category="Progetto"
                description={
                  copy?.description ?? 'Un progetto Netmarket collegato a questo servizio.'
                }
                image={project.image!.url}
                alt={project.image!.alt}
                href={relationPath(project)}
              />
            );
          })}
        </div>
      </section>
    )
  }

  <section class="service-x-scope" aria-labelledby="service-x-scope-title">
    <SectionHeading
      id="service-x-scope-title"
      eyebrow="Competenze"
      title="Il perimetro prende forma sul progetto."
      reveal
    />
    <ul>
      {
        capabilities.map((item) => (
          <li>
            <IconCheck stroke={1.8} aria-hidden="true" />
            {item.name}
          </li>
        ))
      }
    </ul>
  </section>

  {
    faqItems.length > 0 && (
      <section class="service-x-faq">
        <FAQBlock
          titleId="service-faq-title"
          title="FAQ essenziali."
          text={`Le prime risposte per valutare un progetto di ${service.title.toLowerCase()}.`}
          items={faqItems}
        />
      </section>
    )
  }

  <section class="service-x-conversion" id="contatti" aria-labelledby="service-x-cta-title">
    <ContactCTA
      titleId="service-x-cta-title"
      eyebrow="Parliamone"
      title={experience.ctaTitle}
      text={experience.ctaText}
    />
  </section>
</article>

---
import type { RelationSummary } from '@netmarket/schemas';
import ProjectCard from '@/components/content/ProjectCard.astro';
import { relationPath } from '@/lib/services/content';

interface Props {
  caseStudies: RelationSummary[];
  insights: RelationSummary[];
  resources: RelationSummary[];
  services: RelationSummary[];
}

const { caseStudies, insights, resources, services } = Astro.props;
const hasCaseStudies = caseStudies.length > 0;
const hasEditorialLinks = insights.length > 0 || resources.length > 0 || services.length > 0;
---

{
  (hasCaseStudies || hasEditorialLinks) && (
    <div class="service-related">
      {hasCaseStudies && (
        <section aria-labelledby="related-projects-title">
          <div class="center-heading" data-reveal="line">
            <h2 id="related-projects-title">Progetti collegati</h2>
            <p>Casi pubblicati dal CMS e collegati a questo servizio.</p>
          </div>
          <div class="service-related__projects" data-reveal="up" data-reveal-stagger="1">
            {caseStudies.map(
              (item, index) =>
                item.image && (
                  <ProjectCard
                    title={item.title}
                    category="Progetto"
                    description="Caso studio collegato dal CMS."
                    image={item.image.url}
                    alt={item.image.alt}
                    href={relationPath(item)}
                    large={index === 0}
                  />
                )
            )}
          </div>
        </section>
      )}

      {hasEditorialLinks && (
        <section
          class="service-related__links"
          aria-labelledby="related-links-title"
          data-reveal="up"
        >
          <h2 id="related-links-title">Collegamenti utili</h2>
          <div>
            {services.map((item) => (
              <a href={relationPath(item)}>
                <span>Servizio</span>
                <strong>{item.title}</strong>
              </a>
            ))}
            {insights.map((item) => (
              <a href={relationPath(item)}>
                <span>Insight</span>
                <strong>{item.title}</strong>
              </a>
            ))}
            {resources.map((item) => (
              <a href={relationPath(item)}>
                <span>Risorsa</span>
                <strong>{item.title}</strong>
              </a>
            ))}
          </div>
        </section>
      )}
    </div>
  )
}

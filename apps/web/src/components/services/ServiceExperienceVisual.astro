---
import {
  IconArrowRight,
  IconBolt,
  IconBrandInstagram,
  IconCalendar,
  IconCheck,
  IconCode,
  IconEye,
  IconFileText,
  IconLayoutGrid,
  IconMessageCircle,
  IconPackage,
  IconSearch,
  IconShoppingBag,
  IconTargetArrow,
  IconUsers
} from '@tabler/icons-astro';
import type { ServiceExperienceSlug } from '@/data/service-experiences';

interface Props {
  variant: ServiceExperienceSlug;
}

const { variant } = Astro.props;
---

<div class:list={['service-x-visual', `service-x-visual--${variant}`]} aria-hidden="true">
  {variant === 'ecommerce' && (
    <div class="service-x-shop">
      <div class="service-x-window"><i></i><i></i><i></i><span>atelier.it</span></div>
      <div class="service-x-shop__body">
        <div class="service-x-product"><span>Nuova collezione</span><b>Luce 01</b><small>Materiali, misure, finiture</small></div>
        <div class="service-x-cart"><IconShoppingBag /><strong>Carrello</strong><span>2 prodotti</span><b>€ 680</b><i>Checkout <IconArrowRight /></i></div>
      </div>
      <div class="service-x-flow"><span>Catalogo</span><IconArrowRight /><span>Scheda</span><IconArrowRight /><span>Acquisto</span></div>
    </div>
  )}

  {variant === 'software-e-integrazioni' && (
    <div class="service-x-connect">
      <div class="service-x-connect__node"><IconUsers /><span>CRM</span></div>
      <div class="service-x-connect__node"><IconShoppingBag /><span>Ecommerce</span></div>
      <div class="service-x-connect__core"><IconBolt /><strong>Flusso unico</strong><small>Dati aggiornati</small></div>
      <div class="service-x-connect__node"><IconPackage /><span>Gestionale</span></div>
      <div class="service-x-connect__node"><IconLayoutGrid /><span>Dashboard</span></div>
    </div>
  )}

  {variant === 'seo' && (
    <div class="service-x-search">
      <div class="service-x-search__bar"><IconSearch /><span>servizio giusto a padova</span></div>
      <div class="service-x-search__result"><small>azienda.it / servizio</small><strong>Una risposta chiara alla domanda giusta</strong><p>Struttura, contenuti e prove aiutano persone e motori di ricerca a capire.</p></div>
      <div class="service-x-search__signals"><span><IconCode /> Struttura</span><span><IconFileText /> Contenuti</span><span><IconEye /> Autorevolezza</span></div>
    </div>
  )}

  {variant === 'advertising' && (
    <div class="service-x-campaign">
      <div class="service-x-campaign__creative"><small>Campagna</small><strong>Un messaggio<br />che arriva.</strong><span>Scopri <IconArrowRight /></span></div>
      <div class="service-x-campaign__route"><span><IconEye /> Attenzione</span><i></i><span><IconTargetArrow /> Landing</span><i></i><span><IconUsers /> Contatto</span></div>
      <div class="service-x-campaign__note"><IconCheck /><span>Percorso misurabile</span></div>
    </div>
  )}

  {variant === 'social-media' && (
    <div class="service-x-social">
      <div class="service-x-social__calendar"><span>LUN</span><span>MAR</span><span>MER</span><span>GIO</span><span>VEN</span><i></i><i></i><i></i><i></i><i></i></div>
      <article class="service-x-social__post"><div><IconBrandInstagram /><span>brand.it</span></div><figure></figure><footer><IconMessageCircle /><span>Format editoriale 03</span></footer></article>
      <div class="service-x-social__labels"><span>Piano</span><span>Contenuti</span><span>Relazione</span></div>
    </div>
  )}

  {variant === 'branding-e-comunicazione' && (
    <div class="service-x-brand">
      <div class="service-x-brand__word">forma<span>o</span></div>
      <div class="service-x-brand__palette"><i></i><i></i><i></i><i></i></div>
      <div class="service-x-brand__type"><span>Aa</span><div><strong>Chiaro.</strong><small>Coerente in ogni formato.</small></div></div>
      <div class="service-x-brand__applications"><span>WEB</span><span>PRINT</span><span>SOCIAL</span></div>
    </div>
  )}

  {variant === 'content-production' && (
    <div class="service-x-content">
      <div class="service-x-content__main"><span>01 / HERO</span></div>
      <div class="service-x-content__asset service-x-content__asset--one"><span>9:16</span></div>
      <div class="service-x-content__asset service-x-content__asset--two"><span>1:1</span></div>
      <div class="service-x-content__copy"><IconFileText /><span>Messaggio madre</span><strong>Un racconto,<br />più destinazioni.</strong></div>
    </div>
  )}

  {variant === 'concorsi-a-premi' && (
    <div class="service-x-contest">
      <div class="service-x-contest__ticket"><small>CONCORSO 2026</small><strong>Partecipa.<br />È semplice.</strong><span>Codice <b>NM-2048</b></span></div>
      <ol><li><IconFileText /><span>Meccanica</span></li><li><IconCode /><span>Piattaforma</span></li><li><IconCalendar /><span>Gestione</span></li><li><IconCheck /><span>Chiusura</span></li></ol>
    </div>
  )}
</div>

---
import type { Service } from '@netmarket/schemas';
import { textItems } from '@/lib/services/content';

interface Props {
  service: Service;
}

const { service } = Astro.props;
const steps = textItems(service.process).slice(0, 6);
---

{
  steps.length > 0 && (
    <div class="service-process" data-reveal="up" data-reveal-stagger="1">
      <div class="service-process__heading">
        <h2 id="service-process-title">Metodo operativo</h2>
        <p>Un processo leggibile, pensato per ridurre indecisione e passaggi scollegati.</p>
      </div>
      <ol>
        {steps.map((step, index) => (
          <li>
            <span>{String(index + 1).padStart(2, '0')}</span>
            <div>
              <h3>{step.title}</h3>
              {step.description && <p>{step.description}</p>}
            </div>
          </li>
        ))}
      </ol>
    </div>
  )
}

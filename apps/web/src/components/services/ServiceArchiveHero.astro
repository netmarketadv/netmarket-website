---
import Button from '@/components/ui/Button.astro';
---

<section class="service-archive-hero" aria-labelledby="page-title">
  <div class="service-archive-hero__copy" data-reveal="line">
    <p class="nm-meta">Servizi Netmarket</p>
    <h1 id="page-title">Servizi integrati per web, <span class="nm-heading-accent">marketing</span> e comunicazione.</h1>
  </div>
  <div class="service-archive-hero__aside" data-reveal="up" data-reveal-delay="1">
    <p>
      Non una somma di reparti: un percorso unico per progettare presenza digitale, contenuti,
      campagne e strumenti operativi.
    </p>
    <Button href="#indice-servizi" variant="secondary">Esplora i servizi</Button>
  </div>
</section>

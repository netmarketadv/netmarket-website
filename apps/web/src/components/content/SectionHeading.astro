---
interface Props {
  eyebrow?: string;
  title?: string;
  text?: string | undefined;
  id: string;
  align?: 'left' | 'center';
  reveal?: boolean;
  tone?: 'default' | 'inverse';
}
const { eyebrow, title, text, id, align = 'left', reveal = false, tone = 'default' } = Astro.props;
---

<header
  class:list={[
    'nm-section-heading',
    align === 'center' && 'nm-section-heading--center',
    tone === 'inverse' && 'nm-section-heading--inverse'
  ]}
  data-reveal={reveal ? 'line' : undefined}
>
  {eyebrow && <p class="nm-eyebrow">{eyebrow}</p>}
  <h2 id={id}><slot name="title">{title}</slot></h2>
  {text && <p>{text}</p>}
</header>

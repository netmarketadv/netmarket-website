---
import Button from '@/components/ui/Button.astro';
import IconBubble from '@/components/ui/IconBubble.astro';

type IconName =
  | 'bolt'
  | 'briefcase'
  | 'chart'
  | 'desktop'
  | 'palette'
  | 'search'
  | 'trophy'
  | 'sparkles'
  | 'users';

interface NavItem {
  label: string;
  href?: string;
  badge?: 'new';
  description?: string;
  menuVariant?: 'compact' | 'wide';
  children?: Array<{
    label: string;
    href: string;
    description: string;
    icon: IconName;
  }>;
}

const navItems: NavItem[] = [
  {
    label: 'Servizi',
    href: '/servizi/',
    menuVariant: 'wide',
    description:
      'Web, marketing, contenuti e pubblicità lavorano meglio quando hanno una regia unica.',
    children: [
      {
        label: 'Siti web',
        description: 'Pagine, contenuti e percorsi di conversione.',
        href: '/servizi/siti-web/',
        icon: 'desktop'
      },
      {
        label: 'Ecommerce',
        description: 'Store e cataloghi collegati a marketing e gestione.',
        href: '/servizi/ecommerce/',
        icon: 'briefcase'
      },
      {
        label: 'Software e integrazioni',
        description: 'Gestionale, automazioni, API e strumenti su misura.',
        href: '/servizi/software-e-integrazioni/',
        icon: 'bolt'
      },
      {
        label: 'SEO',
        description: 'Architettura, contenuti e visibilità organica.',
        href: '/servizi/seo/',
        icon: 'search'
      },
      {
        label: 'Advertising',
        description: 'Campagne, dati, tracciamenti e ottimizzazione.',
        href: '/servizi/advertising/',
        icon: 'chart'
      },
      {
        label: 'Social media',
        description: 'Piani editoriali, contenuti e gestione canali.',
        href: '/servizi/social-media/',
        icon: 'users'
      },
      {
        label: 'Branding e comunicazione',
        description: 'Identità, messaggi e materiali coordinati.',
        href: '/servizi/branding-e-comunicazione/',
        icon: 'palette'
      },
      {
        label: 'Content production',
        description: 'Foto, video, copy e asset per campagne e sito.',
        href: '/servizi/content-production/',
        icon: 'sparkles'
      },
      {
        label: 'Concorsi a premi',
        description: 'Meccaniche, sviluppo, gestione e conformità.',
        href: '/servizi/concorsi-a-premi/',
        icon: 'trophy'
      }
    ]
  },
  {
    label: 'Agenzia',
    menuVariant: 'compact',
    description: 'Persone, storia e metodo dietro i progetti Netmarket.',
    children: [
      {
        label: 'Agenzia',
        description: 'La nostra storia, il metodo e le persone.',
        href: '/agenzia/',
        icon: 'users'
      },
      {
        label: 'Lavora con noi',
        description: 'Competenze, modo di lavorare e candidatura spontanea.',
        href: '/lavora-con-noi/',
        icon: 'briefcase'
      }
    ]
  },
  { href: '/progetti/', label: 'Progetti' },
  { href: '/insight/', label: 'Insight' },
  { href: '/nod/', label: 'NØD', badge: 'new' },
  { href: '/contatti/', label: 'Contatti' }
];

const currentPath = Astro.url.pathname;
const normalizePath = (href: string) => href.split('#')[0] || '/';
const isCurrent = (href?: string) => Boolean(href && normalizePath(href) === currentPath);
const isSectionCurrent = (item: NavItem) =>
  item.label === 'Agenzia'
    ? currentPath === '/agenzia/' || currentPath === '/lavora-con-noi/'
    : item.label === 'Servizi'
      ? currentPath.startsWith('/servizi/')
      : isCurrent(item.href);
---

<header class="site-header">
  <div class="site-header__inner">
    <a class="site-header__brand" href="/" aria-label="Netmarket home">
      <img src="/netmarket-logo.svg" alt="" width="140" height="40" />
    </a>
    <nav class="site-header__nav" aria-label="Navigazione principale">
      {
        navItems.map((item) =>
          item.children ? (
            <details class="mega-menu" data-active={isSectionCurrent(item) ? 'true' : undefined}>
              <summary>{item.label}</summary>
              <div class="mega-menu__scrim" />
              <div
                class:list={[
                  'mega-menu__panel',
                  item.menuVariant === 'compact' && 'mega-menu__panel--compact',
                  item.menuVariant === 'wide' && 'mega-menu__panel--wide'
                ]}
              >
                <div class="mega-menu__intro">
                  <h2>{item.label === 'Servizi' ? 'Servizi integrati' : 'Netmarket dal 1986'}</h2>
                  <p>{item.description}</p>
                  {item.href && (
                    <a class="mega-menu__overview" href={item.href}>
                      Tutti i servizi
                    </a>
                  )}
                </div>
                <div class="mega-menu__grid">
                  {item.children.map((child) => (
                    <a href={child.href} aria-current={isCurrent(child.href) ? 'page' : undefined}>
                      <IconBubble name={child.icon} size="sm" />
                      <span>
                        <strong>{child.label}</strong>
                        <span>{child.description}</span>
                      </span>
                    </a>
                  ))}
                </div>
              </div>
            </details>
          ) : (
            <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
              <span>{item.label}</span>
              {item.badge && <small class="site-header__badge">{item.badge}</small>}
            </a>
          )
        )
      }
    </nav>
    <div class="site-header__actions">
      <Button href="/contatti/" variant="primary" magnetic>Parliamone</Button>
    </div>
    <details class="site-header__mobile">
      <summary aria-label="Apri menu">
        <span></span>
        <span></span>
      </summary>
      <nav class="site-header__mobile-panel" aria-label="Navigazione mobile">
        <div class="site-header__mobile-links">
          {
            navItems.map((item) =>
              item.children ? (
                <details
                  class:list={[
                    'mobile-submenu',
                    item.menuVariant === 'compact' && 'mobile-submenu--compact',
                    item.menuVariant === 'wide' && 'mobile-submenu--wide'
                  ]}
                  data-active={isSectionCurrent(item) ? 'true' : undefined}
                >
                  <summary>{item.label}</summary>
                  <div class="mobile-submenu__panel">
                    {item.children.map((child) => (
                      <a
                        href={child.href}
                        aria-current={isCurrent(child.href) ? 'page' : undefined}
                      >
                        <IconBubble name={child.icon} size="sm" />
                        <span>
                          <strong>{child.label}</strong>
                          <small>{child.description}</small>
                        </span>
                      </a>
                    ))}
                  </div>
                </details>
              ) : (
                <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                  <span>{item.label}</span>
                  {item.badge && <small class="site-header__badge">{item.badge}</small>}
                </a>
              )
            )
          }
        </div>
      </nav>
    </details>
  </div>
</header>

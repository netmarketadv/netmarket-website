---
interface Props {
  as?: keyof HTMLElementTagNameMap;
  variant?: 'fade' | 'up' | 'down' | 'scale' | 'media' | 'line';
  delay?: number;
  class?: string;
}

const { as = 'div', variant = 'up', delay = 0, class: className = '' } = Astro.props;
const Tag = as;
void ({} as Props);
---

<Tag data-reveal={variant} data-reveal-delay={delay} class={className}>
  <slot />
</Tag>

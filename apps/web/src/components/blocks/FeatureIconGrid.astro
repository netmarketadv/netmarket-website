---
import IconBubble from '@/components/ui/IconBubble.astro';

interface Props {
  title: string;
  titleId?: string;
  items: [string, string, 'arrows' | 'bolt' | 'briefcase' | 'chart' | 'desktop' | 'palette' | 'search' | 'shield' | 'sparkles' | 'users'][];
}

const { title, titleId, items } = Astro.props;
---

<div class="feature-icon-section" data-reveal="up">
  <h2 id={titleId}>{title}</h2>
  <div class="feature-icon-grid" data-reveal="up" data-reveal-stagger="1">
    {items.map(([itemTitle, text, icon]) => (
      <article>
        <IconBubble name={icon} />
        <div>
          <h3>{itemTitle}</h3>
          <p>{text}</p>
        </div>
      </article>
    ))}
  </div>
</div>

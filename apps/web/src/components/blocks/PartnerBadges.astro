---
import { cmsMedia } from '@/data/home';
---

<section class="site-footer__trust" aria-label="Certificazioni e partnership">
  <img
    src={cmsMedia.badges.iubendaGold}
    alt="iubenda Gold Partner"
    width="150"
    height="90"
    loading="lazy"
    decoding="async"
  />
  <a
    href="https://www.google.com/partners/agency?id=9657120194"
    target="_blank"
    rel="noopener noreferrer"
    ><img
      src={cmsMedia.badges.googlePartner}
      alt="Google Partner"
      width="304"
      height="291"
      loading="lazy"
      decoding="async"
    /></a
  >
  <img
    src={cmsMedia.badges.brevo}
    alt="Brevo Partner Pioneer 2025"
    width="150"
    height="110"
    loading="lazy"
    decoding="async"
  />
  <img
    class="site-footer__trust-woocommerce"
    src={cmsMedia.badges.woocommerce}
    alt="WooCommerce ecommerce partner"
    width="200"
    height="75"
    loading="lazy"
    decoding="async"
  />
</section>

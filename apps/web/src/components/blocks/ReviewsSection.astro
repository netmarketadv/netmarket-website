---
import GoogleTrustBadge from '@/components/blocks/GoogleTrustBadge.astro';
import ReviewsCarousel from '@/components/blocks/ReviewsCarousel.astro';
import { googleReviews, type GoogleReview } from '@/data/reviews';

interface Props {
  title: string;
  reviews?: GoogleReview[];
  titleId?: string;
  text: string;
  rating: string;
  reviewCount: string;
  googleHref: string;
}

const {
  title,
  titleId,
  text,
  rating,
  reviewCount,
  googleHref,
  reviews = googleReviews
} = Astro.props;
---

<div class="reviews-section">
  <div class="reviews-section__header">
    <div>
      <div data-reveal="up">
        <GoogleTrustBadge
          rating={rating}
          reviewCount={reviewCount}
          href={googleHref}
          showReviewCount={false}
        />
      </div>
      <h2 id={titleId} data-reveal="line"><slot name="title">{title}</slot></h2>
      <p data-reveal="up">{text}</p>
    </div>
  </div>

  <ReviewsCarousel reviews={reviews} />
</div>

<script>
  import { initReviewsCarousel } from '@/lib/google-business/reviews';

  initReviewsCarousel();
</script>

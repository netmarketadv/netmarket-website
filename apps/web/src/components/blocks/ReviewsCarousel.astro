---
import IconButton from '@/components/ui/IconButton.astro';
import { IconArrowLeft, IconArrowRight, IconX } from '@tabler/icons-astro';
import ReviewCard from '@/components/blocks/ReviewCard.astro';
import type { GoogleReview } from '@/data/reviews';

interface Props {
  reviews: GoogleReview[];
}

const { reviews } = Astro.props;
const hasReviews = reviews.length > 0;
---

{
  hasReviews && (
    <div class="reviews-carousel" data-reviews-carousel>
      <div class="reviews-carousel__viewport">
        <div class="reviews-carousel__track" data-reviews-track>
          {reviews.map((review, index) => (
            <ReviewCard review={review} index={index} />
          ))}
        </div>
      </div>

      <div class="reviews-carousel__controls" role="group" aria-label="Navigazione recensioni">
        <IconButton
          class="reviews-carousel__arrow"
          type="button"
          data-reviews-prev
          label="Recensione precedente"
        >
          <IconArrowLeft stroke={1.8} aria-hidden="true" />
        </IconButton>
        <IconButton
          class="reviews-carousel__arrow"
          type="button"
          data-reviews-next
          label="Recensione successiva"
        >
          <IconArrowRight stroke={1.8} aria-hidden="true" />
        </IconButton>
      </div>

      <dialog class="review-modal" data-review-modal aria-labelledby="review-modal-title">
        <div class="review-modal__panel">
          <IconButton
            class="review-modal__close"
            type="button"
            data-review-modal-close
            label="Chiudi recensione"
          >
            <IconX stroke={1.8} aria-hidden="true" />
          </IconButton>
          <div class="review-modal__identity">
            <img
              data-review-modal-avatar
              alt=""
              loading="lazy"
              decoding="async"
              referrerpolicy="no-referrer"
            />
            <div>
              <h3 id="review-modal-title" data-review-modal-author>
                Recensione
              </h3>
              <p data-review-modal-source>Google</p>
            </div>
          </div>
          <div
            class="review-modal__stars"
            data-review-modal-stars
            role="img"
            aria-label="Valutazione: 5 su 5"
          />
          <blockquote data-review-modal-text />
        </div>
      </dialog>
    </div>
  )
}

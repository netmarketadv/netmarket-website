---
import type { HTMLAttributes } from 'astro/types';
interface Props extends HTMLAttributes<'button'> {
  href?: string;
  variant?: 'primary' | 'secondary' | 'inverse';
  class?: string;
  disabled?: boolean;
  magnetic?: boolean;
  size?: 'default' | 'large';
  busy?: boolean;
}

const {
  href,
  variant = 'primary',
  size = 'default',
  class: className = '',
  disabled = false,
  magnetic = false,
  busy = false,
  type = 'button',
  ...attributes
} = Astro.props;
const unavailable = disabled || busy;
const classes = ['nm-button', `nm-button--${variant}`, `nm-button--${size}`, className];
---

{
  href ? (
    <a
      {...attributes}
      class:list={classes}
      href={unavailable ? undefined : href}
      role={unavailable ? 'link' : undefined}
      tabindex={unavailable ? -1 : attributes.tabindex}
      aria-disabled={unavailable ? 'true' : undefined}
      aria-busy={busy ? 'true' : undefined}
      data-motion-magnetic={magnetic && !unavailable ? 'true' : undefined}
    >
      <slot />
    </a>
  ) : (
    <button
      {...attributes}
      type={type}
      class:list={classes}
      disabled={unavailable}
      aria-busy={busy ? 'true' : undefined}
      data-motion-magnetic={magnetic && !unavailable ? 'true' : undefined}
    >
      <slot />
    </button>
  )
}

---
import type { HTMLAttributes } from 'astro/types';
interface Props extends HTMLAttributes<'button'> {
  label: string;
}
const { label, class: className, type = 'button', ...attributes } = Astro.props;
---

<button {...attributes} class:list={['nm-icon-button', className]} type={type} aria-label={label}
  ><slot /></button
>

---
import { existsSync } from 'node:fs';
import { join } from 'node:path';

interface Props {
  src: string;
  alt: string;
  title?: string;
  variant?: 'dashboard' | 'leads' | 'pipeline' | 'automation' | 'report';
  loading?: 'eager' | 'lazy';
}

const { src, alt, title = 'NØD dashboard', variant = 'dashboard', loading = 'lazy' } = Astro.props;
const publicPath = join(process.cwd(), 'public', src.replace(/^\//, ''));
const hasAsset = existsSync(publicPath);
---

<figure class:list={['nod-product-frame', `nod-product-frame--${variant}`]}>
  <div class="nod-product-frame__bar" aria-hidden="true">
    <span></span>
    <span></span>
    <span></span>
    <strong>{title}</strong>
  </div>
  {
    hasAsset ? (
      <img src={src} alt={alt} width="1440" height="960" loading={loading} decoding="async" />
    ) : (
      <div class="nod-product-mock" role="img" aria-label={`${alt}. Anteprima dimostrativa in attesa dello screenshot reale.`}>
        <div class="nod-product-mock__sidebar">
          <span>NØD</span>
          <i></i>
          <i></i>
          <i></i>
          <i></i>
        </div>
        <div class="nod-product-mock__main">
          <div class="nod-product-mock__header">
            <span>{title}</span>
            <em>Demo</em>
          </div>
          <div class="nod-product-mock__metrics">
            <strong>16<span>lead da seguire</span></strong>
            <strong>€573.600<span>pipeline demo</span></strong>
            <strong>72<span>task aperti</span></strong>
          </div>
          <div class="nod-product-mock__board">
            <section>
              <h3>Nuovi lead</h3>
              <p>Sito web</p>
              <p>Google Ads</p>
              <p>Evento</p>
            </section>
            <section>
              <h3>In valutazione</h3>
              <p>Preventivo</p>
              <p>Follow-up</p>
            </section>
            <section>
              <h3>Opportunità</h3>
              <p>Meeting</p>
              <p>Proposta inviata</p>
            </section>
          </div>
        </div>
      </div>
    )
  }
</figure>

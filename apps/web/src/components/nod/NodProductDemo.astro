  }
  .nod-task-strip {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.65rem 0.8rem;
    border: 1px solid var(--ui-line);
    border-radius: 0.7rem;
    background: #fff;
  }
  .nod-task-strip p {
    margin: 0;

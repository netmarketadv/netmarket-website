  .nod-task-strip em {
    margin-left: auto;
    color: var(--ui-muted);
    font-style: normal;
  }
  .nod-task-strip button {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    border: 0;
    border-radius: 0.5rem;
    padding: 0.45rem 0.65rem;
    background: var(--ui-blue);
    color: #fff;
  }
  .nod-screen--assistant {

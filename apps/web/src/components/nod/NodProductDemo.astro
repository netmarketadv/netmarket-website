  }
  .nod-chat__thinking {
    display: flex;
    gap: 0.2rem;
    width: fit-content;
    margin-left: 3rem;
    padding: 0.6rem 0.75rem;
    border: 1px solid var(--ui-line);
    border-radius: 0.8rem;
    background: #fff;
    animation: nod-thinking 8s both infinite;
  }
  .nod-chat__thinking i {
    width: 0.3rem;

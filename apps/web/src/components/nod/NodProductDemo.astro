    border-radius: 50%;
    background: #8d9299;
    animation: nod-dot 0.8s ease-in-out infinite alternate;
  }
  .nod-chat__thinking i:nth-child(2) {
    animation-delay: 0.15s;
  }
  .nod-chat__thinking i:nth-child(3) {
    animation-delay: 0.3s;
  }
  .nod-chat__answer {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0.6rem;
    opacity: 0;
    animation: nod-answer 8s var(--nm-motion-ease-enter) infinite;
  }
  .nod-chat__answer > div {
    border: 1px solid var(--ui-line);
    border-radius: 0.8rem;
    padding: 0.75rem;
    background: #fff;
  }
  .nod-chat__answer p {
    margin: 0;
  }
  .nod-chat__answer ol {
    display: grid;
    gap: 0.45rem;
    margin: 0.65rem 0;
    padding: 0;
    list-style: none;
  }
  .nod-chat__answer li {
    display: grid;
    padding-bottom: 0.4rem;
    border-bottom: 1px solid var(--ui-line);
  }
  .nod-chat__answer small {
    color: var(--ui-muted);
  }
  .nod-chat__action {
    display: flex;
    gap: 0.35rem;
    align-items: center;
    color: #159668;
    font-weight: 600;
  }
  .nod-chat-input {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.8rem;
    padding: 0.45rem 0.5rem 0.45rem 0.75rem;
    border: 1px solid var(--ui-line);
    border-radius: 0.8rem;
    background: #fff;
    color: #a1a4aa;
  }
  .nod-chat-input button {
    display: grid;
    place-items: center;
    width: 2rem;
    aspect-ratio: 1;
    margin-left: auto;
    border: 0;
    border-radius: 0.55rem;
    background: var(--ui-blue);
    color: #fff;
  }
  .nod-automation-flow {
    display: grid;
    grid-template-columns: auto 1fr auto 1fr auto 1fr auto;
    align-items: center;
    padding: 0.75rem;
    border: 1px solid var(--ui-line);
    border-radius: 0.8rem;
    background: #fff;
  }
  .nod-automation-flow span {
    display: grid;
    justify-items: center;
    gap: 0.3rem;
    min-width: 5.4rem;
  }
  .nod-automation-flow span svg {
    color: var(--ui-blue);
  }
  .nod-automation-flow > i {
    height: 2px;
    background: linear-gradient(90deg, #b9c8f5 50%, transparent 50%) 0 0/8px 2px;
    animation: nod-flow-line 1.2s linear infinite;
  }
  .nod-automation-flow .is-complete {
    color: #16865e;
  }
  .nod-automation-list {
    display: grid;
    gap: 0.5rem;
  }
  .nod-automation-list article {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.6rem;
    padding: 0.65rem 0.75rem;
    border: 1px solid var(--ui-line);
    border-radius: 0.7rem;
    background: #fff;
  }
  .nod-automation-list article > span {
    display: grid;
    place-items: center;
    width: 2.1rem;
    aspect-ratio: 1;
    border-radius: 0.6rem;
    background: #e7edff;
    color: var(--ui-blue);
  }
  .nod-automation-list article div {
    display: grid;
  }
  .nod-automation-list p {
    color: var(--ui-muted);
  }
  .nod-automation-list small {
    width: fit-content;
    margin-top: 0.2rem;
    border-radius: 999px;
    padding: 0.2rem 0.4rem;
    background: #f0f1f2;
    color: var(--ui-muted);
  }
  .nod-toggle {
    position: relative;
    width: 2rem;
    height: 1.05rem;
    border-radius: 999px;
    background: var(--ui-blue);
  }
  .nod-toggle::after {
    content: '';
    position: absolute;
    top: 0.14rem;
    left: 1.08rem;
    width: 0.77rem;
    aspect-ratio: 1;
    border-radius: 50%;
    background: #fff;
  }
  .nod-automation-active {
    animation: nod-automation-highlight 7s ease-in-out infinite;
  }
  .nod-automation-toast {
    animation-name: nod-automation-toast;
  }
  .nod-report-kpis {
    grid-template-columns: repeat(3, 1fr);
  }
  .nod-report-kpis article {
    display: grid;
    gap: 0.12rem;
    padding: 0.75rem;
  }
  .nod-report-kpis strong {
    font-size: 1.7em;
  }
  .nod-report-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.65fr) minmax(10rem, 0.7fr);
    gap: 0.65rem;
    min-height: 0;
  }
  .nod-report-chart {
    display: grid;
    grid-template-rows: auto minmax(0, 1fr);
    padding: 0.8rem;
  }
  .nod-report-chart header span {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    color: var(--ui-muted);
  }
  .nod-report-chart header i {
    width: 0.45rem;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--ui-blue);
  }
  .nod-report-chart header i:nth-of-type(2) {
    background: #22a875;
  }
  .nod-report-line-green {
    stroke: #22a875;
    animation-delay: 0.25s;
  }
  .nod-report-sources {
    display: grid;
    align-content: start;
    gap: 0.75rem;
    padding: 0.85rem;
  }
  .nod-report-sources div {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.3rem;
    align-items: center;
  }
  .nod-report-sources i {
    grid-column: 1/-1;
    display: block;
    width: var(--bar);
    height: 0.35rem;
    border-radius: 999px;
    background: var(--ui-blue);
    transform-origin: left;
    animation: nod-bars 6s var(--nm-motion-ease-enter) infinite;
  }
  .nod-report-sources em {
    color: var(--ui-muted);
    font-style: normal;
  }
  @keyframes nod-draw {
    0%,
    10% {
      stroke-dashoffset: 900;
    }
    34%,
    90% {
      stroke-dashoffset: 0;
    }
    100% {
      stroke-dashoffset: 900;
    }
  }
  @keyframes nod-row-in {
    0%,
    8% {
      opacity: 0;
      transform: translateY(-0.6rem);
      background: #eaf1ff;
    }
    20%,
    82% {
      opacity: 1;
      transform: none;
      background: #fff;
    }
    100% {
      opacity: 0;
    }
  }
  @keyframes nod-toast {
    0%,
    12%,
    88%,
    100% {
      opacity: 0;
      transform: translateY(0.7rem);
    }
    24%,
    76% {
      opacity: 1;
      transform: none;
    }
  }
  @keyframes nod-move-lead {
    0%,
    28% {
      opacity: 1;
      transform: none;
    }
    50%,
    74% {
      opacity: 0;
      transform: translateX(calc(100% + 0.6rem));
    }
    86%,
    100% {
      opacity: 1;
      transform: none;
    }
  }
  @keyframes nod-won {
    0%,
    38%,
    88%,
    100% {
      opacity: 0;
      transform: translateY(0.4rem);
    }
    52%,
    78% {
      opacity: 1;
      transform: none;
    }
  }
  @keyframes nod-event-in {
    0%,
    15%,
    90%,
    100% {
      opacity: 0;
      transform: scale(0.94);
    }
    28%,
    80% {
      opacity: 1;
      transform: none;
    }
  }
  @keyframes nod-question {
    0%,
    8%,
    92%,
    100% {
      opacity: 0;
      transform: translateY(0.5rem);
    }
    18%,
    84% {
      opacity: 1;
      transform: none;
    }
  }
  @keyframes nod-thinking {
    0%,
    22%,
    52%,
    100% {
      opacity: 0;
    }
    30%,
    45% {
      opacity: 1;
    }
  }
  @keyframes nod-dot {
    to {
      transform: translateY(-0.15rem);
    }
  }
  @keyframes nod-answer {
    0%,
    42% {
      opacity: 0;
      transform: translateY(0.5rem);
    }
    56%,
    90% {
      opacity: 1;
      transform: none;
    }
    100% {
      opacity: 0;
    }
  }
  @keyframes nod-flow-line {
    to {
      background-position: 8px 0;
    }
  }
  @keyframes nod-automation-highlight {
    0%,
    18%,
    78%,
    100% {
      border-color: var(--ui-line);
      box-shadow: none;
    }
    34%,
    64% {
      border-color: #97b2fb;
      box-shadow: 0 0 0 3px rgb(23 100 246/0.08);
    }
  }
  @keyframes nod-automation-toast {
    0%,
    35%,
    92%,
    100% {
      opacity: 0;
      transform: translateY(0.7rem);
    }
    50%,
    82% {
      opacity: 1;
      transform: none;
    }
  }
  @keyframes nod-bars {
    0%,
    12% {
      transform: scaleX(0);
    }
    34%,
    90% {
      transform: scaleX(1);
    }
    100% {
      transform: scaleX(0);
    }
  }
  @media (width <= 780px) {
    .nod-ui {
      grid-template: 3rem minmax(0, 1fr) / 1fr;
      aspect-ratio: 4/3.25;
      font-size: clamp(0.52rem, 1.6vw, 0.68rem);
      border-radius: var(--nm-radius-md);
    }
    .nod-ui__sidebar {
      display: none;
    }
    .nod-ui__topbar {
      grid-area: 1/1;
      padding: 0.5rem 0.65rem;
    }
    .nod-ui__mobile-brand {
      display: flex;
      align-items: center;
      gap: 0.35rem;
      font-weight: 650;
    }
    .nod-ui__mobile-brand .nod-ui__orbit {
      width: 1.3rem;
    }
    .nod-ui__search {
      width: auto;
      flex: 1;
      min-width: 0;
    }
    .nod-ui__search span {
      overflow: hidden;
      white-space: nowrap;
      text-overflow: ellipsis;
    }
    .nod-ui__bell {
      display: none;
    }
    .nod-ui__avatar {
      width: 1.6rem;
    }
    .nod-ui__content {
      grid-area: 2/1;
    }
    .nod-screen {
      gap: 0.65rem;
      padding: 0.7rem;
    }
    .nod-screen__heading h3 {
      font-size: 1.5em;
    }
    .nod-screen__heading p,
    .nod-screen__heading small:first-child {
      display: none;
    }
    .nod-screen__heading button {
      min-height: 1.85rem;
      padding: 0 0.5rem;
    }
    .nod-kpis {
      grid-template-columns: repeat(2, 1fr);
    }
    .nod-kpis article:nth-child(n + 3) {
      display: none;
    }
    .nod-kpis article {
      padding: 0.55rem;
    }
    .nod-kpis strong {
      font-size: 1.55em;
    }
    .nod-overview-grid {
      grid-template-columns: 1fr;
    }
    .nod-priority-card {
      display: none;
    }
    .nod-leads-row {
      grid-template-columns: 1.35fr 0.7fr 0.55fr;
      min-height: 2.65rem;
      padding: 0.4rem 0.5rem;
    }
    .nod-leads-row > span:nth-child(2),
    .nod-leads-row > span:nth-child(3) {
      display: none;
    }
    .nod-leads-row:nth-child(n + 5) {
      display: none;
    }
    .nod-leads-toolbar {
      padding: 0.5rem;
    }
    .nod-leads-toolbar b {
      display: none;
    }
    .nod-toast,
    .nod-automation-toast {
      right: 0.65rem;
      bottom: 0.65rem;
    }
    .nod-pipeline {
      grid-template-columns: repeat(3, minmax(7rem, 1fr));
      overflow: hidden;
    }
    .nod-pipeline section:nth-child(2) {
      display: none;
    }
    .nod-pipeline article:nth-of-type(2) {
      display: none;
    }
    .nod-pipeline-note {
      display: none;
    }
    .nod-calendar {
      grid-template-columns: 1.6rem repeat(3, minmax(0, 1fr));
    }
    .nod-calendar section:nth-of-type(n + 4) {
      display: none;
    }
    .nod-task-strip p {
      overflow: hidden;
      white-space: nowrap;
      text-overflow: ellipsis;
    }
    .nod-task-strip span {
      display: none;
    }
    .nod-screen--assistant {
      padding-inline: 0.8rem;
    }
    .nod-chat {

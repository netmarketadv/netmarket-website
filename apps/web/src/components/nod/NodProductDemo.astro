  .nod-assistant-head > span,
  .nod-chat__answer > span {
    display: grid;
    place-items: center;
    width: 2.4rem;
    aspect-ratio: 1;
    border-radius: 0.7rem;
    background: #e6edff;
    color: var(--ui-blue);
  }
  .nod-assistant-head div {
    display: grid;
  }
  .nod-assistant-head h3 {
    font-size: 1.55em;
  }
  .nod-assistant-head p {
    color: var(--ui-muted);
  }
  .nod-assistant-head em {
    margin-left: auto;

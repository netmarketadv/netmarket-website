---
import Button from '@/components/ui/Button.astro';
import { nodPricing } from '@/data/nod';

const betaNotes = [
  'prodotto già utilizzabile',
  'sviluppo ancora attivo',
  'funzioni che possono evolvere',
  'feedback diretto degli utenti',
  'supporto Netmarket',
  'licenza gratuita durante il programma beta'
];
---

<section class="nod-section nod-beta-section" id="beta" aria-labelledby="nod-beta-title">
  <div class="nod-container nod-beta">
    <div class="nod-beta__copy" data-reveal="line">
      <p class="nm-eyebrow">NØD Beta</p>
      <h2 id="nod-beta-title">Stiamo aprendo NØD a un gruppo di clienti Netmarket.</h2>
      <p>
        Durante la beta la licenza della piattaforma viene fornita gratuitamente ai clienti ammessi
        al programma.
      </p>
      <Button href="#richiedi-beta" variant="inverse">Richiedi accesso alla beta</Button>
    </div>
    <div class="nod-beta__price" data-reveal="scale">
      <span>{nodPricing.betaLabel}</span>
      <strong>€{nodPricing.betaMonthlyPrice}</strong>
      <p>al {nodPricing.billingUnit}, per tutta la durata del programma beta.</p>
      <small>Valore della licenza a regime: €{nodPricing.regularMonthlyPrice}/{nodPricing.billingUnit}.</small>
      <small>Configurazione, integrazioni o personalizzazioni vengono valutate separatamente.</small>
    </div>
    <div class="nod-beta__meaning" data-reveal="up">
      <h3>Cosa significa beta.</h3>
      <ul>
        {betaNotes.map((note) => <li>{note}</li>)}
      </ul>
    </div>
  </div>
</section>

---
import NodProductFrame from './NodProductFrame.astro';
import { productTourItems } from '@/data/nod';
---

<section class="nod-section nod-product-tour" id="funzioni" aria-labelledby="nod-tour-title" data-nod-tour>
  <div class="nod-container">
    <div class="nod-section-heading" data-reveal="line">
      <h2 id="nod-tour-title">Un solo ambiente. Dal primo contatto al cliente.</h2>
      <p>Le funzioni sono organizzate attorno al processo, non attorno a strumenti separati.</p>
    </div>
    <div class="nod-tour" data-reveal="up">
      <div class="nod-tour__tabs" role="tablist" aria-label="Tour prodotto NØD">
        {
          productTourItems.map((item, index) => (
            <button
              type="button"
              role="tab"
              id={`nod-tab-${item.id}`}
              aria-controls={`nod-panel-${item.id}`}
              aria-selected={index === 0 ? 'true' : 'false'}
              data-nod-tab={item.id}
            >
              {item.label}
            </button>
          ))
        }
      </div>
      <div class="nod-tour__panels">
        {
          productTourItems.map((item, index) => (
            <article
              class="nod-tour__panel"
              id={`nod-panel-${item.id}`}
              role="tabpanel"
              aria-labelledby={`nod-tab-${item.id}`}
              data-nod-panel={item.id}
              hidden={index !== 0}
            >
              <div class="nod-tour__content">
                <h3>{item.title}</h3>
                <p>{item.description}</p>
                <ul>
                  {item.benefits.map((benefit) => <li>{benefit}</li>)}
                </ul>
              </div>
              <NodProductFrame
                src={item.screenshot}
                alt={`Schermata NØD: ${item.label}`}
                title={item.label}
                variant={item.id === 'automazioni' ? 'automation' : item.id === 'report' ? 'report' : item.id === 'pipeline' ? 'pipeline' : 'dashboard'}
              />
            </article>
          ))
        }
      </div>
    </div>
  </div>
</section>

<script>
  const tours = document.querySelectorAll<HTMLElement>('[data-nod-tour]');

  tours.forEach((tour) => {
    const tabs = Array.from(tour.querySelectorAll<HTMLButtonElement>('[data-nod-tab]'));
    const panels = Array.from(tour.querySelectorAll<HTMLElement>('[data-nod-panel]'));

    function activate(nextIndex: number) {
      tabs.forEach((tab, index) => {
        const active = index === nextIndex;
        tab.setAttribute('aria-selected', String(active));
        tab.tabIndex = active ? 0 : -1;
      });
      panels.forEach((panel, index) => {
        panel.hidden = index !== nextIndex;
      });
    }

    tabs.forEach((tab, index) => {
      tab.tabIndex = index === 0 ? 0 : -1;
      tab.addEventListener('click', () => activate(index));
      tab.addEventListener('keydown', (event) => {
        const current = tabs.indexOf(tab);
        if (event.key !== 'ArrowRight' && event.key !== 'ArrowLeft') return;
        event.preventDefault();
        const direction = event.key === 'ArrowRight' ? 1 : -1;
        const next = (current + direction + tabs.length) % tabs.length;
        activate(next);
        tabs[next]?.focus();
      });
    });
  });
</script>

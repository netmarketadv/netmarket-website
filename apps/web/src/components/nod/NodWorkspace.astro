---
const items = ['utenti', 'pipeline', 'configurazioni', 'branding', 'dati', 'automazioni'];
---

<section class="nod-section nod-section--soft" aria-labelledby="nod-workspace-title">
  <div class="nod-container nod-workspace" data-reveal="scale">
    <div>
      <h2 id="nod-workspace-title">Il tuo ambiente. I tuoi dati.</h2>
      <p>
        Ogni cliente lavora in un workspace dedicato e separato dagli altri, configurato intorno al
        proprio processo commerciale.
      </p>
    </div>
    <div class="nod-workspace__items">
      {items.map((item) => <span>{item}</span>)}
    </div>
  </div>
</section>

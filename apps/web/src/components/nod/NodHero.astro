---
import Button from '@/components/ui/Button.astro';
import NodProductFrame from './NodProductFrame.astro';
import { nodScreenshots } from '@/data/nod';
---

<section class="nod-hero" aria-labelledby="nod-title">
  <div class="nod-container nod-hero__grid">
    <div class="nod-hero__copy" data-reveal="line">
      <p class="nm-eyebrow">NØD by Netmarket · Beta privata</p>
      <h1 id="nod-title">Ogni lead. Un processo. Nessuna opportunità lasciata al caso.</h1>
      <p>
        NØD collega contatti, pipeline, follow-up, automazioni e dati in un unico ambiente.
      </p>
      <div class="nod-hero__actions">
        <Button href="#richiedi-beta" variant="primary" magnetic>Richiedi accesso alla beta</Button>
        <Button href="#come-funziona" variant="secondary">Scopri come funziona</Button>
      </div>
      <small>Beta gratuita per i clienti Netmarket selezionati.</small>
    </div>
    <div class="nod-hero__visual" data-reveal="scale">
      <NodProductFrame
        src={nodScreenshots.dashboard}
        alt="Dashboard NØD con lead, pipeline commerciale e task"
        title="Dashboard commerciale"
        loading="eager"
      />
      <div class="nod-hero__signals" aria-label="Dati dimostrativi prodotto">
        <span><strong>16</strong> lead da seguire</span>
        <span><strong>€573.600</strong> pipeline demo</span>
        <span><strong>72</strong> task aperti</span>
      </div>
    </div>
  </div>
</section>

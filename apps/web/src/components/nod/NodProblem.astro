---
const sources = ['Sito', 'Google Ads', 'Meta Ads', 'Social', 'Eventi', 'Email'];
const fragments = ['Email', 'Excel', 'WhatsApp', 'Appunti', 'CRM', 'Memoria'];
---

<section class="nod-section nod-section--soft" id="come-funziona" aria-labelledby="nod-problem-title">
  <div class="nod-container nod-problem">
    <div class="nod-problem__copy" data-reveal="line">
      <h2 id="nod-problem-title">Generare un lead è solo l’inizio.</h2>
      <p>
        Un’azienda può investire bene in marketing e perdere comunque opportunità dopo la conversione.
        Il punto più fragile spesso inizia proprio dopo il contatto.
      </p>
    </div>
    <div class="nod-problem__map" data-reveal="up">
      <div class="nod-source-cloud" aria-label="Canali di acquisizione">
        {sources.map((source) => <span>{source}</span>)}
      </div>
      <div class="nod-flow-question" aria-hidden="true">
        <span>Lead</span>
        <strong>?</strong>
      </div>
      <div class="nod-fragment-list" aria-label="Dove si disperdono spesso i lead">
        {fragments.map((fragment) => <span>{fragment}</span>)}
      </div>
    </div>
  </div>
</section>

---
import NodProductFrame from './NodProductFrame.astro';
import { nodScreenshots } from '@/data/nod';

const points = [
  'Da dove arriva.',
  'Cosa ha chiesto.',
  'Quanto vale.',
  'Cosa è già successo.',
  'Cosa deve succedere dopo.'
];
---

<section class="nod-section nod-section--soft" aria-labelledby="nod-lead-title">
  <div class="nod-container nod-lead-detail">
    <div class="nod-lead-detail__visual" data-reveal="media">
      <NodProductFrame
        src={nodScreenshots.leadDetail}
        alt="Dettaglio lead NØD con origine, attività, priorità e prossima azione"
        title="Dettaglio lead"
        variant="leads"
      />
    </div>
    <div class="nod-lead-detail__copy" data-reveal="line">
      <h2 id="nod-lead-title">Ogni lead racconta una storia completa.</h2>
      <p>
        Origine, richiesta, priorità, attività, prossima azione, follow-up ed esito restano nello
        stesso percorso.
      </p>
      <ul>
        {points.map((point) => <li>{point}</li>)}
      </ul>
    </div>
  </div>
</section>

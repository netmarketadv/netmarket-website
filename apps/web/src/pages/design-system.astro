---
import { designDecisions } from '@/data/design-system';
import IconButton from '@/components/ui/IconButton.astro';
import { IconArrowLeft, IconArrowRight } from '@tabler/icons-astro';
import '@/styles/forms.css';
import ContactCTA from '@/components/blocks/ContactCTA.astro';
import SectionHeading from '@/components/content/SectionHeading.astro';
import ClientMarquee from '@/components/blocks/ClientMarquee.astro';
import CTAInlineForm from '@/components/blocks/CTAInlineForm.astro';
import FAQBlock from '@/components/blocks/FAQBlock.astro';
import ReviewsSection from '@/components/blocks/ReviewsSection.astro';
import TeamSection from '@/components/blocks/TeamSection.astro';
import ProjectCard from '@/components/content/ProjectCard.astro';
import Container from '@/components/layout/Container.astro';
import Section from '@/components/layout/Section.astro';
import Stack from '@/components/layout/Stack.astro';
import Badge from '@/components/ui/Badge.astro';
import Button from '@/components/ui/Button.astro';
import IconBubble from '@/components/ui/IconBubble.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { clientLogos, cmsMedia, googleTrust, questions } from '@/data/home';
import { teamMembers } from '@/data/team';

const swatches = [
  ['Brand blue', 'var(--nm-color-blue)', '#0E51FE'],
  ['Ink', 'var(--nm-color-ink)', '#090A0F'],
  ['Muted', 'var(--nm-color-muted)', '#5B6472'],
  ['Metadata', 'var(--nm-color-subtle)', '#626C7A'],
  ['Errore', 'var(--nm-color-error)', '#B42318'],
  ['Successo', 'var(--nm-color-success)', '#027A48'],
  ['Canvas', 'var(--nm-color-canvas)', '#F6F7F9'],
  ['Surface', 'var(--nm-color-surface)', '#FFFFFF'],
  ['Border', 'var(--nm-color-border)', '#DDE2EA']
];

const scale = [
  [
    'Display',
    'Comunichiamo valore attraverso progetti reali.',
    'ds-type-sample ds-type-sample--display'
  ],
  ['H1', 'Una direzione chiara per il progetto.', 'ds-type-sample ds-type-sample--h1'],
  ['H2', 'Competenze che lavorano insieme.', 'ds-type-sample ds-type-sample--h2'],
  ['H3', 'Strategia, contenuti e tecnologia.', 'ds-type-sample ds-type-sample--h3'],
  ['H4', 'Metodo e controllo.', 'ds-type-sample ds-type-sample--h4']
];

const classifications = [
  [
    'Design tokens',
    'Colore, tipo, spazio, griglia, radius, bordi e motion. Sono valori condivisi, non componenti.'
  ],
  [
    'Primitive',
    'Container, Section e Stack governano contenimento e ritmo senza imporre una scenografia.'
  ],
  [
    'Componenti',
    'Azioni, navigazione, progetti, team, recensioni, FAQ e form con responsabilità stabili.'
  ],
  [
    'Pattern editoriali',
    'Hero, split, featured e archivi condividono principi, ma mantengono composizioni adatte al contenuto.'
  ],
  [
    'Eccezioni di pagina',
    'Hero social, visual Siti web, timeline Agenzia e art direction dei case study restano locali.'
  ]
];

const motionExamples = [
  ['Fade', 'Metadata ed elementi leggeri.', 'fade'],
  ['Fade up', 'Blocchi editoriali e contenuti.', 'up'],
  ['Scale soft', 'Pannelli e card importanti.', 'scale'],
  ['Image reveal', 'Media principali e progetti.', 'media']
] satisfies [string, string, 'fade' | 'up' | 'scale' | 'media'][];
---

<BaseLayout
  title="Design System"
  description="Fonte visuale interna del design system Netmarket."
  path="/design-system/"
  noindex
>
  <Container wide>
    <header class="ds-hero nm-stack">
      <Badge>Fonte interna</Badge>
      <h1 id="page-title">Netmarket <span class="nm-heading-marker">design system.</span></h1>
      <p class="nm-lead">
        Un’unica base per progettare, sviluppare e verificare ogni pagina Netmarket.
      </p>
    </header>
    <nav class="ds-index" aria-label="Indice design system">
      <a href="#classification-title">Regole</a><a href="#foundations-title">Fondazioni</a>
      <a href="#rhythm-title">Layout</a><a href="#controls-title">Azioni</a><a href="#fields-title"
        >Form</a
      >
      <a href="#projects-title">Progetti</a><a href="#motion-title">Motion</a><a
        href="#shared-title">Pattern</a
      >
    </nav>
  </Container>

  <Section compact labelledby="classification-title">
    <Container wide>
      <Stack gap="var(--nm-space-xl)">
        <SectionHeading
          id="classification-title"
          text="Il riuso nasce da responsabilità comprovate. Le eccezioni non diventano standard per somiglianza."
          ><Fragment slot="title">
            Un sistema con <span class="nm-heading-accent">confini chiari.</span>
          </Fragment></SectionHeading
        >
        <div class="ds-component-grid">
          {
            classifications.map(([title, text]) => (
              <article class="ds-spec nm-stack">
                <h3>{title}</h3>
                <p>{text}</p>
              </article>
            ))
          }
        </div>
      </Stack>
    </Container>
  </Section>

  <Section compact labelledby="decisions-title">
    <Container wide
      ><Stack gap="var(--nm-space-xl)">
        <SectionHeading
          id="decisions-title"
          title="Una necessità, una scelta chiara."
          text="Prima di creare un componente, verifica questa mappa. Le composizioni speciali riusano le stesse primitive."
        />
        <div class="ds-table-wrap">
          <table class="ds-decisions">
            <caption class="visually-hidden">Mappa dei componenti canonici</caption><thead
              ><tr
                ><th scope="col">Necessità</th><th scope="col">Componente</th><th scope="col"
                  >Regola</th
                ></tr
              ></thead
            ><tbody
              >{
                designDecisions.map(([need, component, rule]) => (
                  <tr>
                    <>
                      <th scope="row">{need}</th>
                      <td>{component}</td>
                      <td>{rule}</td>
                    </>
                  </tr>
                ))
              }</tbody
            >
          </table>
        </div>
      </Stack></Container
    >
  </Section>

  <Section labelledby="foundations-title">
    <Container wide>
      <Stack gap="var(--nm-space-xl)">
        <SectionHeading
          id="foundations-title"
          text="Mona Sans, neutri freddi, bianco dominante e blu Netmarket usato come segnale."
          ><Fragment slot="title">Fondazioni visive.</Fragment></SectionHeading
        >
        <div class="ds-swatch-grid">
          {
            swatches.map(([name, value, hex]) => (
              <article class="ds-swatch">
                <div class="ds-swatch__chip" style={`background: ${value};`} />
                <h3>{name}</h3>
                <p class="nm-meta">{hex}</p>
              </article>
            ))
          }
        </div>
        <div class="ds-spec">
          {
            scale.map(([name, text, className]) => (
              <div class="ds-type-row">
                <p class="nm-meta">{name}</p>
                <h3 class={className}>{text}</h3>
              </div>
            ))
          }
        </div>
        <div class="ds-spacing-demo">
          <article class="ds-spacing-demo__h2">
            <h2 class="ds-type-sample ds-type-sample--h2">
              Una parola in <span class="nm-heading-accent">blu.</span>
            </h2>
            <p>Accento cromatico per il concetto principale, massimo uno per titolo.</p>
          </article>
          <article class="ds-spacing-demo__h2">
            <h2 class="ds-type-sample ds-type-sample--h2">
              Una selezione <span class="nm-heading-marker">intenzionale.</span>
            </h2>
            <p>Marker con barre e handle, compatibile con la “o” obliqua e con il reveal.</p>
          </article>
        </div>
      </Stack>
    </Container>
  </Section>

  <Section compact labelledby="controls-title">
    <Container wide>
      <Stack gap="var(--nm-space-xl)">
        <SectionHeading
          id="controls-title"
          text="Poche varianti, gerarchia netta, icone funzionali e focus sempre riconoscibile."
          ><Fragment slot="title">Azioni e segnali.</Fragment></SectionHeading
        >
        <div class="ds-component-grid">
          <article class="ds-spec nm-stack">
            <h3>Azioni su chiaro</h3>
            <div class="nm-cluster">
              <Button href="/contatti/">Parliamone</Button><Button
                href="/progetti/"
                variant="secondary">Guarda i progetti</Button
              >
            </div>
            <p>Primaria nera per l’azione principale; secondaria per un’alternativa.</p>
          </article>
          <article class="ds-spec ds-spec--dark nm-stack">
            <h3>Azioni su scuro</h3>
            <div class="nm-cluster">
              <Button href="/contatti/" variant="inverse">Raccontaci il progetto</Button>
            </div>
            <p>
              Inversa bianca. Il contrasto deve restare leggibile anche al passaggio del cursore.
            </p>
          </article>
          <article class="ds-spec nm-stack">
            <h3>Stati e dimensioni</h3>
            <div class="nm-cluster">
              <Button disabled>Non disponibile</Button><Button busy>Invio in corso</Button><Button
                size="large"
                href="/contatti/">Azione estesa</Button
              >
            </div>
            <p>
              Altezza minima 44 px; 56 px per form e CTA finali. Usa Tab per verificare il focus.
            </p>
          </article>
          <article class="ds-spec nm-stack">
            <h3>Badge e tassonomie</h3>
            <div class="nm-cluster">
              <Badge>Padova</Badge>
              <Badge>SEO</Badge>
              <Badge>Dal 1986</Badge>
            </div>
          </article>
          <article class="ds-spec nm-stack">
            <h3>Icone e controlli</h3><div class="nm-cluster">
              <IconButton label="Precedente" disabled
                ><IconArrowLeft aria-hidden="true" /></IconButton
              ><IconButton label="Successivo" disabled
                ><IconArrowRight aria-hidden="true" /></IconButton
              >
            </div>
            <div class="nm-cluster">
              <IconBubble name="desktop" label="Siti web" />
              <IconBubble name="palette" label="Branding" />
              <IconBubble name="chart" label="Marketing" />
              <IconBubble name="arrow" label="Approfondisci" />
            </div>
          </article>
          <article class="ds-spec nm-stack">
            <h3>Icone servizio</h3>
            <div class="nm-cluster">
              <IconBubble name="desktop" variant="service" label="Siti web" />
              <IconBubble name="chart" variant="service" label="Advertising" />
              <IconBubble name="bolt" variant="service" label="Software" />
              <IconBubble name="briefcase" variant="service" label="Ecommerce" />
            </div>
          </article>
        </div>
      </Stack>
    </Container>
  </Section>

  <Section labelledby="rhythm-title">
    <Container wide
      ><Stack gap="var(--nm-space-xl)">
        <SectionHeading
          id="rhythm-title"
          title="Lo spazio ha una regola."
          text="Una griglia comune, due ritmi di sezione e quattro raggi. Le variazioni editoriali devono avere uno scopo."
        />
        <div class="ds-rules-grid">
          <article class="ds-spec nm-stack">
            <h3>Contenimento</h3><dl class="ds-definition">
              <dt>Standard</dt><dd>1200 px: testo e contenuti</dd><dt>Wide</dt><dd>
                1328 px: portfolio e visual
              </dd><dt>Shell</dt><dd>1472 px: header e footer</dd>
            </dl>
          </article>
          <article class="ds-spec nm-stack">
            <h3>Ritmo verticale</h3><dl class="ds-definition">
              <dt>Standard</dt><dd>64-120 px tra sezioni</dd><dt>Compatto</dt><dd>
                44-80 px nei passaggi brevi
              </dd><dt>Testo</dt><dd>58 caratteri circa per riga</dd>
            </dl>
          </article>
          <article class="ds-spec nm-stack">
            <h3>Forme</h3><div class="ds-radius-examples">
              {
                [
                  ['Controlli', 'control'],
                  ['Media', 'media'],
                  ['Pannelli', 'card'],
                  ['Visual', 'feature']
                ].map(([label, token]) => (
                  <div style={`border-radius:var(--nm-radius-${token})`}>{label}</div>
                ))
              }
            </div>
          </article>
        </div>
        <div class="ds-spacing-scale">
          {
            ['2xs', 'xs', 'sm', 'md', 'lg', 'xl', '2xl', '3xl'].map((size) => (
              <div>
                <>
                  <span class="nm-meta">{size}</span>
                  <span class="ds-spacing-scale__bar" style={`width:var(--nm-space-${size})`} />
                </>
              </div>
            ))
          }
        </div>
      </Stack></Container
    >
  </Section>

  <Section labelledby="fields-title">
    <Container wide>
      <Stack gap="var(--nm-space-xl)">
        <SectionHeading
          id="fields-title"
          title="Form, in ogni stato."
          text="Contatti e candidature condividono campi, label, aiuti, errori e conferme. Gli esempi non inviano dati."
        />
        <div class="contact-form ds-form-demo">
          <div class="contact-form__grid">
            <label class="contact-form__field" for="ds-email">
              <span>Email aziendale</span>
              <input
                id="ds-email"
                type="email"
                placeholder="nome@azienda.it"
                aria-describedby="ds-email-hint"
              />
              <span class="contact-form__hint" id="ds-email-hint"
                >La label resta visibile mentre scrivi.</span
              >
            </label>
            <label class="contact-form__field contact-form__field--invalid" for="ds-error">
              <span>Email con errore</span>
              <input
                id="ds-error"
                type="email"
                value="indirizzo incompleto"
                aria-invalid="true"
                aria-describedby="ds-error-message"
              />
              <span class="contact-form__error" id="ds-error-message"
                >Inserisci un indirizzo email valido.</span
              >
            </label>
            <label class="contact-form__field" for="ds-disabled">
              <span>Campo non disponibile</span>
              <input id="ds-disabled" value="Non modificabile" disabled />
            </label>
            <label class="contact-form__field" for="ds-service">
              <span>Servizio</span>
              <select id="ds-service">
                {
                  [
                    'Scegli un servizio',
                    'Siti web',
                    'Branding e comunicazione',
                    'Software e integrazioni'
                  ].map((label) => <option>{label}</option>)
                }
              </select>
            </label>
          </div>
          <label class="contact-form__field" for="ds-message">
            <span>Messaggio</span>
            <textarea id="ds-message" rows="3" placeholder="Raccontaci il contesto del progetto"
            ></textarea>
          </label>
          <label class="contact-form__check">
            <input type="checkbox" />
            <span>Esempio di selezione con etichetta visibile.</span>
          </label>
          <p class="contact-form__status" data-state="success" role="status">
            Conferma: richiesta acquisita. Questo è un esempio di stato.
          </p>
        </div>
      </Stack>
    </Container>
  </Section>

  <Section labelledby="projects-title">
    <Container wide>
      <Stack gap="var(--nm-space-xl)">
        <SectionHeading
          id="projects-title"
          text="Media reali, tipologia, cliente e sintesi. Il featured resta un pattern editoriale distinto."
          ><Fragment slot="title"
            >Progetti come <span class="nm-heading-accent">prova.</span></Fragment
          ></SectionHeading
        >
        <div class="project-rail">
          <ProjectCard
            title="Sirene Blu"
            category="App e programma fedeltà"
            description="Card media-first per contesti secondari e contenuti correlati."
            image={cmsMedia.projects.sireneBlu}
            alt="Anteprima progetto Sirene Blu"
            href="/progetti/app-mobile-programma-fedelta-sirene-blu/"
          />
          <ProjectCard
            title="Albertini Allestimenti"
            category="Sito web"
            description="Immagine reale, categoria esterna al media e testo allineato a sinistra."
            image={cmsMedia.projects.albertini}
            alt="Anteprima progetto Albertini Allestimenti"
            href="/progetti/sviluppo-sito-web-allestimenti-fieristici-albertini/"
          />
          <ProjectCard
            title="Progetto-e"
            category="Sito web"
            description="Hover misurato e contenuto leggibile anche senza JavaScript."
            image={cmsMedia.projects.progettoe}
            alt="Anteprima progetto Progetto-e"
            href="/progetti/sviluppo-sito-web-fotovoltaico-progetto-e/"
          />
        </div>
      </Stack>
    </Container>
  </Section>

  <Section compact labelledby="motion-title">
    <Container wide>
      <Stack gap="var(--nm-space-xl)">
        <SectionHeading
          id="motion-title"
          text="Progressive enhancement, distanze brevi e contenuto sempre disponibile."
          ><Fragment slot="title">Motion con uno scopo.</Fragment></SectionHeading
        >
        <div class="motion-demo-grid">
          {
            motionExamples.map(([title, text, variant], index) => (
              <article class="motion-demo-card" data-reveal={variant} data-reveal-delay={index}>
                <span>{variant}</span>
                <h3>{title}</h3>
                <p>{text}</p>
              </article>
            ))
          }
        </div>
      </Stack>
    </Container>
  </Section>

  <Section labelledby="shared-title">
    <Container wide>
      <Stack gap="var(--nm-space-2xl)">
        <SectionHeading
          id="shared-title"
          text="Pattern condivisi già verificati nelle pagine principali."
          ><Fragment slot="title">Componenti canonici.</Fragment></SectionHeading
        >
        <ContactCTA
          titleId="ds-cta-title"
          title="Una sola CTA di contatto."
          text="Il componente comune chiude servizi, progetti e pagine istituzionali."
        />
        <ClientMarquee clients={clientLogos} />
        <TeamSection
          title="Persone reali, competenze coordinate."
          text="Ritratti 3:4, ruoli verificati e LinkedIn discreto."
          people={teamMembers}
        />
        <ReviewsSection
          title="Recensioni reali, leggibili."
          text="Badge, rail manuale, fade condizionale e dialog per il testo completo."
          rating={googleTrust.rating}
          reviewCount={googleTrust.reviewCount}
          googleHref={googleTrust.profileHref}
        />
        <FAQBlock
          title="FAQ essenziali."
          text="Introduzione e accordion accessibile, senza card annidate."
          items={questions.slice(0, 4)}
        />
        <div id="contatti">
          <CTAInlineForm title="Un modulo breve quando serve" highlight="un contatto diretto." />
        </div>
      </Stack>
    </Container>
  </Section>

  <Section compact labelledby="exceptions-title">
    <Container wide>
      <div class="ds-spec nm-stack">
        <p class="nm-meta">Eccezioni specifiche di pagina</p>
        <h2 id="exceptions-title" class="ds-type-sample ds-type-sample--h2">
          Art direction senza nuovi standard.
        </h2>
        <p class="nm-lead">
          Hero social della homepage, browser e bento Siti web, timeline Agenzia, featured degli
          archivi e colori dei singoli case study restano locali. Riutilizzano fondazioni e motion,
          ma non sono componenti universali.
        </p>
      </div>
    </Container>
  </Section>
</BaseLayout>

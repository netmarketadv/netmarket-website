---
import ClientMarquee from '@/components/blocks/ClientMarquee.astro';
import CTAInlineForm from '@/components/blocks/CTAInlineForm.astro';
import FAQBlock from '@/components/blocks/FAQBlock.astro';
import ReviewsSection from '@/components/blocks/ReviewsSection.astro';
import TeamSection from '@/components/blocks/TeamSection.astro';
import ProjectCard from '@/components/content/ProjectCard.astro';
import Container from '@/components/layout/Container.astro';
import Section from '@/components/layout/Section.astro';
import Stack from '@/components/layout/Stack.astro';
import Badge from '@/components/ui/Badge.astro';
import Button from '@/components/ui/Button.astro';
import IconBubble from '@/components/ui/IconBubble.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { clientLogos, cmsMedia, googleTrust, questions } from '@/data/home';
import { teamMembers } from '@/data/team';

const swatches = [
  ['Brand blue', 'var(--nm-color-blue)', '#0E51FE'],
  ['Ink', 'var(--nm-color-ink)', '#090A0F'],
  ['Muted', 'var(--nm-color-muted)', '#5B6472'],
  ['Canvas', 'var(--nm-color-canvas)', '#F6F7F9'],
  ['Surface', 'var(--nm-color-surface)', '#FFFFFF'],
  ['Border', 'var(--nm-color-border)', '#DDE2EA']
];

const scale = [
  [
    'Display',
    'Comunichiamo valore attraverso progetti reali.',
    'ds-type-sample ds-type-sample--display'
  ],
  ['H1', 'Una direzione chiara per il progetto.', 'ds-type-sample ds-type-sample--h1'],
  ['H2', 'Competenze che lavorano insieme.', 'ds-type-sample ds-type-sample--h2'],
  ['H3', 'Strategia, contenuti e tecnologia.', 'ds-type-sample ds-type-sample--h3'],
  ['H4', 'Metodo e controllo.', 'ds-type-sample ds-type-sample--h4']
];

const classifications = [
  [
    'Design tokens',
    'Colore, tipo, spazio, griglia, radius, bordi e motion. Sono valori condivisi, non componenti.'
  ],
  [
    'Primitive',
    'Container, Section, Stack e Cluster governano contenimento e ritmo senza imporre una scenografia.'
  ],
  [
    'Componenti',
    'Azioni, navigazione, progetti, team, recensioni, FAQ e form con responsabilita stabili.'
  ],
  [
    'Pattern editoriali',
    'Hero, split, featured e archivi condividono principi, ma mantengono composizioni adatte al contenuto.'
  ],
  [
    'Eccezioni di pagina',
    'Hero social, visual Siti web, timeline Agenzia e art direction dei case study restano locali.'
  ]
];

const motionExamples = [
  ['Fade', 'Metadata ed elementi leggeri.', 'fade'],
  ['Fade up', 'Blocchi editoriali e contenuti.', 'up'],
  ['Scale soft', 'Pannelli e card importanti.', 'scale'],
  ['Image reveal', 'Media principali e progetti.', 'media']
] satisfies [string, string, 'fade' | 'up' | 'scale' | 'media'][];
---

<BaseLayout
  title="Design System"
  description="Fonte visuale interna del design system Netmarket."
  path="/design-system/"
  noindex
>
  <Container wide>
    <header class="ds-hero nm-stack">
      <Badge>Fonte interna</Badge>
      <h1 id="page-title">Netmarket <span class="nm-heading-marker">design system.</span></h1>
      <p class="nm-lead">
        Il linguaggio reale del sito: editoriale, essenziale, project-led e costruito su contenuti
        verificabili.
      </p>
    </header>
  </Container>

  <Section compact labelledby="classification-title">
    <Container wide>
      <Stack gap="var(--nm-space-xl)">
        <div class="center-heading">
          <h2 id="classification-title">
            Un sistema con <span class="nm-heading-accent">confini chiari.</span>
          </h2>
          <p>
            Il riuso nasce da responsabilita comprovate. Le eccezioni non diventano standard per
            somiglianza.
          </p>
        </div>
        <div class="ds-component-grid">
          {
            classifications.map(([title, text]) => (
              <article class="ds-spec nm-stack">
                <h3>{title}</h3>
                <p>{text}</p>
              </article>
            ))
          }
        </div>
      </Stack>
    </Container>
  </Section>

  <Section labelledby="foundations-title">
    <Container wide>
      <Stack gap="var(--nm-space-xl)">
        <div class="center-heading">
          <h2 id="foundations-title">Fondazioni visive.</h2>
          <p>Mona Sans, neutri freddi, bianco dominante e blu Netmarket usato come segnale.</p>
        </div>
        <div class="ds-swatch-grid">
          {
            swatches.map(([name, value, hex]) => (
              <article class="ds-swatch">
                <div class="ds-swatch__chip" style={`background: ${value};`} />
                <h3>{name}</h3>
                <p class="nm-meta">{hex}</p>
              </article>
            ))
          }
        </div>
        <div class="ds-spec">
          {
            scale.map(([name, text, className]) => (
              <div class="ds-type-row">
                <p class="nm-meta">{name}</p>
                <h3 class={className}>{text}</h3>
              </div>
            ))
          }
        </div>
        <div class="ds-spacing-demo">
          <article class="ds-spacing-demo__h2">
            <h2 class="ds-type-sample ds-type-sample--h2">
              Una parola in <span class="nm-heading-accent">blu.</span>
            </h2>
            <p>Accento cromatico per il concetto principale, massimo uno per titolo.</p>
          </article>
          <article class="ds-spacing-demo__h2">
            <h2 class="ds-type-sample ds-type-sample--h2">
              Una selezione <span class="nm-heading-marker">intenzionale.</span>
            </h2>
            <p>Marker con barre e handle, compatibile con la “o” obliqua e con il reveal.</p>
          </article>
        </div>
      </Stack>
    </Container>
  </Section>

  <Section compact labelledby="controls-title">
    <Container wide>
      <Stack gap="var(--nm-space-xl)">
        <div class="center-heading">
          <h2 id="controls-title">Azioni e segnali.</h2>
          <p>Poche varianti, gerarchia netta, icone funzionali e focus sempre riconoscibile.</p>
        </div>
        <div class="ds-component-grid">
          <article class="ds-spec ds-spec--dark nm-stack">
            <h3>Bottoni</h3>
            <div class="nm-cluster">
              <Button href="#controls-title">Parliamone</Button>
              <Button href="#controls-title" variant="secondary">Guarda i progetti</Button>
              <Button href="#controls-title" variant="inverse">Azione su scuro</Button>
            </div>
          </article>
          <article class="ds-spec nm-stack">
            <h3>Badge e tassonomie</h3>
            <div class="nm-cluster">
              <Badge>Padova</Badge>
              <Badge>SEO</Badge>
              <Badge>Dal 1986</Badge>
            </div>
          </article>
          <article class="ds-spec nm-stack">
            <h3>Icone UI</h3>
            <div class="nm-cluster">
              <IconBubble name="desktop" label="Siti web" />
              <IconBubble name="palette" label="Branding" />
              <IconBubble name="chart" label="Marketing" />
              <IconBubble name="arrow" label="Approfondisci" />
            </div>
          </article>
          <article class="ds-spec nm-stack">
            <h3>Icone servizio</h3>
            <div class="nm-cluster">
              <IconBubble name="desktop" variant="service" label="Siti web" />
              <IconBubble name="chart" variant="service" label="Advertising" />
              <IconBubble name="bolt" variant="service" label="Software" />
              <IconBubble name="briefcase" variant="service" label="Ecommerce" />
            </div>
          </article>
        </div>
      </Stack>
    </Container>
  </Section>

  <Section labelledby="projects-title">
    <Container wide>
      <Stack gap="var(--nm-space-xl)">
        <div class="center-heading">
          <h2 id="projects-title">Progetti come <span class="nm-heading-accent">prova.</span></h2>
          <p>
            Media reali, tipologia, cliente e sintesi. Il featured resta un pattern editoriale
            distinto.
          </p>
        </div>
        <div class="project-rail">
          <ProjectCard
            title="Sirene Blu"
            category="Sito corporate"
            description="Card media-first per contesti secondari e contenuti correlati."
            image={cmsMedia.projects.sireneBlu}
            alt="Anteprima progetto Sirene Blu"
            href="/progetti/"
          />
          <ProjectCard
            title="Albertini Allestimenti"
            category="Sito web"
            description="Immagine reale, categoria nel media e testo breve allineato a sinistra."
            image={cmsMedia.projects.albertini}
            alt="Anteprima progetto Albertini Allestimenti"
            href="/progetti/"
          />
          <ProjectCard
            title="Progetto-e"
            category="Sito web"
            description="Hover misurato e contenuto leggibile anche senza JavaScript."
            image={cmsMedia.projects.progettoe}
            alt="Anteprima progetto Progetto-e"
            href="/progetti/"
          />
        </div>
      </Stack>
    </Container>
  </Section>

  <Section compact labelledby="motion-title">
    <Container wide>
      <Stack gap="var(--nm-space-xl)">
        <div class="center-heading" data-reveal="line">
          <h2 id="motion-title">Motion con uno scopo.</h2>
          <p>Progressive enhancement, distanze brevi e contenuto sempre disponibile.</p>
        </div>
        <div class="motion-demo-grid">
          {
            motionExamples.map(([title, text, variant], index) => (
              <article class="motion-demo-card" data-reveal={variant} data-reveal-delay={index}>
                <span>{variant}</span>
                <h3>{title}</h3>
                <p>{text}</p>
              </article>
            ))
          }
        </div>
      </Stack>
    </Container>
  </Section>

  <Section labelledby="shared-title">
    <Container wide>
      <Stack gap="var(--nm-space-2xl)">
        <div class="center-heading">
          <h2 id="shared-title">Componenti canonici.</h2>
          <p>Pattern condivisi gia verificati nelle pagine principali.</p>
        </div>
        <ClientMarquee clients={clientLogos} />
        <TeamSection
          title="Persone reali, competenze coordinate."
          text="Ritratti 3:4, ruoli verificati e LinkedIn discreto."
          people={teamMembers}
        />
        <ReviewsSection
          title="Recensioni reali, leggibili."
          text="Badge, rail manuale, fade condizionale e dialog per il testo completo."
          rating={googleTrust.rating}
          reviewCount={googleTrust.reviewCount}
          googleHref={googleTrust.profileHref}
        />
        <FAQBlock
          title="FAQ essenziali."
          text="Introduzione e accordion accessibile, senza card annidate."
          items={questions.slice(0, 4)}
        />
        <div id="contatti">
          <CTAInlineForm title="Un modulo breve quando serve" highlight="un contatto diretto." />
        </div>
      </Stack>
    </Container>
  </Section>

  <Section compact labelledby="exceptions-title">
    <Container wide>
      <div class="ds-spec nm-stack">
        <p class="nm-meta">Eccezioni specifiche di pagina</p>
        <h2 id="exceptions-title" class="ds-type-sample ds-type-sample--h2">
          Art direction senza nuovi standard.
        </h2>
        <p class="nm-lead">
          Hero social della homepage, browser e bento Siti web, timeline Agenzia, featured degli
          archivi e colori dei singoli case study restano locali. Riutilizzano fondazioni e motion,
          ma non sono componenti universali.
        </p>
      </div>
    </Container>
  </Section>
</BaseLayout>

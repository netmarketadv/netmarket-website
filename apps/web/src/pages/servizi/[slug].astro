---
import type { Service } from '@netmarket/schemas';
import { absoluteCanonical, breadcrumbJsonLd, serviceJsonLd } from '@netmarket/seo';
import FAQBlock from '@/components/blocks/FAQBlock.astro';
import Container from '@/components/layout/Container.astro';
import Section from '@/components/layout/Section.astro';
import ServiceCTA from '@/components/services/ServiceCTA.astro';
import ServiceDetailHero from '@/components/services/ServiceDetailHero.astro';
import ServiceIntro from '@/components/services/ServiceIntro.astro';
import ServiceProcess from '@/components/services/ServiceProcess.astro';
import ServiceProof from '@/components/services/ServiceProof.astro';
import ServiceTaxonomyList from '@/components/services/ServiceTaxonomyList.astro';
import ServiceTechnicalFocus from '@/components/services/ServiceTechnicalFocus.astro';
import ServiceExperiencePage from '@/components/services/ServiceExperiencePage.astro';
import WebsitesServicePage from '@/components/services/WebsitesServicePage.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import {
  isServiceExperienceSlug,
  serviceExperiences,
  type ServiceExperienceSlug
} from '@/data/service-experiences';
import { getServiceArchiveData, resolveRelated, serviceDescription } from '@/lib/services/content';

interface Props {
  service: Service;
  source: 'cms' | 'fallback';
}

export async function getStaticPaths() {
  const { services, source } = await getServiceArchiveData();
  return services.map((service) => ({
    params: { slug: service.slug },
    props: { service, source }
  }));
}

const canonicalSiteUrl = 'https://netmarket.it';
const { service } = Astro.props;
const related = await resolveRelated(service);
const path = `/servizi/${service.slug}/`;
const isWebsitesService = service.slug === 'siti-web';
const isExperienceService = isServiceExperienceSlug(service.slug);
const experience = isExperienceService
  ? serviceExperiences[service.slug as ServiceExperienceSlug]
  : undefined;
const description = isWebsitesService
  ? 'Realizzazione siti web a Padova per aziende: corporate, ecommerce e piattaforme digitali con comunicazione, contenuti, SEO e tecnologia integrate.'
  : (experience?.description ?? serviceDescription(service));
const title = isWebsitesService
  ? 'Realizzazione siti web a Padova'
  : (experience?.title ?? service.seo.title) || service.title;
const faqItems = service.faq
  .map((item) => {
    if (!item || typeof item !== 'object') return null;
    const record = item as Record<string, unknown>;
    const question = typeof record.question === 'string' ? record.question : '';
    const answer = typeof record.answer === 'string' ? record.answer : '';
    return question && answer ? [question, answer] : null;
  })
  .filter((item): item is [string, string] => Boolean(item))
  .slice(0, 6);
const breadcrumb = breadcrumbJsonLd([
  { name: 'Home', url: `${canonicalSiteUrl}/` },
  { name: 'Servizi', url: `${canonicalSiteUrl}/servizi/` },
  { name: service.title, url: absoluteCanonical(canonicalSiteUrl, path) }
]);
const serviceSchema = serviceJsonLd(
  canonicalSiteUrl,
  isWebsitesService ? 'Realizzazione siti web a Padova' : (experience?.eyebrow ?? service.title),
  description,
  absoluteCanonical(canonicalSiteUrl, path),
  isWebsitesService ? 'Realizzazione siti web' : service.title,
  isWebsitesService || isExperienceService
    ? [
        { '@type': 'City', name: 'Padova' },
        { '@type': 'Country', name: 'Italia' }
      ]
    : 'Italy'
);
const websitesSocialImage = isWebsitesService
  ? {
      id: 9101,
      url: '/media/rigomar.webp',
      alt: 'Progetto del sito web Rigomar realizzato da Netmarket',
      width: 1024,
      height: 576,
      mimeType: 'image/webp'
    }
  : undefined;
const experienceSocialImage = isExperienceService
  ? (related.caseStudies.find((item) => item.image)?.image ?? service.image ?? undefined)
  : undefined;
const faqSchema =
  faqItems.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: faqItems.map(([question, answer]) => ({
          '@type': 'Question',
          name: question,
          acceptedAnswer: { '@type': 'Answer', text: answer }
        }))
      }
    : undefined;
const structuredData = [breadcrumb, serviceSchema, ...(faqSchema ? [faqSchema] : [])];
const hasProof = service.results.length > 0;
---

<BaseLayout
  title={title}
  description={description}
  path={path}
  noindex={service.seo.noindex}
  canonicalSiteUrl={canonicalSiteUrl}
  structuredData={structuredData}
  socialTitle={isWebsitesService
    ? 'Realizzazione siti web a Padova | Netmarket'
    : experience?.title}
  socialDescription={isWebsitesService || isExperienceService ? description : undefined}
  socialImage={websitesSocialImage ?? experienceSocialImage}
  motionMode={isWebsitesService || isExperienceService ? 'light' : 'full'}
>
  {
    isWebsitesService ? (
      <Container wide>
        <WebsitesServicePage service={service} related={related} faqItems={faqItems} />
      </Container>
    ) : isExperienceService ? (
      <Container wide>
        <ServiceExperiencePage
          service={service}
          related={related}
          faqItems={faqItems}
          variant={service.slug as ServiceExperienceSlug}
        />
      </Container>
    ) : (
      <>
        <Container wide>
          <ServiceDetailHero service={service} />
        </Container>

        <Section compact labelledby="service-intro-title">
          <Container>
            <ServiceIntro service={service} />
          </Container>
        </Section>

        {hasProof && (
          <Section labelledby="service-proof-title">
            <Container>
              <ServiceProof items={service.results} />
            </Container>
          </Section>
        )}

        <Section labelledby="service-process-title">
          <Container>
            <ServiceProcess service={service} />
          </Container>
        </Section>

        <Section compact>
          <Container>
            <ServiceTechnicalFocus service={service} />
            <ServiceTaxonomyList service={service} />
          </Container>
        </Section>

        {faqItems.length > 0 && (
          <Section class="faq-section" labelledby="service-faq-title">
            <Container>
              <FAQBlock
                titleId="service-faq-title"
                title="FAQ"
                text={`Risposte essenziali sul servizio ${service.title}.`}
                items={faqItems}
              />
            </Container>
          </Section>
        )}

        <Section class="inline-cta-section" labelledby="service-cta-title">
          <Container wide>
            <ServiceCTA />
          </Container>
        </Section>
      </>
    )
  }
</BaseLayout>

---
import { breadcrumbJsonLd, caseStudyJsonLd } from '@netmarket/seo';
import BaseLayout from '@/layouts/BaseLayout.astro';
import CaseStudyHero from '@/components/projects/CaseStudyHero.astro';
import CaseStudyStory from '@/components/projects/CaseStudyStory.astro';
import CaseStudyMedia from '@/components/projects/CaseStudyMedia.astro';
import CaseStudyResults from '@/components/projects/CaseStudyResults.astro';
import RelatedProjects from '@/components/projects/RelatedProjects.astro';
import CaseStudyCTA from '@/components/projects/CaseStudyCTA.astro';
import {
  getProjectArchiveData,
  getProjectDetailData,
  projectClient,
  projectDescription,
  projectPath
} from '@/lib/projects/content';
import { projectPresentation, relatedProjectsFor } from '@/lib/projects/presentation';

export async function getStaticPaths() {
  const { projects } = await getProjectArchiveData();
  return projects.map((project) => ({ params: { slug: project.slug } }));
}

const canonicalSiteUrl = 'https://netmarket.it';
const { slug } = Astro.params;
const data = slug ? await getProjectDetailData(slug) : undefined;
if (!data) return Astro.redirect('/404/');
const { project, projects } = data;
const presentation = projectPresentation(project);
const description = project.seo.description || presentation.intro || projectDescription(project);
const canonicalPath = projectPath(project.slug);
const relatedProjects = relatedProjectsFor(project, projects);
const cover = project.cover ?? project.image;
const breadcrumb = breadcrumbJsonLd([
  { name: 'Home', url: `${canonicalSiteUrl}/` },
  { name: 'Progetti', url: `${canonicalSiteUrl}/progetti/` },
  { name: projectClient(project), url: `${canonicalSiteUrl}${canonicalPath}` }
]);
const schema = caseStudyJsonLd(project.title, description, `${canonicalSiteUrl}${canonicalPath}`, {
  client: projectClient(project),
  sector: presentation.sector,
  services: project.services.map((service) => service.title),
  providerId: `${canonicalSiteUrl}/#organization`,
  ...(project.projectYear > 0 ? { year: project.projectYear } : {}),
  ...(presentation.outcome ? { result: presentation.outcome } : {}),
  ...(cover?.url ? { image: new URL(cover.url, canonicalSiteUrl).toString() } : {})
});
---

<BaseLayout
  title={project.seo.title || `${projectClient(project)}: ${presentation.projectType}`}
  description={description}
  path={canonicalPath}
  canonicalSiteUrl={canonicalSiteUrl}
  noindex={project.seo.noindex}
  socialTitle={project.seo.socialTitle || presentation.heroTitle}
  socialDescription={project.seo.socialDescription || description}
  socialImage={project.seo.socialImage || cover}
  socialType="article"
  structuredData={[breadcrumb, schema]}
  motionMode="light"
>
  <article class:list={['case-study', `case-study--${presentation.theme}`]}>
    <CaseStudyHero project={project} presentation={presentation} />
    <CaseStudyStory sections={presentation.story} />
    <CaseStudyMedia items={presentation.media} client={projectClient(project)} />
    <CaseStudyResults outcome={presentation.outcome} metrics={presentation.metrics} />
    <RelatedProjects projects={relatedProjects} />
    <CaseStudyCTA />
  </article>
</BaseLayout>

<style>
  .case-study {
    --case-accent: var(--nm-color-blue);
    --case-accent-light: #8eb0ff;
    --case-ink: #080b16;
    --case-surface: #eef2f7;
    overflow: clip;
    background: #fff;
  }
  .case-study--dark {
    --case-accent: #4d7fff;
    --case-surface: #e8e9ec;
  }
  .case-study--energy {
    --case-accent: #087a57;
    --case-accent-light: #91e3c1;
    --case-ink: #09271f;
    --case-surface: #e8f3ef;
  }
  .case-study--retail {
    --case-accent: #075cff;
    --case-surface: #edf3ff;
  }
  .case-study--warm {
    --case-accent: #a14a28;
    --case-accent-light: #e8ad91;
    --case-ink: #23130d;
    --case-surface: #f2ece8;
  }
  .case-study--neutral {
    --case-accent: #515d70;
    --case-accent-light: #b7c0ce;
    --case-surface: #eef0f3;
  }
</style>

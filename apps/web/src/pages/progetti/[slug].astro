---
import type { MediaAsset } from '@netmarket/schemas';
import { breadcrumbJsonLd, caseStudyJsonLd } from '@netmarket/seo';
import Container from '@/components/layout/Container.astro';
import Section from '@/components/layout/Section.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import {
  getProjectArchiveData,
  getProjectDetailData,
  projectClient,
  projectDescription,
  projectPath
} from '@/lib/projects/content';

export async function getStaticPaths() {
  const { projects } = await getProjectArchiveData();
  return projects.map((project) => ({
    params: { slug: project.slug }
  }));
}

const canonicalSiteUrl = 'https://netmarket.it';
const { slug } = Astro.params;
const data = slug ? await getProjectDetailData(slug) : undefined;
if (!data) return Astro.redirect('/404/');
const { project, nextProject } = data;
const description = projectDescription(project);
const canonicalPath = projectPath(project.slug);
const breadcrumb = breadcrumbJsonLd([
  { name: 'Home', url: `${canonicalSiteUrl}/` },
  { name: 'Progetti', url: `${canonicalSiteUrl}/progetti/` },
  { name: project.title, url: `${canonicalSiteUrl}${canonicalPath}` }
]);
const schema = caseStudyJsonLd(project.title, description, `${canonicalSiteUrl}${canonicalPath}`);

function galleryMedia(item: unknown): MediaAsset | undefined {
  if (!item || typeof item !== 'object') return undefined;
  const record = item as { media?: unknown };
  if (!record.media || typeof record.media !== 'object') return undefined;
  const media = record.media as Partial<MediaAsset>;
  return typeof media.url === 'string' && typeof media.alt === 'string'
    ? (media as MediaAsset)
    : undefined;
}

const gallery = project.gallery.map(galleryMedia).filter((media): media is MediaAsset => Boolean(media));
const metrics = project.numericResults
  .map((metric) => (metric && typeof metric === 'object' ? (metric as { label?: string; value?: string; context?: string }) : null))
  .filter((metric): metric is { label?: string; value?: string; context?: string } => Boolean(metric?.value));
---

<BaseLayout
  title={project.seo.title || project.title}
  description={description}
  path={canonicalPath}
  canonicalSiteUrl={canonicalSiteUrl}
  noindex={project.seo.noindex}
  structuredData={[breadcrumb, schema]}
>
  <Section labelledby="project-title" class="project-detail-hero">
    <Container wide>
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span aria-hidden="true">/</span>
        <a href="/progetti/">Progetti</a>
        <span aria-hidden="true">/</span>
        <span>{projectClient(project)}</span>
      </nav>
      <div class="project-detail-hero__grid">
        <div data-reveal="line">
          <p class="nm-meta">{projectClient(project)}</p>
          <h1 id="project-title">{project.title}</h1>
          <p>{description}</p>
        </div>
        <aside class="project-meta-panel" aria-label="Dati progetto" data-reveal="up">
          <dl>
            <div>
              <dt>Cliente</dt>
              <dd>{projectClient(project)}</dd>
            </div>
            {project.projectYear > 0 && (
              <div>
                <dt>Anno</dt>
                <dd>{project.projectYear}</dd>
              </div>
            )}
            {project.services.length > 0 && (
              <div>
                <dt>Servizi</dt>
                <dd>
                  {project.services.map((service) => (
                    <a href={`/servizi/${service.slug}/`}>{service.title}</a>
                  ))}
                </dd>
              </div>
            )}
          </dl>
        </aside>
      </div>
    </Container>
  </Section>

  {
    project.cover && (
      <Section compact>
        <Container wide>
          <figure class="project-hero-media" data-reveal="scale">
            <img src={project.cover.url} alt={project.cover.alt} loading="eager" decoding="async" />
          </figure>
        </Container>
      </Section>
    )
  }

  <Section labelledby="project-story-title">
    <Container>
      <article class="project-story" data-reveal="up">
        <h2 id="project-story-title">Contenuto del progetto.</h2>
        {project.context && <p>{project.context}</p>}
        {project.approach && project.approach !== project.context && <p>{project.approach}</p>}
        {
          project.additionalContent &&
            project.additionalContent !== project.context &&
            project.additionalContent !== project.approach && <p>{project.additionalContent}</p>
        }
      </article>
    </Container>
  </Section>

  {
    metrics.length > 0 && (
      <Section compact labelledby="project-results-title">
        <Container>
          <div class="project-results" data-reveal="up" data-reveal-stagger="1">
            <h2 id="project-results-title">Risultati dichiarati.</h2>
            {metrics.map((metric) => (
              <article>
                <strong>{metric.value}</strong>
                <span>{metric.label || 'Risultato'}</span>
                {metric.context && <p>{metric.context}</p>}
              </article>
            ))}
          </div>
        </Container>
      </Section>
    )
  }

  {
    gallery.length > 0 && (
      <Section labelledby="project-gallery-title">
        <Container wide>
          <div class="project-gallery" data-reveal="up" data-reveal-stagger="1">
            <h2 id="project-gallery-title">Media del progetto.</h2>
            {gallery.map((media) => (
              <figure>
                <img src={media.url} alt={media.alt} loading="lazy" decoding="async" />
              </figure>
            ))}
          </div>
        </Container>
      </Section>
    )
  }

  {
    nextProject && (
      <Section compact>
        <Container>
          <a class="next-project" href={projectPath(nextProject.slug)} data-reveal="up">
            <span>Progetto successivo</span>
            <strong>{nextProject.title}</strong>
          </a>
        </Container>
      </Section>
    )
  }
</BaseLayout>

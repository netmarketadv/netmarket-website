---
import {
  IconArrowUpRight,
  IconBuilding,
  IconCheck,
  IconClock,
  IconMail,
  IconMapPin
} from '@tabler/icons-astro';
import { breadcrumbJsonLd, organizationJsonLd, webPageJsonLd } from '@netmarket/seo';
import ContactForm from '@/components/forms/ContactForm.astro';
import Container from '@/components/layout/Container.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';

const canonicalSiteUrl = 'https://netmarket.it';
const title = 'Contatti: agenzia marketing e comunicazione a Padova';
const description =
  'Contatta Netmarket, agenzia di comunicazione, marketing e tecnologia a Padova. Raccontaci il progetto: individueremo insieme il prossimo passo.';
const address = 'Viale della Navigazione Interna, 51/b';
const city = '35129 Padova (PD)';
const email = 'segreteria@netmarket.it';
const mapsUrl = 'https://share.google/DPsZDzWohdLvBMwmZ';
const breadcrumb = breadcrumbJsonLd([
  { name: 'Home', url: `${canonicalSiteUrl}/` },
  { name: 'Contatti', url: `${canonicalSiteUrl}/contatti/` }
]);
const pageSchema = {
  ...webPageJsonLd({
    title,
    description,
    canonicalPath: '/contatti/',
    siteUrl: canonicalSiteUrl,
    robots: 'index, follow'
  }),
  '@type': 'ContactPage',
  mainEntity: { '@id': `${canonicalSiteUrl}/#organization` }
};
const organization = {
  ...organizationJsonLd(canonicalSiteUrl, {
    name: 'Netmarket',
    legalName: 'Netmarket Srl',
    vatId: '03618730281',
    url: canonicalSiteUrl
  }),
  address: {
    '@type': 'PostalAddress',
    streetAddress: address,
    postalCode: '35129',
    addressLocality: 'Padova',
    addressRegion: 'PD',
    addressCountry: 'IT'
  },
  contactPoint: {
    '@type': 'ContactPoint',
    email,
    contactType: 'customer service',
    availableLanguage: 'Italian'
  },
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
      opens: '09:00',
      closes: '13:00'
    },
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
      opens: '14:00',
      closes: '18:00'
    }
  ]
};

const nextSteps = [
  ['01', 'Leggiamo la richiesta', 'Mettiamo a fuoco obiettivo, contesto e priorità.'],
  ['02', 'Ti ricontattiamo', 'Una persona del team approfondisce il progetto con te.'],
  [
    '03',
    'Definiamo il passo successivo',
    'Costruiamo un percorso sensato, senza soluzioni preconfezionate.'
  ]
] as const;
---

<BaseLayout
  title={title}
  description={description}
  path="/contatti/"
  canonicalSiteUrl={canonicalSiteUrl}
  structuredData={[breadcrumb, pageSchema, organization]}
  motionMode="light"
>
  <div class="contact-page">
    <section class="contact-hero" aria-labelledby="contact-title">
      <Container wide>
        <div class="contact-hero__grid">
          <div class="contact-hero__title" data-reveal="line">
            <p class="nm-meta">Contatti Netmarket</p>
            <h1 id="contact-title">
              Raccontaci cosa deve <span class="nm-heading-accent">funzionare.</span>
            </h1>
          </div>
          <div class="contact-hero__copy" data-reveal="up">
            <p>
              Netmarket è un’agenzia di comunicazione, marketing e tecnologia a Padova. Tu
              raccontaci l’obiettivo: saremo noi a collegare le competenze giuste.
            </p>
            <p class="contact-hero__scope">
              Siti web, ecommerce, SEO, advertising, social, branding, contenuti, software, concorsi
              a premi e NØD.
            </p>
          </div>
        </div>
      </Container>
    </section>

    <section class="contact-workspace" aria-labelledby="contact-form-title">
      <Container wide>
        <div class="contact-layout">
          <div class="contact-panel" data-reveal="up">
            <header class="contact-panel__header">
              <div>
                <p class="nm-meta">Il tuo progetto</p>
                <h2 id="contact-form-title">Partiamo dal contesto.</h2>
              </div>
              <p>
                Non serve conoscere già la soluzione. Scrivi cosa vuoi ottenere e cosa oggi non sta
                funzionando come dovrebbe.
              </p>
            </header>
            <div class="contact-panel__proof">
              <IconCheck aria-hidden="true" stroke={1.8} />
              <span
                >Dal 1986 lavoriamo con aziende, obiettivi e livelli di complessità diversi.</span
              >
            </div>
            <ContactForm />
          </div>

          <aside class="contact-info" aria-label="Informazioni di contatto" data-reveal="scale">
            <div>
              <p class="contact-info__eyebrow">Netmarket Srl</p>
              <h2>Parliamone anche direttamente.</h2>
              <p>Ci trovi a Padova. Se preferisci, puoi scriverci via email.</p>
            </div>

            <dl>
              <div>
                <dt><IconMail aria-hidden="true" stroke={1.7} /> Email</dt>
                <dd><a href={`mailto:${email}`}>{email}</a></dd>
              </div>
              <div>
                <dt><IconMapPin aria-hidden="true" stroke={1.7} /> Indirizzo</dt>
                <dd>{address}<br />{city}</dd>
              </div>
              <div>
                <dt><IconClock aria-hidden="true" stroke={1.7} /> Orari</dt>
                <dd>Lunedì-venerdì<br />9:00-13:00 · 14:00-18:00</dd>
              </div>
              <div>
                <dt><IconBuilding aria-hidden="true" stroke={1.7} /> Dati societari</dt>
                <dd>P.IVA e C.F. 03618730281</dd>
              </div>
            </dl>

            <a class="contact-info__map" href={mapsUrl} target="_blank" rel="noopener noreferrer">
              Apri su Google Maps
              <IconArrowUpRight aria-hidden="true" stroke={1.8} />
            </a>
          </aside>
        </div>
      </Container>
    </section>

    <section class="contact-next" aria-labelledby="contact-next-title">
      <Container wide>
        <div class="contact-next__heading" data-reveal="up">
          <p class="nm-meta">Senza passaggi inutili</p>
          <h2 id="contact-next-title">Cosa succede dopo.</h2>
        </div>
        <ol class="contact-next__steps" data-reveal="up" data-reveal-stagger="1">
          {
            nextSteps.map(([number, stepTitle, text]) => (
              <li>
                <span>{number}</span>
                <div>
                  <h3>{stepTitle}</h3>
                  <p>{text}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </Container>
    </section>
  </div>
</BaseLayout>

<style>
  .contact-page {
    overflow: clip;
    background: var(--nm-color-surface);
  }

  .contact-hero {
    padding: clamp(5rem, 6.5vw, 6.5rem) 0 clamp(3rem, 5vw, 5rem);
    border-bottom: 1px solid var(--nm-color-border);
  }

  .contact-hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.18fr) minmax(20rem, 0.72fr);
    gap: clamp(2rem, 7vw, 7rem);
    align-items: end;
  }

  .contact-hero__title,
  .contact-hero__copy,
  .contact-panel__header > div {
    min-width: 0;
  }

  .contact-hero h1 {
    max-width: 10ch;
    margin-top: var(--nm-heading-gap-sm);
    font-size: clamp(3.6rem, 6.4vw, 6.6rem);
    line-height: 0.96;
    letter-spacing: 0;
    text-wrap: balance;
  }

  .contact-hero__copy > p:first-child {
    max-width: 37rem;
    color: var(--nm-color-ink-2);
    font-size: var(--nm-text-lead);
    line-height: 1.52;
  }

  .contact-hero__scope {
    max-width: 36rem;
    margin-top: 1.4rem;
    padding-top: 1.15rem;
    border-top: 1px solid var(--nm-color-border);
    color: var(--nm-color-muted);
    font-size: var(--nm-text-small);
    line-height: 1.55;
  }

  .contact-workspace {
    padding-block: clamp(3.25rem, 6vw, 6rem);
    background: var(--nm-color-canvas);
  }

  .contact-layout {
    display: grid;
    grid-template-columns: minmax(0, 1.32fr) minmax(20rem, 0.68fr);
    gap: clamp(1rem, 2.5vw, 2rem);
    align-items: start;
  }

  .contact-panel {
    min-width: 0;
    border: 1px solid var(--nm-color-border);
    border-radius: var(--nm-radius-lg);
    padding: clamp(1.35rem, 3.5vw, 3rem);
    background: var(--nm-color-surface);
  }

  .contact-panel__header {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(16rem, 0.72fr);
    gap: clamp(1.5rem, 4vw, 4rem);
    align-items: end;
  }

  .contact-panel__header h2,
  .contact-info h2,
  .contact-next h2 {
    margin-top: var(--nm-heading-gap-xs);
    font-size: clamp(2.35rem, 4vw, 4.2rem);
    line-height: 1;
    letter-spacing: 0;
    text-wrap: balance;
  }

  .contact-panel__header > p {
    color: var(--nm-color-muted);
    line-height: var(--nm-leading-body);
  }

  .contact-panel__proof {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    margin-top: clamp(1.5rem, 3vw, 2.5rem);
    padding-block: 1rem;
    border-block: 1px solid var(--nm-color-border);
    color: var(--nm-color-ink-2);
    font-size: var(--nm-text-small);
  }

  .contact-panel__proof svg {
    width: 1.1rem;
    height: 1.1rem;
    color: var(--nm-color-blue);
    flex: none;
  }

  .contact-info {
    position: sticky;
    top: calc(var(--site-header-height, 5rem) + 1.25rem);
    display: grid;
    gap: clamp(2.5rem, 5vw, 4.75rem);
    min-width: 0;
    border: 0;
    border-radius: var(--nm-radius-lg);
    padding: clamp(1.5rem, 3vw, 2.5rem);
    background: var(--nm-color-inverse);
    color: var(--nm-color-on-inverse);
  }

  .contact-info__eyebrow {
    color: #86a8ff;
    font-size: var(--nm-text-label);
    font-weight: 650;
    text-transform: uppercase;
  }

  .contact-info h2 {
    max-width: 100%;
    color: var(--nm-color-on-inverse);
    font-size: clamp(2.25rem, 2.7vw, 3rem);
  }

  .contact-info > div > p:last-child {
    max-width: 29rem;
    margin-top: 1.1rem;
    color: #b8c0d0;
    line-height: 1.55;
  }

  .contact-info dl {
    display: grid;
    gap: 0;
    margin: 0;
  }

  .contact-info dl > div {
    padding-block: 1rem;
    border-top: 1px solid rgb(255 255 255 / 0.16);
  }

  .contact-info dt {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    color: #9fa9bb;
    font-size: var(--nm-text-small);
  }

  .contact-info dt svg {
    width: 1rem;
    height: 1rem;
  }

  .contact-info dd {
    margin: 0.55rem 0 0 1.55rem;
    color: #fff;
    line-height: 1.5;
  }

  .contact-info dd a {
    color: inherit;
    overflow-wrap: anywhere;
    text-underline-offset: 0.2em;
  }

  .contact-info__map {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    min-height: 3.3rem;
    border-radius: var(--nm-radius-pill);
    padding: 0.8rem 1.1rem;
    background: #fff;
    color: var(--nm-color-ink);
    font-weight: 600;
    text-decoration: none;
    transition:
      transform var(--nm-motion-duration-fast) var(--nm-motion-ease-hover),
      background var(--nm-motion-duration-fast) var(--nm-motion-ease-hover);
  }

  .contact-info__map svg {
    width: 1.1rem;
    height: 1.1rem;
    transition: transform var(--nm-motion-duration-fast) var(--nm-motion-ease-hover);
  }

  .contact-info__map:hover {
    background: var(--nm-color-blue-soft);
    transform: translateY(-2px);
  }

  .contact-info__map:hover svg {
    transform: translate(0.15rem, -0.15rem);
  }

  .contact-info__map:focus-visible {
    outline: 3px solid #86a8ff;
    outline-offset: 3px;
  }

  .contact-next {
    padding-block: clamp(4rem, 7vw, 7rem);
  }

  .contact-next__heading {
    display: grid;
    grid-template-columns: minmax(0, 0.7fr) minmax(0, 1.3fr);
    gap: 2rem;
    align-items: end;
  }

  .contact-next__heading h2 {
    grid-column: 2;
    margin-top: 0;
  }

  .contact-next__steps {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin: clamp(2.5rem, 5vw, 4.5rem) 0 0;
    padding: 0;
    border-top: 1px solid var(--nm-color-border-strong);
    list-style: none;
  }

  .contact-next__steps li {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 1rem;
    min-width: 0;
    padding: 1.4rem clamp(1rem, 2vw, 1.75rem) 0;
    border-left: 1px solid var(--nm-color-border);
  }

  .contact-next__steps li:first-child {
    padding-left: 0;
    border-left: 0;
  }

  .contact-next__steps li > span {
    color: var(--nm-color-blue);
    font-size: var(--nm-text-meta);
    font-weight: 650;
  }

  .contact-next__steps h3 {
    font-size: 1.15rem;
    line-height: 1.2;
  }

  .contact-next__steps p {
    margin-top: 0.45rem;
    color: var(--nm-color-muted);
    line-height: 1.5;
  }

  @media (max-width: 960px) {
    .contact-hero__grid,
    .contact-layout {
      grid-template-columns: 1fr;
    }

    .contact-hero__copy {
      max-width: 44rem;
    }

    .contact-info {
      position: static;
    }

    .contact-info h2 {
      max-width: 13ch;
    }
  }

  @media (max-width: 680px) {
    .contact-hero {
      padding-top: 5rem;
    }

    .contact-hero__grid {
      gap: 1.5rem;
    }

    .contact-hero h1 {
      max-width: 9ch;
      font-size: clamp(3rem, 14vw, 4rem);
    }

    .contact-hero__copy > p:first-child {
      font-size: 1.05rem;
    }

    .contact-workspace {
      padding-block: 2.5rem;
    }

    .contact-panel,
    .contact-info {
      border-radius: var(--nm-radius-md);
    }

    .contact-panel__header,
    .contact-next__heading {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .contact-panel__header h2,
    .contact-next h2 {
      font-size: clamp(2.25rem, 11vw, 3.1rem);
    }

    .contact-panel__proof {
      align-items: flex-start;
    }

    .contact-info {
      gap: 2rem;
    }

    .contact-info__map {
      width: 100%;
    }

    .contact-next__heading h2 {
      grid-column: auto;
    }

    .contact-next__steps {
      grid-template-columns: 1fr;
      margin-top: 2rem;
    }

    .contact-next__steps li,
    .contact-next__steps li:first-child {
      padding: 1.15rem 0;
      border-top: 1px solid var(--nm-color-border);
      border-left: 0;
    }

    .contact-next__steps li:first-child {
      border-top: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .contact-info__map,
    .contact-info__map svg {
      transition: none;
    }
  }
</style>

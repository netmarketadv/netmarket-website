---
import {
  IconArrowRight,
  IconBolt,
  IconBriefcase,
  IconCamera,
  IconChartBar,
  IconDeviceDesktop,
  IconPalette,
  IconRoute,
  IconSearch,
  IconShieldCheck,
  IconUsersGroup
} from '@tabler/icons-astro';
import { breadcrumbJsonLd, organizationJsonLd, personJsonLd, webPageJsonLd } from '@netmarket/seo';
import BaseLayout from '@/layouts/BaseLayout.astro';
import ClientMarquee from '@/components/blocks/ClientMarquee.astro';
import Container from '@/components/layout/Container.astro';
import Section from '@/components/layout/Section.astro';
import { clientLogos } from '@/data/home';
import { teamMembers } from '@/data/team';
import {
  getProjectArchiveData,
  projectCategory,
  projectClient,
  projectDescription,
  projectPath
} from '@/lib/projects/content';

const canonicalSiteUrl = 'https://netmarket.it';
const title = 'Agenzia comunicazione e marketing Padova';
const description =
  'Netmarket è un’agenzia di comunicazione, marketing e web a Padova attiva dal 1986. Unisce strategia, creatività, tecnologia e contenuti per aziende e PMI.';
const breadcrumb = breadcrumbJsonLd([
  { name: 'Home', url: `${canonicalSiteUrl}/` },
  { name: 'Agenzia', url: `${canonicalSiteUrl}/agenzia/` }
]);
const pageSchema = webPageJsonLd({
  title,
  description,
  canonicalPath: '/agenzia/',
  siteUrl: canonicalSiteUrl,
  robots: 'index, follow'
});
const aboutSchema = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  name: title,
  description,
  url: `${canonicalSiteUrl}/agenzia/`,
  mainEntity: { '@id': `${canonicalSiteUrl}/#organization` },
  about: {
    '@type': 'Organization',
    '@id': `${canonicalSiteUrl}/#organization`,
    name: 'Netmarket',
    foundingDate: '1986',
    address: {
      '@type': 'PostalAddress',
      addressLocality: 'Padova',
      addressRegion: 'PD',
      addressCountry: 'IT'
    },
    areaServed: 'Italy',
    slogan: 'Comunichiamo valore.'
  }
};
const organization = organizationJsonLd(canonicalSiteUrl, {
  name: 'Netmarket',
  legalName: 'Netmarket Srl',
  vatId: '03618730281',
  url: canonicalSiteUrl
});
const people = teamMembers.map((person) =>
  personJsonLd(canonicalSiteUrl, {
    id: person.id,
    name: person.fullName,
    givenName: person.givenName,
    familyName: person.familyName,
    jobTitle: person.role,
    sameAs: person.linkedin ? [person.linkedin] : [],
    image: person.image
  })
);

const { projects } = await getProjectArchiveData();
const selectedProjects = projects
  .filter((project) => project.projectStatus === 'published' && project.cover)
  .slice(0, 4);
const heroProject = selectedProjects[0];

const serviceLinks = [
  ['/servizi/siti-web/', 'Siti web', IconDeviceDesktop],
  ['/servizi/ecommerce/', 'Ecommerce', IconBriefcase],
  ['/servizi/branding-e-comunicazione/', 'Branding', IconPalette],
  ['/servizi/seo/', 'SEO', IconSearch],
  ['/servizi/advertising/', 'Advertising', IconChartBar],
  ['/servizi/social-media/', 'Social media', IconUsersGroup],
  ['/servizi/content-production/', 'Foto e video', IconCamera],
  ['/servizi/software-e-integrazioni/', 'Software', IconBolt]
] as const;

const methodSteps = [
  [
    'Capire',
    'Obiettivi, pubblico, mercato e vincoli vengono messi in ordine prima della produzione.'
  ],
  ['Progettare', 'Messaggi, contenuti, interfacce e strumenti diventano una direzione condivisa.'],
  [
    'Realizzare',
    'Design, sviluppo, campagne e materiali partono con priorità e responsabilità chiare.'
  ],
  ['Misurare', 'Dati, feedback e comportamento degli utenti guidano le decisioni successive.'],
  ['Migliorare', 'Il progetto resta vivo: contenuti, SEO, campagne e strumenti evolvono nel tempo.']
] as const;

const eras = [
  ['1986', 'Comunicazione tradizionale'],
  ['Web', 'Siti, contenuti e presenza digitale'],
  ['Marketing', 'SEO, campagne, social e misurazione'],
  ['Oggi', 'Software, automazioni e sistemi AI']
] as const;
---

<BaseLayout
  title={title}
  description={description}
  path="/agenzia/"
  canonicalSiteUrl={canonicalSiteUrl}
  structuredData={[breadcrumb, pageSchema, aboutSchema, organization, ...people]}
  motionMode="light"
>
  <Section labelledby="agency-title" class="agency-hero">
    <Container wide>
      <div class="agency-hero__grid">
        <div class="agency-hero__copy" data-reveal="line">
          <p class="nm-meta">Netmarket, Padova dal 1986</p>
          <h1 id="agency-title">
            Agenzia di comunicazione e marketing a <span
              class="nm-heading-marker nm-heading-marker--strong">Padova.</span
            >
          </h1>
          <p>
            Mettiamo insieme strategia, creatività, tecnologia e contenuti per aiutare aziende e PMI
            a comunicare valore con continuità.
          </p>
          <div class="agency-hero__actions">
            <a class="nm-button nm-button--primary" href="/contatti/">Parliamone</a>
            <a class="nm-button nm-button--secondary" href="/progetti/">Guarda i progetti</a>
          </div>
        </div>

        <div class="agency-hero__visual" data-reveal="media">
          <div class="agency-hero__panel agency-hero__panel--dark">
            <span>Comunichiamo valore.</span>
            <strong>Una regia per brand, sito, marketing e tecnologia.</strong>
          </div>
          {
            heroProject?.cover && (
              <a class="agency-hero__project" href={projectPath(heroProject.slug)}>
                <img
                  src={heroProject.cover.url}
                  alt={heroProject.cover.alt}
                  width="900"
                  height="675"
                  loading="eager"
                  decoding="async"
                  fetchpriority="high"
                  sizes="(max-width: 767px) 82vw, (max-width: 1200px) 42vw, 520px"
                />
                <span>{projectClient(heroProject)}</span>
              </a>
            )
          }
          <div class="agency-hero__signal">
            <strong>1986</strong>
            <span>esperienza che continua a evolvere</span>
          </div>
        </div>
      </div>
    </Container>
  </Section>

  <Section labelledby="agency-identity-title" class="agency-intro">
    <Container>
      <div class="agency-intro__grid">
        <div data-reveal="line">
          <h2 id="agency-identity-title">
            Non un reparto isolato. Una <span class="nm-heading-accent">direzione</span> intorno al progetto.
          </h2>
        </div>
        <div class="agency-intro__text" data-reveal="up">
          <p>
            Netmarket è un’agenzia di comunicazione e marketing con sede a Padova. Dal 1986 affianca
            aziende e PMI nella costruzione di identità, contenuti, siti web, ecommerce, campagne,
            social media, SEO, software e strumenti operativi.
          </p>
          <p>
            Il valore non sta nel sommare attività separate, ma nel farle lavorare insieme: meno
            fornitori da coordinare, più coerenza tra i messaggi e decisioni più semplici per chi
            guida l’azienda.
          </p>
        </div>
      </div>
    </Container>
  </Section>

  <Section labelledby="agency-evolution-title" class="agency-evolution">
    <Container wide>
      <div class="agency-evolution__layout">
        <div class="agency-evolution__headline" data-reveal="line">
          <h2 id="agency-evolution-title">
            Gli strumenti cambiano. Il <span class="nm-heading-marker">principio resta.</span>
          </h2>
          <p>
            Dalla comunicazione tradizionale al digitale, il lavoro resta lo stesso: chiarire cosa
            rende utile un’azienda e renderlo comprensibile nei canali giusti.
          </p>
        </div>
        <ol class="agency-timeline" data-reveal="up" data-reveal-stagger="1">
          {
            eras.map(([label, text]) => (
              <li>
                <span>{label}</span>
                <p>{text}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </Container>
  </Section>

  <Section labelledby="agency-system-title" class="agency-system">
    <Container wide>
      <div class="agency-system__card" data-reveal="scale">
        <div class="agency-system__copy">
          <h2 id="agency-system-title">
            Una regia unica per comunicazione, <span class="nm-heading-accent">marketing</span> e tecnologia.
          </h2>
          <p>
            Quando brand, sito, campagne, contenuti e strumenti interni parlano la stessa lingua,
            ogni scelta diventa più leggibile: per i clienti, per il team commerciale e per chi deve
            misurare cosa funziona.
          </p>
        </div>
        <div class="agency-system__matrix" aria-label="Aree integrate Netmarket">
          <article>
            <IconPalette stroke={1.7} aria-hidden="true" />
            <h3>Creatività</h3>
            <p>Identità, messaggi, materiali e direzione visuale.</p>
          </article>
          <article>
            <IconDeviceDesktop stroke={1.7} aria-hidden="true" />
            <h3>Web</h3>
            <p>Siti, ecommerce, CMS, performance e interfacce.</p>
          </article>
          <article>
            <IconChartBar stroke={1.7} aria-hidden="true" />
            <h3>Marketing</h3>
            <p>SEO, campagne, social, analytics e conversione.</p>
          </article>
          <article>
            <IconBolt stroke={1.7} aria-hidden="true" />
            <h3>Tecnologia</h3>
            <p>Software, automazioni, integrazioni e dati.</p>
          </article>
        </div>
      </div>
    </Container>
  </Section>

  <Section labelledby="agency-method-title" class="agency-method">
    <Container>
      <div class="agency-method__header" data-reveal="line">
        <h2 id="agency-method-title">
          Un metodo per trasformare richieste sparse in <span class="nm-heading-accent"
            >priorità</span
          > chiare.
        </h2>
      </div>
      <ol class="agency-method__steps" data-reveal="up" data-reveal-stagger="1">
        {
          methodSteps.map(([title, text], index) => (
            <li>
              <span>{String(index + 1).padStart(2, '0')}</span>
              <h3>{title}</h3>
              <p>{text}</p>
            </li>
          ))
        }
      </ol>
    </Container>
  </Section>

  <Section labelledby="agency-services-title" class="agency-services">
    <Container wide>
      <div class="agency-services__grid">
        <div class="agency-services__lead" data-reveal="line">
          <h2 id="agency-services-title">
            Competenze che lavorano <span class="nm-heading-marker">insieme.</span>
          </h2>
          <p>
            La pagina giusta, la campagna giusta o il contenuto giusto cambiano da progetto a
            progetto. La regia deve restare una.
          </p>
        </div>
        <div class="agency-services__links" data-reveal="up" data-reveal-stagger="1">
          {
            serviceLinks.map(([href, label, Icon]) => (
              <a href={href}>
                <Icon stroke={1.7} aria-hidden="true" />
                <span>{label}</span>
                <IconArrowRight stroke={1.7} aria-hidden="true" />
              </a>
            ))
          }
        </div>
      </div>
    </Container>
  </Section>

  {
    selectedProjects.length > 0 && (
      <Section labelledby="agency-projects-title" class="agency-projects">
        <Container wide>
          <div class="agency-projects__header" data-reveal="line">
            <h2 id="agency-projects-title">
              Progetti reali, ambiti <span class="nm-heading-accent">diversi.</span>
            </h2>
            <p>
              Alcuni casi studio pubblicati mostrano come sito, contenuti, design e tecnologia
              possano entrare nello stesso percorso.
            </p>
          </div>
          <div class="agency-projects__rail" data-reveal="up">
            {selectedProjects.map((project, index) => (
              <a
                class:list={['agency-project-card', index === 0 && 'agency-project-card--large']}
                href={projectPath(project.slug)}
                data-cursor-label="Guarda"
              >
                <img
                  src={project.cover?.url}
                  alt={project.cover?.alt}
                  width="900"
                  height="675"
                  loading={index === 0 ? 'eager' : 'lazy'}
                  decoding="async"
                  sizes="(max-width: 767px) 82vw, (max-width: 1200px) 46vw, 34vw"
                />
                <div>
                  <span>{projectCategory(project)}</span>
                  <h3>{projectClient(project)}</h3>
                  <p>{projectDescription(project)}</p>
                </div>
              </a>
            ))}
          </div>
          <a class="agency-projects__link" href="/progetti/">
            Tutti i progetti
            <IconArrowRight stroke={1.7} aria-hidden="true" />
          </a>
        </Container>
      </Section>
    )
  }

  <Section id="team" labelledby="agency-team-title" class="agency-team">
    <Container wide>
      <div class="agency-team__header" data-reveal="line">
        <h2 id="agency-team-title">
          Persone reali, competenze <span class="nm-heading-accent">coordinate.</span>
        </h2>
        <p>Un gruppo compatto che unisce sviluppo, design, marketing e direzione operativa.</p>
      </div>
      <div class="agency-team__grid" data-reveal="up" data-reveal-stagger="1">
        {
          teamMembers.map((person, index) => (
            <article class="agency-person" data-person-id={person.id}>
              <img
                src={person.image}
                alt={person.imageAlt}
                width="900"
                height="1200"
                loading={index === 0 ? 'eager' : 'lazy'}
                decoding="async"
                fetchpriority={index === 0 ? 'high' : undefined}
                sizes="(max-width: 640px) 74vw, (max-width: 1024px) 31vw, 18vw"
                style={`object-position: ${person.imagePosition};`}
              />
              <div>
                <h3>{person.displayName}</h3>
                <p>{person.role}</p>
                <a
                  href={person.linkedin}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`Profilo LinkedIn di ${person.fullName}`}
                >
                  LinkedIn
                  <IconArrowRight stroke={1.7} aria-hidden="true" />
                </a>
              </div>
            </article>
          ))
        }
      </div>
    </Container>
  </Section>

  <Section labelledby="agency-clients-title" compact class="agency-clients">
    <Container wide>
      <ClientMarquee
        titleId="agency-clients-title"
        title="Clienti e progetti seguiti da Netmarket."
        text="Una selezione di marchi e realtà presenti nello storico lavori."
        clients={clientLogos}
        speed="calm"
      />
    </Container>
  </Section>

  <Section labelledby="agency-proof-title" class="agency-proof">
    <Container wide>
      <div class="agency-proof__grid">
        <div class="agency-proof__media" data-reveal="media">
          <div>
            <span>Brand</span>
            <span>Web</span>
            <span>SEO</span>
            <span>Social</span>
            <span>Software</span>
          </div>
          <strong>1 regia</strong>
          <p>meno dispersione tra messaggi, canali e strumenti</p>
        </div>
        <div class="agency-proof__copy" data-reveal="line">
          <IconRoute stroke={1.7} aria-hidden="true" />
          <h2 id="agency-proof-title">
            Il risultato migliore è un’azienda più semplice da <span class="nm-heading-marker"
              >capire.</span
            >
          </h2>
          <p>
            Per chi deve scegliere, acquistare, chiedere informazioni o lavorare con voi. La
            comunicazione funziona quando riduce ambiguità e rende visibile il valore.
          </p>
          <div>
            <a href="/servizi/">Servizi</a>
            <a href="/insight/">Insight</a>
            <a href="/contatti/">Contatti</a>
          </div>
        </div>
      </div>
    </Container>
  </Section>

  <Section compact labelledby="agency-cta-title" class="agency-cta-section">
    <Container wide>
      <div class="agency-cta" data-reveal="scale">
        <IconShieldCheck stroke={1.7} aria-hidden="true" />
        <h2 id="agency-cta-title">Hai un progetto da mettere in ordine?</h2>
        <p>
          Partiamo da obiettivi, vincoli e strumenti già attivi. Poi costruiamo una direzione
          chiara.
        </p>
        <a class="nm-button nm-button--primary" href="/contatti/">
          Parliamone
          <IconArrowRight stroke={1.7} aria-hidden="true" />
        </a>
      </div>
    </Container>
  </Section>
</BaseLayout>

---
import { breadcrumbJsonLd, webPageJsonLd } from '@netmarket/seo';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/layout/Container.astro';
import Section from '@/components/layout/Section.astro';
import Button from '@/components/ui/Button.astro';

const canonicalSiteUrl = 'https://netmarket.it';
const title = 'Grazie';
const description = 'Abbiamo ricevuto la tua richiesta. Ti ricontatteremo il prima possibile.';
const breadcrumb = breadcrumbJsonLd([
  { name: 'Home', url: `${canonicalSiteUrl}/` },
  { name: 'Grazie', url: `${canonicalSiteUrl}/grazie/` }
]);
const pageSchema = {
  ...webPageJsonLd({
    title,
    description,
    canonicalPath: '/grazie/',
    siteUrl: canonicalSiteUrl,
    robots: 'noindex, follow'
  }),
  '@type': 'WebPage'
};
---

<BaseLayout
  title={title}
  description={description}
  path="/grazie/"
  canonicalSiteUrl={canonicalSiteUrl}
  noindex
  noindexFollow
  structuredData={[breadcrumb, pageSchema]}
>
  <Section class="thank-you" labelledby="thank-you-title">
    <canvas class="thank-you__confetti" data-confetti-canvas aria-hidden="true"></canvas>
    <Container>
      <div class="thank-you__panel" data-reveal="scale">
        <p class="nm-meta">Richiesta ricevuta</p>
        <h1 id="thank-you-title">Grazie.</h1>
        <p class="thank-you__lead">
          Abbiamo ricevuto la tua richiesta. Ti ricontatteremo il prima possibile per capire meglio
          il progetto e valutare insieme il prossimo passo.
        </p>
        <div class="thank-you__actions">
          <Button href="/" magnetic>Torna alla home</Button>
          <Button href="/progetti/" variant="secondary">Guarda i progetti</Button>
        </div>
      </div>
    </Container>
  </Section>
</BaseLayout>

<script>
  const canvas = document.querySelector<HTMLCanvasElement>('[data-confetti-canvas]');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (canvas && !reduceMotion) {
    const confettiCanvas = canvas;
    const context = canvas.getContext('2d');
    const colors = ['#0E51FE', '#89A8FF', '#090A0F', '#DDE2EA', '#FFFFFF'];
    const pixelRatio = Math.min(window.devicePixelRatio || 1, 2);
    const isMobile = window.matchMedia('(max-width: 640px)').matches;
    const count = isMobile ? 34 : 58;
    const duration = 2200;
    const startedAt = performance.now();

    type ConfettiPiece = {
      x: number;
      y: number;
      size: number;
      speed: number;
      drift: number;
      rotation: number;
      rotationSpeed: number;
      color: string;
      alpha: number;
    };

    function resize() {
      confettiCanvas.width = Math.round(window.innerWidth * pixelRatio);
      confettiCanvas.height = Math.round(window.innerHeight * pixelRatio);
      confettiCanvas.style.width = `${window.innerWidth}px`;
      confettiCanvas.style.height = `${window.innerHeight}px`;
      context?.setTransform(pixelRatio, 0, 0, pixelRatio, 0, 0);
    }

    resize();

    const pieces: ConfettiPiece[] = Array.from({ length: count }, () => ({
      x: window.innerWidth * (0.18 + Math.random() * 0.64),
      y: window.innerHeight * 0.18 + Math.random() * 24,
      size: 5 + Math.random() * (isMobile ? 5 : 8),
      speed: 1.8 + Math.random() * 3.2,
      drift: -1.2 + Math.random() * 2.4,
      rotation: Math.random() * Math.PI,
      rotationSpeed: -0.08 + Math.random() * 0.16,
      color: colors[Math.floor(Math.random() * colors.length)] ?? '#0E51FE',
      alpha: 0.8 + Math.random() * 0.2
    }));

    function draw(now: number) {
      if (!context || !canvas) return;

      const elapsed = now - startedAt;
      const progress = Math.min(elapsed / duration, 1);
      context.clearRect(0, 0, window.innerWidth, window.innerHeight);

      for (const piece of pieces) {
        piece.y += piece.speed;
        piece.x += piece.drift;
        piece.rotation += piece.rotationSpeed;

        context.save();
        context.globalAlpha = piece.alpha * (1 - Math.max(0, progress - 0.62) / 0.38);
        context.translate(piece.x, piece.y);
        context.rotate(piece.rotation);
        context.fillStyle = piece.color;
        context.fillRect(-piece.size / 2, -piece.size / 2, piece.size, piece.size * 0.42);
        context.restore();
      }

      if (progress < 1) {
        requestAnimationFrame(draw);
      } else {
        context.clearRect(0, 0, window.innerWidth, window.innerHeight);
      }
    }

    const onResize = () => resize();
    window.addEventListener('resize', onResize, { passive: true });
    requestAnimationFrame(draw);
    window.setTimeout(() => window.removeEventListener('resize', onResize), duration + 500);
  }
</script>

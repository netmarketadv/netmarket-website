---
import {
  IconArrowRight,
  IconBolt,
  IconCalendarCheck,
  IconChartLine,
  IconMessageCircle,
  IconRobot,
  IconRoute,
  IconUsers
} from '@tabler/icons-astro';
import { absoluteCanonical, breadcrumbJsonLd } from '@netmarket/seo';
import NodProductDemo from '@/components/nod/NodProductDemo.astro';
import Button from '@/components/ui/Button.astro';
import Container from '@/components/layout/Container.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';

const canonicalSiteUrl = 'https://www.netmarket.it';
const nodLogo = '/nod-logo.svg';
const pageDescription =
  'NØD è il sistema operativo commerciale per PMI che collega lead, pipeline, task, calendario, automazioni, report e AI in un unico ambiente di lavoro.';
const pageUrl = absoluteCanonical(canonicalSiteUrl, '/nod/');
const breadcrumb = breadcrumbJsonLd([
  { name: 'Home', url: `${canonicalSiteUrl}/` },
  { name: 'NØD', url: pageUrl }
]);
const softwareSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  '@id': `${pageUrl}#software`,
  name: 'NØD',
  alternateName: 'NØD by Netmarket',
  description: pageDescription,
  applicationCategory: 'BusinessApplication',
  applicationSubCategory: 'CRM e sistema operativo commerciale per PMI',
  operatingSystem: 'Web',
  url: pageUrl,
  audience: {
    '@type': 'BusinessAudience',
    audienceType: 'Piccole e medie imprese e team commerciali'
  },
  featureList: [
    'Gestione lead e contatti',
    'Pipeline commerciale',
    'Calendario operativo e task',
    'AI assistant',
    'Automazioni e follow-up',
    'Report commerciali'
  ],
  provider: { '@id': `${canonicalSiteUrl}/#organization` }
};

const pillars = [
  [
    IconUsers,
    'Lead e contatti',
    'Ogni richiesta entra in una scheda condivisa, con fonte, storico, valore e prossima azione.'
  ],
  [
    IconRoute,
    'Pipeline commerciale',
    'Le opportunità avanzano in fasi leggibili. Il team sa cosa è fermo e cosa può essere chiuso.'
  ],
  [
    IconCalendarCheck,
    'Task e calendario',
    'Appuntamenti, scadenze e follow-up restano collegati alle persone e alle opportunità.'
  ],
  [
    IconRobot,
    'AI Assistant',
    'L’AI legge il contesto operativo e aiuta a scegliere priorità, messaggi e prossime azioni.'
  ],
  [
    IconBolt,
    'Automazioni',
    'I passaggi ripetitivi diventano regole semplici: meno memoria individuale, più continuità.'
  ],
  [
    IconChartLine,
    'Report',
    'Pipeline, fonti e risultati diventano segnali comprensibili, non tabelle da interpretare.'
  ]
] as const;
---

<BaseLayout
  title="NØD, sistema operativo commerciale per PMI"
  description={pageDescription}
  path="/nod/"
  canonicalSiteUrl={canonicalSiteUrl}
  structuredData={[breadcrumb, softwareSchema]}
  motionMode="light"
>
  <div class="nod-page">
    <section class="nod-hero" aria-labelledby="nod-title">
      <Container wide>
        <div class="nod-hero__copy" data-reveal="up">
          <div class="nod-wordmark" role="img" aria-label="NØD by Netmarket">
            <img src={nodLogo} alt="" width="32" height="33" decoding="async" />
            <span><strong>NØD</strong><small>by Netmarket</small></span>
          </div>
          <p class="nod-kicker">Il sistema operativo commerciale per PMI</p>
          <h1 id="nod-title">
            Marketing, vendite e AI.<br /><span class="nm-heading-marker nm-heading-marker--strong"
              >Un solo flusso.</span>
          </h1>
          <p class="nod-hero__lead">
            NØD raccoglie lead, attività e risultati in un ambiente unico. Il team vede cosa è
            successo, cosa fare adesso e dove si crea valore.
          </p>
          <div class="nod-hero__actions">
            <Button href="/contatti/" magnetic>Scopri NØD</Button>
            <a href="#come-funziona" class="nod-text-link"
              >Guarda come funziona <IconArrowRight stroke={1.8} /></a
            >
          </div>
        </div>
        <div class="nod-hero__product" data-reveal="media">
          <NodProductDemo
            variant="overview"
            label="Dashboard NØD con indicatori commerciali, andamento lead e priorità operative"
          />
        </div>
        <ul class="nod-hero__signals" aria-label="Principali vantaggi di NØD">
          <li>
            <strong>01</strong><span
              ><b>Una vista condivisa</b>Marketing e vendite lavorano sugli stessi dati.</span>
          </li>
          <li>
            <strong>02</strong><span
              ><b>Priorità operative</b>Ogni lead ha un prossimo passo chiaro.</span>
          </li>
          <li>
            <strong>03</strong><span
              ><b>AI dentro il processo</b>Suggerisce azioni usando il contesto reale.</span>
          </li>
        </ul>
      </Container>
    </section>

    <section class="nod-intro" aria-labelledby="nod-overview-title">
      <Container>
        <p class="nod-section-label">Il prodotto</p>
        <div class="nod-intro__grid">
          <h2 id="nod-overview-title">
            Non un altro strumento.<br />Il posto in cui il lavoro <span class="nm-heading-accent"
              >si collega.</span>
          </h2>
          <p>
            Quando lead, note, scadenze e numeri vivono in strumenti separati, il processo dipende
            dalla memoria delle persone. NØD riunisce il lavoro commerciale quotidiano e rende
            visibili responsabilità, tempi e risultati.
          </p>
        </div>
        <div class="nod-pillars" role="list">
          {
            pillars.map(([Icon, title, text]) => (
              <article role="listitem">
                <>
                  <Icon stroke={1.6} aria-hidden="true" />
                  <h3>{title}</h3>
                  <p>{text}</p>
                </>
              </article>
            ))
          }
        </div>
      </Container>
    </section>

    <section id="come-funziona" class="nod-feature-section" aria-labelledby="nod-leads-title">
      <Container wide>
        <div class="nod-feature nod-feature--copy-left">
          <div class="nod-feature__copy" data-reveal="up">
            <span class="nod-step">01 / Lead e contatti</span><h2 id="nod-leads-title">
              Ogni contatto entra già nel <span class="nm-heading-accent">processo.</span>
            </h2>
            <p>
              NØD raccoglie le richieste provenienti da sito, campagne, social e attività dirette.
              Fonte, storico, priorità e valore restano leggibili nella stessa vista.
            </p>
            <ul>
              <li>Nuovi lead immediatamente visibili</li><li>
                Schede condivise e storico completo
              </li><li>Filtri semplici per stato, fonte e priorità</li>
            </ul>
          </div>
          <div class="nod-feature__demo" data-reveal="media">
            <NodProductDemo
              variant="leads"
              label="Elenco NØD che mostra l'arrivo di un nuovo lead e il suo stato commerciale"
            />
          </div>
        </div>
      </Container>
    </section>

    <section
      class="nod-feature-section nod-feature-section--soft"
      aria-labelledby="nod-pipeline-title"
    >
      <Container wide>
        <div class="nod-feature nod-feature--copy-right">
          <div class="nod-feature__copy" data-reveal="up">
            <span class="nod-step">02 / Pipeline</span><h2 id="nod-pipeline-title">
              Dal primo contatto fino a <span class="nm-heading-marker">vinto.</span>
            </h2>
            <p>
              NØD mostra le opportunità in movimento e rende evidenti quelle ferme. Chi vende vede
              il prossimo passo; chi coordina vede il quadro complessivo.
            </p>
            <ul>
              <li>Fasi coerenti con il vostro metodo</li><li>
                Valore economico sempre aggiornato
              </li><li>Follow-up collegati a ogni opportunità</li>
            </ul>
          </div>
          <div class="nod-feature__demo" data-reveal="media">
            <NodProductDemo
              variant="pipeline"
              label="Pipeline NØD con un'opportunità che passa dalla proposta allo stato vinto"
            />
          </div>
        </div>
      </Container>
    </section>

    <section class="nod-feature-section" aria-labelledby="nod-calendar-title">
      <Container wide>
        <div class="nod-feature nod-feature--copy-left">
          <div class="nod-feature__copy" data-reveal="up">
            <span class="nod-step">03 / Operatività</span><h2 id="nod-calendar-title">
              Scadenze e appuntamenti non restano <span class="nm-heading-accent">in sospeso.</span>
            </h2>
            <p>
              Task, richiami e incontri sono parte del flusso commerciale, non promemoria isolati.
              Ognuno sa cosa deve fare, per quale cliente e quando.
            </p>
            <ul>
              <li>Calendario operativo condiviso</li><li>
                Task assegnati con contesto e scadenza
              </li><li>Attività collegate a lead e opportunità</li>
            </ul>
          </div>
          <div class="nod-feature__demo" data-reveal="media">
            <NodProductDemo
              variant="calendar"
              label="Calendario NØD con appuntamenti commerciali e un nuovo follow-up"
            />
          </div>
        </div>
      </Container>
    </section>

    <section class="nod-ai-section" aria-labelledby="nod-ai-title">
      <Container wide>
        <div class="nod-ai__intro">
          <div data-reveal="up">
            <span class="nod-step">04 / AI Assistant</span><h2 id="nod-ai-title">
              AI utile perché conosce il <span>lavoro reale.</span>
            </h2>
          </div>
          <p>
            NØD non parte da una chat vuota. Legge lead, attività e pipeline per evidenziare
            priorità, preparare follow-up e trasformare i dati in indicazioni operative.
          </p>
        </div>
        <div class="nod-ai__demo" data-reveal="media">
          <NodProductDemo
            variant="assistant"
            label="AI Assistant di NØD che analizza la pipeline e propone i lead da seguire"
          />
        </div>
        <div class="nod-ai__benefits">
          <p><b>Chiedi.</b><span>“Quali lead devo seguire prima?”</span></p><p>
            <b>Comprendi.</b><span>NØD motiva ogni priorità con dati reali.</span>
          </p><p><b>Agisci.</b><span>La risposta diventa subito task o messaggio.</span></p>
        </div>
      </Container>
    </section>

    <section class="nod-feature-section" aria-labelledby="nod-automation-title">
      <Container wide>
        <div class="nod-feature nod-feature--copy-right">
          <div class="nod-feature__copy" data-reveal="up">
            <span class="nod-step">05 / Automazioni</span><h2 id="nod-automation-title">
              La continuità non dipende dalla <span class="nm-heading-accent">memoria.</span>
            </h2>
            <p>
              Le automazioni trasformano gli eventi del processo in azioni semplici: qualificano una
              richiesta, creano un task, ricordano un appuntamento o attivano un follow-up.
            </p>
            <ul>
              <li>Regole comprensibili e controllabili</li><li>
                Task generati nel momento giusto
              </li><li>Meno passaggi manuali e meno occasioni perse</li>
            </ul>
          </div>
          <div class="nod-feature__demo" data-reveal="media">
            <NodProductDemo
              variant="automations"
              label="Automazioni NØD che collegano un nuovo lead alla qualifica AI e al follow-up"
            />
          </div>
        </div>
      </Container>
    </section>

    <section
      class="nod-feature-section nod-feature-section--soft"
      aria-labelledby="nod-reports-title"
    >
      <Container wide>
        <div class="nod-feature nod-feature--copy-left">
          <div class="nod-feature__copy" data-reveal="up">
            <span class="nod-step">06 / Report</span><h2 id="nod-reports-title">
              I numeri servono a decidere <span class="nm-heading-marker">cosa fare.</span>
            </h2>
            <p>
              Report e indicatori collegano acquisizione, attività commerciale e risultati. Le
              informazioni importanti emergono subito, senza fogli da ricomporre.
            </p>
            <ul>
              <li>Valore della pipeline e tasso di conversione</li><li>
                Fonti che generano opportunità migliori
              </li><li>Risultati visibili a chi guida l’azienda</li>
            </ul>
          </div>
          <div class="nod-feature__demo" data-reveal="media">
            <NodProductDemo
              variant="reports"
              label="Report NØD con valore vinto, conversione, andamento lead e fonti commerciali"
            />
          </div>
        </div>
      </Container>
    </section>

    <section class="nod-unified" aria-labelledby="nod-unified-title">
      <Container>
        <div class="nod-unified__card" data-reveal="scale">
          <p class="nod-section-label">La differenza</p>
          <h2 id="nod-unified-title">
            Un’unica visione, dal primo segnale al <span>risultato.</span>
          </h2>
          <p>
            NØD collega marketing, vendite e operatività senza costringere l’azienda a ricostruire
            il processo tra strumenti frammentati. È progettato intorno al modo in cui una PMI
            lavora davvero.
          </p>
          <div class="nod-unified__flow" aria-label="Flusso unificato di NØD">
            <span>Fonti</span><IconArrowRight /><span>Lead</span><IconArrowRight /><span
              >Pipeline</span
            ><IconArrowRight /><span>Attività</span><IconArrowRight /><span>Risultati</span>
          </div>
        </div>
      </Container>
    </section>

    <section class="nod-final-section" aria-labelledby="nod-cta-title">
      <Container>
        <div class="nod-final" data-reveal="scale">
          <div class="nod-wordmark nod-wordmark--inverse" role="img" aria-label="NØD by Netmarket">
            <img src={nodLogo} alt="" width="32" height="33" loading="lazy" decoding="async" />
            <span><strong>NØD</strong><small>by Netmarket</small></span>
          </div>
          <div>
            <p class="nod-section-label">Il prossimo passo</p><h2 id="nod-cta-title">
              Metti ordine nel processo commerciale.
            </h2><p>
              Partiamo da come arrivano i lead, da chi li segue e da quali passaggi oggi si
              disperdono.
            </p>
          </div>
          <Button href="/contatti/" variant="inverse" magnetic
            ><span>Parliamo di NØD</span><IconMessageCircle stroke={1.8} /></Button
          >
        </div>
      </Container>
    </section>
  </div>
</BaseLayout>

<style>
  .nod-page {
    --nod-soft: #f2f4f7;
    --nod-muted: #626b78;
    overflow: clip;
    background: #fff;
    color: var(--nm-color-ink);
  }
  .nod-hero {
    padding: clamp(7rem, 9vw, 9rem) 0 clamp(3.5rem, 6vw, 6rem);
  }
  .nod-hero__copy {
    display: grid;
    justify-items: center;
    max-width: 64rem;
    margin-inline: auto;
    text-align: center;
  }
  .nod-wordmark {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    margin-bottom: 1.15rem;
  }
  .nod-wordmark img {
    width: 2rem;
    height: 2.05rem;
    object-fit: contain;
  }
  .nod-wordmark span {
    display: flex;
    align-items: baseline;
    gap: 0.45rem;
    line-height: 1;
  }
  .nod-wordmark strong {
    font-size: 1.45rem;
    font-weight: 650;
  }
  .nod-wordmark small {
    color: var(--nod-muted);
    font-size: 0.72rem;
    font-weight: 550;
  }
  .nod-kicker,
  .nod-section-label,
  .nod-step {
    color: var(--nm-color-blue);
    font-size: var(--nm-text-label);
    font-weight: 650;
    text-transform: uppercase;
  }
  .nod-hero h1 {
    max-width: 16ch;
    margin-top: 0.8rem;
    font-size: clamp(3rem, 6.2vw, 6.25rem);
    line-height: 0.97;
    letter-spacing: 0;
    text-wrap: balance;
  }
  .nod-hero__lead {
    max-width: 47rem;
    margin-top: 1.45rem;
    color: var(--nod-muted);
    font-size: var(--nm-text-lead);
    line-height: 1.52;
  }
  .nod-hero__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 0.8rem;
    margin-top: 1.65rem;
  }
  .nod-text-link {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 3rem;
    color: var(--nm-color-ink);
    font-weight: 550;
    text-decoration: none;
  }
  .nod-text-link svg {
    width: 1.05rem;
    transition: transform var(--nm-motion-duration-fast) var(--nm-motion-ease-hover);
  }
  .nod-text-link:hover svg {
    transform: translateX(0.2rem);
  }
  .nod-hero__product {
    width: min(100%, 75rem);
    margin: clamp(2.75rem, 5vw, 4.75rem) auto 0;
  }
  .nod-hero__signals {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    width: min(100%, 75rem);
    margin: 1.25rem auto 0;
    padding: 0;
    list-style: none;
  }
  .nod-hero__signals li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.75rem;
    padding: 1rem clamp(0.8rem, 2vw, 1.5rem);
    border-left: 1px solid var(--nm-color-border);
  }
  .nod-hero__signals li:first-child {
    border-left: 0;
  }
  .nod-hero__signals strong {
    color: var(--nm-color-blue);
    font-size: 0.75rem;
  }
  .nod-hero__signals span {
    display: grid;
    color: var(--nod-muted);
    font-size: var(--nm-text-small);
    line-height: 1.45;
  }
  .nod-hero__signals b {
    color: var(--nm-color-ink);
  }
  .nod-intro,
  .nod-feature-section,
  .nod-ai-section,
  .nod-unified,
  .nod-final-section {
    padding-block: clamp(4rem, 8vw, 8rem);
  }
  .nod-intro {
    border-top: 1px solid var(--nm-color-border);
  }
  .nod-intro__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.18fr) minmax(18rem, 0.72fr);
    gap: clamp(2rem, 6vw, 6rem);
    align-items: end;
    margin-top: 1rem;
  }
  .nod-intro h2,
  .nod-feature h2,
  .nod-ai__intro h2,
  .nod-unified h2,
  .nod-final h2 {
    font-size: clamp(2.45rem, 4.6vw, 4.8rem);
    line-height: 0.99;
    letter-spacing: 0;
    text-wrap: balance;
  }
  .nod-intro__grid > p,
  .nod-feature__copy > p,
  .nod-ai__intro > p,
  .nod-unified__card > p,
  .nod-final > div > p:last-child {
    color: var(--nod-muted);
    font-size: var(--nm-text-lead);
    line-height: 1.55;
  }
  .nod-pillars {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    margin-top: clamp(2.5rem, 5vw, 5rem);
    border-top: 1px solid var(--nm-color-border);
  }
  .nod-pillars article {
    min-width: 0;
    padding: clamp(1.25rem, 2.5vw, 2rem);
    border-right: 1px solid var(--nm-color-border);
    border-bottom: 1px solid var(--nm-color-border);
  }
  .nod-pillars article:nth-child(3n) {
    border-right: 0;
  }
  .nod-pillars svg {
    width: 1.5rem;
    height: 1.5rem;
    color: var(--nm-color-blue);
  }
  .nod-pillars h3 {
    margin-top: 1.4rem;
    font-size: 1.25rem;
  }
  .nod-pillars p {
    margin-top: 0.55rem;
    color: var(--nod-muted);
    line-height: 1.52;
  }
  .nod-feature-section {
    border-top: 1px solid var(--nm-color-border);
  }
  .nod-feature-section--soft {
    background: var(--nod-soft);
  }
  .nod-feature {
    display: grid;
    grid-template-columns: minmax(18rem, 0.68fr) minmax(0, 1.32fr);
    gap: clamp(2.25rem, 5vw, 5rem);
    align-items: center;
  }
  .nod-feature--copy-right {
    grid-template-columns: minmax(0, 1.32fr) minmax(18rem, 0.68fr);
  }
  .nod-feature--copy-right .nod-feature__copy {
    grid-column: 2;
  }
  .nod-feature--copy-right .nod-feature__demo {
    grid-area: 1/1;
  }
  .nod-feature__copy {
    display: grid;
    align-content: center;
  }
  .nod-feature__copy h2 {
    margin-top: 1rem;
  }
  .nod-feature__copy > p {
    margin-top: 1.35rem;
  }
  .nod-feature__copy ul {
    display: grid;
    margin: 1.5rem 0 0;
    padding: 0;
    list-style: none;
  }
  .nod-feature__copy li {
    position: relative;
    padding: 0.75rem 0 0.75rem 1.35rem;
    border-top: 1px solid var(--nm-color-border);
    color: var(--nm-color-ink-2);
  }
  .nod-feature__copy li::before {
    content: '';
    position: absolute;
    top: 1.18rem;
    left: 0;
    width: 0.45rem;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--nm-color-blue);
  }
  .nod-feature__demo {
    min-width: 0;
  }
  .nod-ai-section {
    background: var(--nm-color-inverse);
    color: #fff;
  }
  .nod-ai__intro {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(18rem, 0.65fr);
    gap: clamp(2rem, 6vw, 6rem);
    align-items: end;
  }
  .nod-ai__intro h2 {
    max-width: 12ch;
    margin-top: 1rem;
    color: #fff;
  }
  .nod-ai__intro h2 span {
    color: #86a8ff;
  }
  .nod-ai__intro > p {
    color: #b8c0d0;
  }
  .nod-ai__demo {
    width: min(100%, 68rem);
    margin: clamp(2.5rem, 5vw, 4.5rem) auto 0;
  }
  .nod-ai__benefits {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    width: min(100%, 68rem);
    margin: 1.25rem auto 0;
    border-top: 1px solid rgb(255 255 255/0.18);
  }
  .nod-ai__benefits p {
    display: grid;
    gap: 0.35rem;
    padding: 1rem 1.5rem;
    border-left: 1px solid rgb(255 255 255/0.18);
  }
  .nod-ai__benefits p:first-child {
    border-left: 0;
  }
  .nod-ai__benefits b {
    color: #fff;
  }
  .nod-ai__benefits span {
    color: #aeb7ca;
    font-size: var(--nm-text-small);
  }
  .nod-unified {
    background: #fff;
  }
  .nod-unified__card {
    display: grid;
    justify-items: center;
    border-radius: var(--nm-radius-xl);
    padding: clamp(2rem, 6vw, 5rem);
    background: var(--nm-color-blue);
    color: #fff;
    text-align: center;
  }
  .nod-unified .nod-section-label {
    color: #dbe5ff;
  }
  .nod-unified h2 {
    max-width: 15ch;
    margin-top: 1rem;
    color: #fff;

---
import ClientMarquee from '@/components/blocks/ClientMarquee.astro';
import FAQBlock from '@/components/blocks/FAQBlock.astro';
import ReviewsSection from '@/components/blocks/ReviewsSection.astro';
import TeamSection from '@/components/blocks/TeamSection.astro';
import Container from '@/components/layout/Container.astro';
import Section from '@/components/layout/Section.astro';
import Stack from '@/components/layout/Stack.astro';
import Button from '@/components/ui/Button.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { clientLogos, cmsMedia, googleTrust, questions, workSteps } from '@/data/home';
import { teamMembers } from '@/data/team';
import {
  getProjectArchiveData,
  projectCategory,
  projectClient,
  projectDescription,
  projectPath
} from '@/lib/projects/content';
import { getServiceArchiveData, servicePath } from '@/lib/services/content';
import { personJsonLd } from '@netmarket/seo';
import type { Service } from '@netmarket/schemas';

const canonicalSiteUrl = 'https://www.netmarket.it';
const { services } = await getServiceArchiveData();
const { projects } = await getProjectArchiveData();

const serviceBySlug = new Map(services.map((service) => [service.slug, service]));
const serviceLink = (slug: string) => serviceBySlug.get(slug);
const isService = (service: Service | undefined): service is Service => Boolean(service);
const visibleProjects = projects
  .filter((project) => project.projectStatus === 'published' && project.cover)
  .slice(0, 8);
const featuredProject = visibleProjects[0];

const serviceGroups = [
  {
    title: 'Web & ecommerce',
    text: 'Siti web, ecommerce e percorsi digitali progettati per essere chiari, veloci e misurabili.',
    image: cmsMedia.services.websites,
    imageAlt: 'Visual siti web Netmarket',
    slugs: ['siti-web', 'ecommerce', 'seo']
  },
  {
    title: 'Marketing',
    text: 'SEO, advertising, social ed email lavorano dentro un piano coordinato, non come attività isolate.',
    image: cmsMedia.services.marketing,
    imageAlt: 'Visual marketing digitale Netmarket',
    slugs: ['seo', 'advertising', 'social-media']
  },
  {
    title: 'Comunicazione & contenuti',
    text: 'Branding, copy, fotografia, video e materiali commerciali rendono riconoscibile il valore dell’azienda.',
    image: cmsMedia.services.branding,
    imageAlt: 'Visual branding e comunicazione Netmarket',
    slugs: ['branding-e-comunicazione', 'content-production', 'concorsi-a-premi']
  },
  {
    title: 'Tecnologia & integrazioni',
    text: 'Software, automazioni e sistemi collegati riducono lavoro manuale e dispersione tra strumenti.',
    image: cmsMedia.services.ecommerce,
    imageAlt: 'Visual ecommerce e integrazioni Netmarket',
    slugs: ['software-e-integrazioni', 'ecommerce', 'siti-web']
  }
].map((group) => ({
  ...group,
  links: group.slugs.map(serviceLink).filter(isService)
}));

const heroPrimaryImage = {
  url: cmsMedia.hero.phone,
  alt: 'iPhone con contenuto social media realizzato da Netmarket'
};
const heroSecondaryImage = {
  url: cmsMedia.hero.productPhotography,
  alt: 'Scatto di product photography realizzato da Netmarket'
};
const heroTertiaryImage = {
  url: cmsMedia.hero.ecommerce,
  alt: 'Visual sviluppo ecommerce Netmarket'
};
const heroSocialPostImage = {
  url: cmsMedia.hero.socialPost,
  alt: 'Anteprima profilo Instagram gestito da Netmarket'
};

const teamJsonLd = teamMembers.map((person) =>
  personJsonLd(canonicalSiteUrl, {
    id: person.id,
    name: person.fullName,
    givenName: person.givenName,
    familyName: person.familyName,
    jobTitle: person.role,
    sameAs: [person.linkedin],
    image: person.image
  })
);
---

<BaseLayout
  title="Agenzia comunicazione, marketing e tecnologia a Padova"
  description="Netmarket è un'agenzia di comunicazione, marketing e siti web a Padova attiva dal 1986: strategia, branding, ecommerce, SEO, advertising, social e software per aziende."
  path="/"
  canonicalSiteUrl={canonicalSiteUrl}
  structuredData={teamJsonLd}
>
  <section class="home-hero home-hero--editorial" aria-labelledby="page-title">
    <Container wide>
      <div class="home-hero__grid">
        <div class="home-hero__copy">
          <p class="home-hero__eyebrow" data-reveal="down">Netmarket, Padova dal 1986</p>
          <h1 id="page-title" data-reveal="line">
            Agenzia marketing e siti web a <span class="nm-heading-marker">Padova.</span>
          </h1>
          <p class="home-hero__lead" data-reveal="up">
            Dal 1986 aiutiamo aziende e PMI a chiarire il messaggio, costruire presenza digitale e far lavorare insieme brand, contenuti, campagne e tecnologia.
          </p>
          <div class="home-hero__actions" aria-label="Azioni principali" data-reveal="up" data-reveal-delay="1">
            <Button href="/contatti/" magnetic>Raccontaci il progetto</Button>
            <Button href="/progetti/" variant="secondary">Guarda i progetti</Button>
          </div>
        </div>

        <div class="home-hero__visual" aria-label="Sistema Netmarket">
          <div class="home-hero__orbit" aria-hidden="true"></div>
          <figure class="home-hero__device" data-reveal="media">
            <img
              src={heroPrimaryImage.url}
              alt={heroPrimaryImage.alt || 'Visual siti web Netmarket'}
              loading="eager"
              decoding="async"
              fetchpriority="high"
            />
          </figure>
          <figure class="home-hero__tile home-hero__tile--marketing" data-reveal="scale" data-reveal-delay="1">
            <img src={heroSecondaryImage.url} alt={heroSecondaryImage.alt || 'Visual marketing Netmarket'} loading="eager" decoding="async" />
            <figcaption>Product</figcaption>
          </figure>
          <figure class="home-hero__tile home-hero__tile--ecommerce" data-reveal="scale" data-reveal-delay="2">
            <img src={heroTertiaryImage.url} alt={heroTertiaryImage.alt || 'Visual ecommerce Netmarket'} loading="eager" decoding="async" />
            <figcaption>Ecommerce</figcaption>
          </figure>
          <figure class="home-hero__tile home-hero__tile--social" data-reveal="scale" data-reveal-delay="3">
            <img src={heroSocialPostImage.url} alt={heroSocialPostImage.alt} loading="eager" decoding="async" />
          </figure>
          <div class="home-hero__rating" data-reveal="up" data-reveal-delay="3" aria-label={`${googleTrust.rating} stelle su Google`}>
            <span aria-hidden="true">★★★★★</span>
            <strong>{googleTrust.rating}</strong>
            <small>{googleTrust.reviewCount} recensioni Google</small>
          </div>
          <div class="home-hero__mini-card" data-reveal="up" data-reveal-delay="4">
            <span>Vendite</span>
            <strong>+292%</strong>
          </div>
        </div>
      </div>

    </Container>
  </section>

  <Section compact class="home-client-proof" labelledby="client-title">
    <ClientMarquee
      titleId="client-title"
      title="Clienti e progetti seguiti da Netmarket."
      text="Una selezione di marchi e realtà presenti nello storico lavori."
      clients={clientLogos}
      speed="calm"
    />
  </Section>

  <Section class="home-system-section" labelledby="system-title">
    <Container wide>
      <div class="home-system">
        <div class="home-system__intro" data-reveal="line">
          <p class="nm-meta">Cosa facciamo</p>
          <h2 id="system-title">Servizi integrati, non attività scollegate.</h2>
          <p>
            Un sito più chiaro aiuta le campagne. Le campagne indicano quali contenuti servono.
            I dati guidano le scelte successive.
          </p>
          <a href="/servizi/">Vedi tutti i servizi</a>
        </div>
        <div class="home-system__list" data-reveal="up" data-reveal-stagger="1">
          {
            serviceGroups.map((group, index) => (
              <article>
                <span>{String(index + 1).padStart(2, '0')}</span>
                <figure>
                  <img src={group.image} alt={group.imageAlt} loading="lazy" decoding="async" />
                </figure>
                <div>
                  <h3>{group.title}</h3>
                  <p>{group.text}</p>
                  <div class="home-system__links">
                    {group.links.map((service) => (
                      <a href={servicePath(service.slug)}>{service.title}</a>
                    ))}
                  </div>
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </Container>
  </Section>

  {
    featuredProject && (
      <Section class="home-work-section" labelledby="work-title">
        <Container wide>
          <Stack gap="var(--nm-space-xl)">
            <div class="home-section-heading" data-reveal="line">
              <p class="nm-meta">Progetti</p>
              <h2 id="work-title">Case study e progetti reali.</h2>
              <p>
                Alcuni lavori pubblicati nel nuovo archivio: siti web, ecommerce, software, campagne e comunicazione.
              </p>
            </div>
            <div class="home-case-slider" aria-label="Slider case study Netmarket" data-reveal="up">
              <div class="home-case-slider__track">
                {[...visibleProjects, ...visibleProjects].map((project, index) => (
                  <a
                    class:list={[
                      'home-case-card',
                      index % 5 === 0 && 'home-case-card--info',
                      index % 5 === 1 && 'home-case-card--portrait',
                      index % 5 === 2 && 'home-case-card--wide'
                    ]}
                    href={projectPath(project.slug)}
                    data-cursor-label="Guarda"
                  >
                    <div class="home-case-card__media">
                      <img
                        src={project.cover!.url}
                        alt={project.cover!.alt || project.title}
                        loading={index < 3 ? 'eager' : 'lazy'}
                        decoding="async"
                      />
                      <span>{projectCategory(project)}</span>
                    </div>
                    <div class="home-case-card__body">
                      <h3>{projectClient(project)}</h3>
                      <p>{projectDescription(project)}</p>
                    </div>
                  </a>
                ))}
              </div>
            </div>
            <div class="home-work-section__actions">
              <Button href="/progetti/" variant="secondary">Tutti i casi studio</Button>
            </div>
          </Stack>
        </Container>
      </Section>
    )
  }

  <Section class="home-method-section" labelledby="method-title">
    <Container wide>
      <div class="home-method">
        <div class="home-method__heading" data-reveal="line">
          <p class="nm-meta">Metodo</p>
          <h2 id="method-title">Metodo chiaro. Lavoro coordinato.</h2>
          <p>
            Il metodo Netmarket nasce per trasformare richieste sparse in priorità chiare, responsabilità definite e attività coordinate.
          </p>
        </div>
        <div class="home-method__steps" data-reveal="up" data-reveal-stagger="1">
          {
            workSteps.map(([title, text], index) => (
              <article>
                <span>{String(index + 1).padStart(2, '0')}</span>
                <h3>{title}</h3>
                <p>{text}</p>
              </article>
            ))
          }
        </div>
      </div>
    </Container>
  </Section>

  <Section id="team" class="home-team-section" labelledby="team-title">
    <Container wide>
      <TeamSection
        titleId="team-title"
        title="Competenze diverse. Una sola direzione."
        text="Sviluppo, design, marketing e direzione lavorano dentro lo stesso processo, con responsabilità chiare."
        people={teamMembers}
      />
    </Container>
  </Section>

  <Section class="home-reviews-section" labelledby="reviews-title">
    <Container>
      <ReviewsSection
        titleId="reviews-title"
        title="Cosa resta dopo il progetto."
        text="Recensioni pubbliche dal profilo Google verificato di Netmarket SRL."
        rating={googleTrust.rating}
        reviewCount={googleTrust.reviewCount}
        googleHref={googleTrust.profileHref}
      />
    </Container>
  </Section>

  <Section class="faq-section home-faq-section" labelledby="faq-title">
    <Container>
      <FAQBlock
        titleId="faq-title"
        title="FAQ essenziali."
        text="Le prime risposte per capire se il percorso è quello giusto."
        items={questions}
      />
    </Container>
  </Section>

  <Section class="home-final-cta" labelledby="contact-title">
    <Container>
      <div class="home-final-cta__inner" data-reveal="scale">
        <p class="nm-meta">Prossimo passo</p>
        <h2 id="contact-title">Mettiamo in ordine ciò che deve comunicare valore.</h2>
        <p>
          Raccontaci obiettivi, strumenti attivi e priorità. Ti rispondiamo con il modo più sensato
          per procedere.
        </p>
        <Button href="/contatti/" variant="inverse" magnetic>Raccontaci il progetto</Button>
      </div>
    </Container>
  </Section>
</BaseLayout>

---
import {
  IconArrowUpRight,
  IconArrowRight,
  IconArrowLeft,
  IconCheck,
  IconStarFilled,
  IconBrandMeta,
  IconTargetArrow,
  IconChartBar,
  IconBrush,
  IconDeviceDesktop,
  IconSearch,
  IconPlus
} from '@tabler/icons-astro';
import { serviceJsonLd } from '@netmarket/seo';
import { getPublicEnv } from '@/lib/env';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/layout/Container.astro';
import Section from '@/components/layout/Section.astro';
import SectionHeading from '@/components/content/SectionHeading.astro';
import ProjectCard from '@/components/content/ProjectCard.astro';
import Button from '@/components/ui/Button.astro';
import IconButton from '@/components/ui/IconButton.astro';
import FAQBlock from '@/components/blocks/FAQBlock.astro';
import ClientMarquee from '@/components/blocks/ClientMarquee.astro';
import ReviewsSection from '@/components/blocks/ReviewsSection.astro';
import TeamSection from '@/components/blocks/TeamSection.astro';
import StickyContactCTA from '@/components/landing/StickyContactCTA.astro';
import ContactForm from '@/components/forms/ContactForm.astro';
import { advertisingShell, advertisingSteps, advertisingPricing } from '@/data/advertising-landing';
import { advertisingGoals, advertisingFaq, advertisingCases } from '@/data/advertising-landing';
import '@/styles/advertising-consolidated.css';
import { clientLogos, googleTrust, cmsMedia } from '@/data/home';
import { googleReviews } from '@/data/reviews';
import { teamMembers } from '@/data/team';
import '@/styles/advertising.css';

const siteUrl = getPublicEnv().PUBLIC_SITE_URL;
const description =
  'Google Ads e Meta Ads da 400 € al mese per canale, IVA e budget Ads esclusi. Quattro casi reali, un team Google Partner. Primo confronto gratuito.';
const structuredData = [
  serviceJsonLd(
    siteUrl,
    'Google Ads e Meta Ads',
    description,
    new URL('/advertising/', siteUrl).href,
    'Advertising e performance marketing',
    [
      { '@type': 'City', name: 'Padova' },
      { '@type': 'Country', name: 'Italia' }
    ]
  ),
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    '@id': new URL('/advertising/#domande', siteUrl).href,
    inLanguage: 'it-IT',
    mainEntity: advertisingFaq.map(([question, answer]) => ({
      '@type': 'Question',
      name: question,
      acceptedAnswer: { '@type': 'Answer', text: answer }
    }))
  }
];

const formatNumber = (value: number, decimals = 0) =>
  new Intl.NumberFormat('it-IT', {
    useGrouping: true,
    minimumFractionDigits: decimals,
    maximumFractionDigits: decimals
  }).format(value);
const euro = (value: number, decimals = 0) => `${formatNumber(value, decimals)} €`;
const landingClients = clientLogos.map((client) =>
  client.name === 'Albertini Allestimenti' ? { ...client, visualScale: 0.58 } : client
);
const landingReviews = googleReviews.filter(
  (review) => review.author.toLowerCase() !== 'paola malighetti'
);
const googleLogo = '/media/advertising/google-g.webp';
const media = '/media/advertising/';
const people = [
  'giacomo-galanti',
  'greta-negro',
  'enrico-paolo-toso',
  'mattia-graziotti',
  'marco-toso'
].flatMap((id) => {
  const person = teamMembers.find((p) => p.id === id);
  return person
    ? [
        {
          ...person,
          image:
            id === 'giacomo-galanti'
              ? 'https://cms.netmarket.it/wp-content/uploads/2026/10/giacomo-galanti-netmarket.jpg'
              : `${media}${id.split('-')[0]}.webp`,
          role: id === 'giacomo-galanti' ? 'Digital Advertising Specialist' : person.role
        }
      ]
    : [];
});
---

<BaseLayout
  title="Google Ads e Meta Ads per acquisire clienti"
  description={description}
  path="/advertising/"
  structuredData={structuredData}
  socialImage={{
    id: 0,
    url: '/media/advertising/brb-store.webp',
    alt: 'Ecommerce BRB progettato da Netmarket',
    width: 1024,
    height: 896
  }}
  landing={advertisingShell}
>
  <div class="adv-page adv-page--consolidated" id="inizio">
    <section class="adv-hero" aria-labelledby="advertising-title">
      <Container wide>
        <div class="adv-hero__grid">
          <div class="adv-hero__copy">
            <p class="nm-eyebrow" data-reveal="down">Google Ads · Meta Ads · Google Partner</p>
            <h1 id="advertising-title" data-reveal="line">
              Google Ads e Meta Ads. <span class="nm-heading-accent"
                >Più contatti e più vendite.</span
              >
            </h1>
            <p class="adv-lead" data-reveal="up">
              Portiamo la tua offerta davanti alle persone giuste. Gestiamo <strong
                >Google Ads e Meta Ads</strong
              > per trasformare ricerche e interesse in richieste commerciali e acquisti.
            </p>
            <div class="adv-hero__actions" data-reveal="up">
              <Button id="hero-contact" href="#consulenza" variant="brand" size="large" magnetic
                >Richiedi confronto gratuito<IconArrowUpRight aria-hidden="true" /></Button
              >
            </div>
            <p class="adv-hero__price">
              Gestione da <strong>400 €/mese per canale.</strong><br /><span
                >+ IVA · Budget pubblicitario escluso.</span
              >
            </p>
            <a class="adv-hero__trust" href="#recensioni">
              <span class="adv-avatar-stack" aria-hidden="true"
                >{
                  landingReviews.slice(0, 3).map((r) => (
                    <span>
                      <img
                        src={r.avatarUrl}
                        alt=""
                        width="42"
                        height="42"
                        referrerpolicy="no-referrer"
                        loading="lazy"
                      />
                    </span>
                  ))
                }</span
              >
              <span
                ><span class="adv-stars" aria-label={`${googleTrust.rating} su 5 su Google`}
                  >{
                    Array.from({ length: 5 }).map(() => (
                      <IconStarFilled aria-hidden="true" size={13} />
                    ))
                  }<strong>{googleTrust.rating}</strong></span
                ><span class="adv-trust-caption"
                  >{googleTrust.reviewCount} recensioni su Google</span
                ></span
              >
            </a>
          </div>
          <div class="adv-hero__composition" data-reveal="media">
            <div class="adv-hero__photo">
              <img
                src={`${media}brb-social.webp`}
                alt="Creatività e contenuti social realizzati per BRB"
                width="856"
                height="1100"
                loading="eager"
                fetchpriority="high"
              />
            </div>
            <figure class="adv-hero__store">
              <img
                src={`${media}brb-store.webp`}
                alt="Ecommerce BRB progettato da Netmarket"
                width="1024"
                height="896"
                loading="eager"
              /><figcaption>
                Dal messaggio all’acquisto.<IconArrowUpRight aria-hidden="true" />
              </figcaption>
            </figure>
            <a class="adv-hero__result" href="#costi">
              <span>Gestione Google Ads o Meta Ads</span>
              <strong>da 400 €</strong>
              <span>/ mese per canale + IVA</span>
              <span>Budget pubblicitario escluso</span>
            </a>
            <span class="adv-hero__signature">Creatività ed ecommerce: progetto BRB.</span>
          </div>
        </div>
      </Container>
    </section>

    <section class="adv-partner" aria-label="Google Partner e competenze Netmarket">
      <Container wide>
        <div class="adv-partner__inner">
          <a
            href="https://www.google.com/partners/agency?id=9657120194"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Verifica Netmarket nel programma Google Partners (nuova scheda)"
          >
            <img
              src={cmsMedia.badges.googlePartner}
              alt="Google Partner"
              width="304"
              height="291"
              loading="lazy"
              decoding="async"
            />
          </a>
          <div>
            <strong>Netmarket è Google Partner.</strong><p>
              Dal 1986, marketing e comunicazione per le imprese.
            </p>
          </div>
        </div>
      </Container>
    </section>

    <Section id="progetti" labelledby="proof-title" class="adv-projects">
      <Container wide>
        <div class="adv-heading-controls">
          <SectionHeading
            id="proof-title"
            reveal
            eyebrow="Quattro casi di acquisizione contatti"
            title="Dalle richieste ai clienti. I risultati delle campagne."
          />
          <div class="adv-slider-controls" role="group" aria-label="Navigazione progetti">
            <IconButton label="Progetto precedente" data-project-prev
              ><IconArrowLeft aria-hidden="true" /></IconButton
            >
            <IconButton label="Progetto successivo" data-project-next
              ><IconArrowRight aria-hidden="true" /></IconButton
            >
          </div>
        </div>
        <div
          class="adv-project-rail"
          data-project-rail
          tabindex="0"
          aria-label="Progetti Netmarket, scorri per esplorare"
        >
          {
            advertisingCases.map((project) => (
              <article class="adv-project-slide">
                <ProjectCard
                  title={project.title}
                  category={`${project.period} · ${euro(project.investment)} di spesa Ads`}
                  description="Esplora il caso e i calcoli."
                  href={`#caso-${project.id}`}
                >
                  <div slot="media" class="project-card__evidence">
                    <span>
                      {project.id === 'pilates'
                        ? 'Nuovi iscritti'
                        : 'Fatturato attribuito · IVA esclusa'}
                    </span>
                    <strong
                      data-motion-count={
                        project.id === 'pilates'
                          ? formatNumber(project.customers)
                          : euro(project.value)
                      }
                    >
                      {project.id === 'pilates'
                        ? formatNumber(project.customers)
                        : euro(project.value)}
                    </strong>
                    <div>
                      <>
                        <b>
                          {project.id === 'pilates'
                            ? euro(project.investment / project.customers, 2)
                            : `${formatNumber(project.value / project.investment, 2)}×`}
                        </b>
                        <span>{project.id === 'pilates' ? 'Costo Ads per iscritto' : 'ROAS'}</span>
                      </>
                    </div>
                  </div>
                </ProjectCard>
                <dl class="adv-project-summary adv-project-summary--results">
                  <div>
                    <>
                      <dt>Contatti generati</dt>
                      <dd>{formatNumber(project.leads)}</dd>
                    </>
                  </div>
                  <div>
                    <>
                      <dt>
                        {project.id === 'pilates' ? 'CLV totale stimato' : project.customerLabel}
                      </dt>
                      <dd>
                        {project.id === 'pilates'
                          ? euro(project.value)
                          : formatNumber(project.customers)}
                      </dd>
                    </>
                  </div>
                </dl>
              </article>
            ))
          }
        </div>
        <div class="adv-case-details">
          {
            advertisingCases.map((project) => (
              <details id={`caso-${project.id}`} class="adv-case-detail">
                <summary>
                  <>
                    <span>
                      {project.title} / {project.outcome}
                    </span>
                    <IconPlus aria-hidden="true" />
                  </>
                </summary>
                <div class="adv-case-detail__body">
                  <div>
                    <>
                      <p>{project.context}</p>
                      <dl class="adv-case-calculations">
                        <div>
                          <>
                            <dt>Costo per contatto</dt>
                            <dd>{euro(project.investment / project.leads, 2)}</dd>
                          </>
                        </div>
                        <div>
                          <>
                            <dt>Costo Ads per acquisizione</dt>
                            <dd>{euro(project.investment / project.customers, 2)}</dd>
                          </>
                        </div>
                        <div>
                          <>
                            <dt>Da contatto ad acquisizione</dt>
                            <dd>{formatNumber((project.customers / project.leads) * 100, 2)}%</dd>
                          </>
                        </div>
                      </dl>
                    </>
                  </div>
                  <div>
                    <p>{project.note}</p>
                    {project.id === 'pilates' && (
                      <p>
                        CLV stimato / spesa Ads:{' '}
                        {formatNumber(project.value / project.investment, 2)}×. Non è ROAS.
                      </p>
                    )}
                  </div>
                </div>
              </details>
            ))
          }
        </div>
        <p class="adv-results-note">
          Dati forniti da Netmarket. ROAS = fatturato attribuito / sola spesa Ads, compenso di
          gestione escluso: non misura l’utile. Pilates: CLV stimato, non fatturato. Risultati
          storici, non garantiti.
        </p>
      </Container>
    </Section>

    <section class="adv-clients" aria-labelledby="clients-title">
      <Container wide
        ><ClientMarquee
          titleId="clients-title"
          title="In buona compagnia."
          text="Alcuni dei brand con cui abbiamo lavorato, tra marketing, comunicazione e tecnologia."
          clients={landingClients}
        /></Container
      >
    </section>

    <Section id="obiettivi" labelledby="goals-title">
      <Container wide>
        <div class="adv-opening">
          <SectionHeading
            id="goals-title"
            eyebrow="Cosa vuoi far crescere?"
            reveal
            title="Quale risultato cerchi?"
          />
        </div>
        <div class="adv-capabilities">
          <article class="adv-capability adv-capability--feature" data-reveal="up">
            <img
              src={`${media}product-photography-netmarket.webp`}
              alt="Fotografia di prodotto realizzata da Netmarket"
              width="1254"
              height="1254"
              loading="lazy"
            />
            <div>
              <IconBrush aria-hidden="true" stroke={1.7} /><h3>
                Creatività che parla del tuo valore.
              </h3><p>
                Foto, messaggi e pagine coerenti con la tua offerta. Produzione e sviluppo sono
                definiti in proposta.
              </p>
            </div>
          </article>
          <article class="adv-capability adv-capability--channels" data-reveal="up">
            <div class="adv-channel-logos" aria-label="Google e Meta">
              <img
                class="adv-google-logo"
                src={googleLogo}
                alt="Google"
                width="40"
                height="40"
              /><IconBrandMeta aria-hidden="true" stroke={1.8} />
            </div><h3>I canali giusti.<br />Per le persone giuste.</h3><p>
              Google intercetta ricerche. Meta raggiunge pubblici scelti in base alla tua offerta.
            </p><span>Google Ads · Meta Ads</span>
          </article>
          <article class="adv-capability adv-capability--measurement" data-reveal="up">
            <IconChartBar aria-hidden="true" stroke={1.7} /><h3>
              Numeri che aiutano a decidere.
            </h3><p>Contatti pertinenti e valore degli acquisti, oltre ai clic.</p><div
              class="adv-measure-tags"
            >
              <span>Contatti</span><span>Vendite</span><span>Margini</span>
            </div>
          </article>
        </div>
        <div class="adv-goals">
          {
            advertisingGoals.map((goal, index) => (
              <article class="adv-goal" data-reveal="up">
                <>
                  <span class="adv-goal__index">
                    0{index + 1} / {goal.label}
                  </span>
                  <h3>{goal.title}</h3>
                  <p>{goal.text}</p>
                  <Button
                    href="#consulenza"
                    variant="secondary"
                    data-advertising-objective={goal.value}
                  >
                    {goal.action}
                    <IconArrowUpRight aria-hidden="true" />
                  </Button>
                </>
              </article>
            ))
          }
        </div>
      </Container>
    </Section>

    <Section id="metodo" labelledby="method-title" class="adv-method">
      <Container wide>
        <SectionHeading
          id="method-title"
          tone="inverse"
          reveal
          eyebrow="Prima delle campagne, le scelte."
          title="Ogni clic ha un costo. Ogni scelta deve avere un senso."
          text="Mettiamo a fuoco cosa deve succedere, prepariamo il percorso e miglioriamo quello che i dati ci insegnano."
        />
        <div class="adv-standards">
          {
            (
              [
                [IconTargetArrow, 'Obiettivi condivisi'],
                [IconBrush, 'Creatività coerente'],
                [IconDeviceDesktop, 'Landing dedicate'],
                [IconChartBar, 'Misurazione'],
                [IconSearch, 'Test e ottimizzazione']
              ] as const
            ).map(([Icon, label]) => (
              <span>
                {typeof Icon !== 'string' && <Icon aria-hidden="true" stroke={1.7} />}
                {typeof label === 'string' && label}
              </span>
            ))
          }
        </div>
        <ol class="adv-steps">
          {
            advertisingSteps.map(([title, text, output], index) => (
              <li data-reveal="up">
                <>
                  <span class="adv-step-number">0{index + 1}</span>
                  <h3>{title}</h3>
                  <p>{text}</p>
                  <span class="adv-step-output">
                    <IconCheck aria-hidden="true" size={16} />
                    {output}
                  </span>
                </>
              </li>
            ))
          }
        </ol>
        <div class="adv-method__close">
          <p>
            Hai già campagne attive?<br /><strong>Partiamo da quello che stanno producendo.</strong>
          </p><Button href="#consulenza" variant="inverse" size="large"
            >Parliamo delle tue campagne<IconArrowUpRight aria-hidden="true" /></Button
          >
        </div>
      </Container>
    </Section>

    <Section id="costi" labelledby="pricing-title" class="adv-pricing">
      <Container wide>
        <SectionHeading
          id="pricing-title"
          eyebrow="Il prezzo è chiaro. Anche il punto di partenza."
          reveal
          title="Investi per crescere. Sapendo quanto spendi."
          text="Google, Meta o un piano coordinato. Partiamo dal canale che serve al tuo business, con gestione e budget pubblicitario sempre distinti."
        />
        <div class="adv-pricing__grid">
          {
            advertisingPricing.map((plan, index) => (
              <article class="adv-price" data-reveal="up">
                <div class="adv-price__channel">
                  {index === 0 ? (
                    <img src={googleLogo} alt="" width="40" height="40" />
                  ) : (
                    <IconBrandMeta aria-hidden="true" size={44} stroke={1.8} />
                  )}
                  <div>
                    <>
                      <strong>{plan.channel}</strong>
                      <span>{plan.platforms}</span>
                    </>
                  </div>
                </div>
                <h3>{plan.title}</h3>
                <p>{plan.text}</p>
                <p class="adv-price__amount">
                  <>
                    <span>da</span>
                    <strong>{euro(plan.monthlyFrom)}</strong>
                    <span>/ mese + IVA</span>
                  </>
                </p>
                <p class="adv-price__budget">Per singolo canale · Budget pubblicitario escluso</p>
                <ul>
                  {plan.includes.map((item) => (
                    <li>
                      <IconCheck aria-hidden="true" size={18} />
                      {item}
                    </li>
                  ))}
                </ul>
                <Button
                  href="#consulenza"
                  variant="brand"
                  size="large"
                  data-advertising-channel={plan.channel}
                >
                  Parliamo di {plan.channel}
                  <IconArrowUpRight aria-hidden="true" />
                </Button>
              </article>
            ))
          }
        </div>
        <div class="adv-pricing__terms">
          <p>
            <strong>Il budget da investire su Google e Meta è escluso.</strong> Le tariffe sono di partenza,
            per singolo canale. Compenso finale, configurazione iniziale, produzione creativa, landing,
            feed e integrazioni vengono definiti nella proposta, in base alla complessità e alle attività
            necessarie. Durata e condizioni sono concordate prima dell’avvio.
          </p>
        </div>
        <div class="adv-pricing__custom">
          <div>
            <h3>Google e Meta, insieme?</h3><p>
              Un piano su misura per coordinare canali, mercati e investimenti.
            </p>
          </div><Button
            href="#consulenza"
            variant="secondary"
            data-advertising-channel="Google Ads e Meta Ads"
            >Valutiamo il piano insieme<IconArrowUpRight aria-hidden="true" /></Button
          >
        </div>
      </Container>
    </Section>

    <Section id="team" labelledby="team-title" class="adv-team">
      <Container wide>
        <div class="adv-team__intro">
          <div class="adv-avatar-stack adv-avatar-stack--team" aria-hidden="true">
            {
              people.slice(0, 4).map((person) => (
                <span>
                  <img src={person.image} alt="" width="56" height="56" loading="lazy" />
                </span>
              ))
            }
          </div><p>Persone reali. Competenze che si parlano.</p>
        </div>
        <TeamSection
          titleId="team-title"
          title="Un team dalla tua parte. In ogni fase."
          text="Marketing, design e sviluppo allo stesso tavolo. Per dare continuità alle idee e risposte concrete al tuo progetto."
          people={people}
          showProfiles={false}
        />
        <div class="adv-team__numbers">
          <div>
            <strong data-motion-count="1986">1986</strong><span
              >L’anno da cui affianchiamo le imprese.</span
            >
          </div><div>
            <strong>Una regia.</strong><span>Strategia, creatività e tecnologia coordinate.</span>
          </div><Button href="#consulenza" size="large"
            >Conosciamoci<IconArrowUpRight aria-hidden="true" /></Button
          >
        </div>
      </Container>
    </Section>

    <Section id="recensioni" labelledby="reviews-title"
      ><Container wide
        ><ReviewsSection
          titleId="reviews-title"
          reviews={landingReviews}
          title="Il rapporto conta. Lo raccontano i nostri clienti."
          text="Esperienze pubblicate su Google da chi ha lavorato con Netmarket."
          rating={googleTrust.rating}
          reviewCount={googleTrust.reviewCount}
          googleHref={googleTrust.profileHref}
        /></Container
      ></Section
    >

    <Section id="domande" labelledby="faq-title" class="adv-faq"
      ><Container wide
        ><FAQBlock
          titleId="faq-title"
          title="Prima di sentirci, facciamo chiarezza."
          text="Budget, tempi e attività. Le risposte alle domande da cui parte ogni buon progetto."
          items={advertisingFaq}
        /></Container
      ></Section
    >

    <Section id="consulenza" labelledby="consultation-title" class="adv-consultation">
      <Container wide
        ><div class="adv-consultation__grid">
          <div>
            <SectionHeading
              id="consultation-title"
              reveal
              eyebrow="Primo confronto gratuito, senza impegno."
              ><Fragment slot="title"
                ><span class="adv-contact-title-line">Raccontaci dove </span><span
                  class="adv-contact-title-line">vuoi arrivare.</span
                ></Fragment
              ></SectionHeading
            >
            <p class="adv-consultation__offer">
              Gestione da <strong>400 €/mese per canale.</strong><span
                >+ IVA · Budget pubblicitario escluso.</span
              >
            </p>
            <ol class="adv-next">
              <li><span>01</span>Leggiamo la tua richiesta.</li><li>
                <span>02</span>Ci confrontiamo su obiettivi e priorità.
              </li><li><span>03</span>Valutiamo il percorso più adatto.</li>
            </ol>
          </div><div class="adv-consultation__form">
            <div class="adv-consultation__form-heading">
              <h3>Partiamo dal tuo obiettivo.</h3>
            </div>
            <ContactForm
              serviceLabel="Cosa vuoi ottenere?"
              servicePlaceholder="Seleziona il tuo obiettivo"
              serviceErrorMessage="Seleziona il tuo obiettivo."
              serviceOptions={[
                { value: 'contatti-preventivi', label: 'Contatti e preventivi' },
                { value: 'vendite-ecommerce', label: 'Vendite ecommerce' },
                { value: 'notorieta-brand', label: 'Notorietà del brand' },
                { value: 'da-definire', label: 'Da definire insieme' }
              ]}
              showEmailFallback={false}
              submitLabel="Richiedi confronto gratuito"
              formId="advertising-landing"
              channelOptions={[
                { value: 'Google Ads', label: 'Google Ads' },
                { value: 'Meta Ads', label: 'Meta Ads' },
                { value: 'Google Ads e Meta Ads', label: 'Google Ads e Meta Ads' }
              ]}
            />
          </div>
        </div></Container
      >
    </Section>
  </div>

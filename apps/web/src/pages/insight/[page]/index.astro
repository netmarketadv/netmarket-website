---
import { absoluteCanonical, breadcrumbJsonLd } from '@netmarket/seo';
import BaseLayout from '@/layouts/BaseLayout.astro';
import InsightArchive from '@/components/insights/InsightArchive.astro';
import { getInsightArchiveData, getInsightPage, insightDescription, insightPath } from '@/lib/insights/content';

export async function getStaticPaths() {
  const { totalPages } = await getInsightArchiveData();
  return Array.from({ length: Math.max(0, totalPages - 1) }, (_, index) => ({ params: { page: String(index + 2) } }));
}

const canonicalSiteUrl = 'https://netmarket.it';
const page = Number(Astro.params.page || 1);
const [pageData, archive] = await Promise.all([getInsightPage(page), getInsightArchiveData()]);
if (!Number.isInteger(page) || page < 2 || page > pageData.totalPages) return Astro.redirect('/404/');
const title = `Insight - pagina ${page}`;
const description = `Archivio Insights Netmarket, pagina ${page}: analisi su web, ecommerce, marketing, comunicazione e tecnologia.`;
const path = `/insight/${page}/`;
const canonicalUrl = absoluteCanonical(canonicalSiteUrl, path);
const breadcrumb = breadcrumbJsonLd([{ name: 'Home', url: `${canonicalSiteUrl}/` }, { name: 'Insight', url: `${canonicalSiteUrl}/insight/` }, { name: `Pagina ${page}`, url: canonicalUrl }]);
const collectionSchema = {
  '@context': 'https://schema.org', '@type': 'CollectionPage', '@id': `${canonicalUrl}#collection`, name: title, description, url: canonicalUrl,
  mainEntity: { '@type': 'ItemList', numberOfItems: pageData.insights.length, itemListElement: pageData.insights.map((insight, index) => ({ '@type': 'ListItem', position: index + 1, url: absoluteCanonical(canonicalSiteUrl, insightPath(insight.slug)), name: insight.title, description: insightDescription(insight) })) }
};
---

<BaseLayout title={title} description={description} path={path} canonicalSiteUrl={canonicalSiteUrl} structuredData={[breadcrumb, collectionSchema]} motionMode="light">
  <InsightArchive insights={pageData.insights} allInsights={archive.insights} page={page} totalPages={pageData.totalPages} />
</BaseLayout>

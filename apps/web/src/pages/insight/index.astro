---
import { absoluteCanonical, breadcrumbJsonLd } from '@netmarket/seo';
import BaseLayout from '@/layouts/BaseLayout.astro';
import InsightArchive from '@/components/insights/InsightArchive.astro';
import { getInsightArchiveData, getInsightPage, insightDescription, insightPath } from '@/lib/insights/content';

const canonicalSiteUrl = 'https://netmarket.it';
const [{ insights, totalPages }, archive] = await Promise.all([getInsightPage(1), getInsightArchiveData()]);
const title = 'Insight su web, marketing e tecnologia';
const description = 'Analisi e guide Netmarket per imprenditori e manager su siti web, ecommerce, SEO, marketing, comunicazione, social media, AI e tecnologia.';
const canonicalUrl = absoluteCanonical(canonicalSiteUrl, '/insight/');
const breadcrumb = breadcrumbJsonLd([{ name: 'Home', url: `${canonicalSiteUrl}/` }, { name: 'Insight', url: canonicalUrl }]);
const collectionSchema = {
  '@context': 'https://schema.org', '@type': 'CollectionPage', '@id': `${canonicalUrl}#collection`, name: title, description, url: canonicalUrl,
  publisher: { '@id': absoluteCanonical(canonicalSiteUrl, '/#organization') },
  mainEntity: { '@type': 'ItemList', numberOfItems: insights.length, itemListElement: insights.map((insight, index) => ({ '@type': 'ListItem', position: index + 1, url: absoluteCanonical(canonicalSiteUrl, insightPath(insight.slug)), name: insight.title, description: insightDescription(insight) })) }
};
---

<BaseLayout title={title} description={description} path="/insight/" canonicalSiteUrl={canonicalSiteUrl} structuredData={[breadcrumb, collectionSchema]} motionMode="light">
  <InsightArchive insights={insights} allInsights={archive.insights} totalPages={totalPages} showFeatured />
</BaseLayout>

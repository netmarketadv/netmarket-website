---
import Seo from '@/components/seo/Seo.astro';
import SkipLink from '@/components/global/SkipLink.astro';
import SiteHeader from '@/components/layout/SiteHeader.astro';
import SiteFooter from '@/components/layout/SiteFooter.astro';
import TrackingController from '@/components/analytics/TrackingController.astro';
import MotionController from '@/components/motion/MotionController.astro';
import '@/styles/tokens.css';
import '@/styles/reset.css';
import '@/styles/global.css';
import '@/styles/utilities.css';
import type { MediaAsset } from '@netmarket/schemas';

interface Props {
  title: string;
  description: string;
  path?: string;
  noindex?: boolean;
  noindexFollow?: boolean;
  canonicalSiteUrl?: string | undefined;
  structuredData?: Array<Record<string, unknown>>;
  motionMode?: 'full' | 'light';
  socialTitle?: string | undefined;
  socialDescription?: string | undefined;
  socialImage?: MediaAsset | null | undefined;
  socialType?: 'website' | 'article';
}

const {
  title,
  description,
  path = '/',
  noindex = false,
  noindexFollow = false,
  canonicalSiteUrl,
  structuredData = [],
  motionMode = 'full',
  socialTitle,
  socialDescription,
  socialImage,
  socialType = 'website'
} = Astro.props;
const buildSha = import.meta.env.PUBLIC_BUILD_SHA ?? process.env.GITHUB_SHA ?? 'local';
const buildTime =
  import.meta.env.PUBLIC_BUILD_TIME ?? process.env.PUBLIC_BUILD_TIME ?? new Date().toISOString();
const buildEnvironment = import.meta.env.PUBLIC_DEPLOY_ENV ?? 'local';
---

<!doctype html>
<html
  lang="it"
  data-motion-mode={motionMode}
  data-netmarket-build={buildSha}
  data-netmarket-environment={buildEnvironment}
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <meta name="netmarket-build" content={buildSha} />
    <meta name="netmarket-build-time" content={buildTime} />
    <meta name="netmarket-environment" content={buildEnvironment} />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    <Seo
      title={title}
      description={description}
      path={path}
      noindex={noindex}
      noindexFollow={noindexFollow}
      canonicalSiteUrl={canonicalSiteUrl}
      structuredData={structuredData}
      socialTitle={socialTitle}
      socialDescription={socialDescription}
      socialImage={socialImage}
      socialType={socialType}
    />
  </head>
  <body>
    <SkipLink />
    <SiteHeader />
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <SiteFooter />
    <TrackingController />
    <MotionController />
  </body>
</html>

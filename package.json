{
  "name": "netmarket-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.13.1",
  "engines": {
    "node": ">=22 <25",
    "pnpm": ">=10 <12"
  },
  "scripts": {
    "dev": "pnpm --filter @netmarket/web dev",
    "build": "pnpm --filter @netmarket/web build",
    "build:production-candidate": "PUBLIC_SITE_URL=https://netmarket.it PUBLIC_CMS_URL=https://cms.netmarket.it PUBLIC_DEPLOY_ENV=production PUBLIC_ANALYTICS_ENABLED=true PUBLIC_GTM_ID=GTM-K782CJ46 CMS_API_BASE_URL=https://cms.netmarket.it/wp-json/netmarket/v1/ pnpm build && node infrastructure/scripts/audit-production-build.mjs",
    "audit:production-build": "node infrastructure/scripts/audit-production-build.mjs",
    "smoke:production": "node infrastructure/scripts/smoke-production.mjs",
    "smoke:production:seo": "node infrastructure/scripts/seo-smoke-production.mjs",
    "validate:production:redirects": "node infrastructure/scripts/validate-production-redirects.mjs",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "check:fast": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "test:e2e": "pnpm --filter @netmarket/web test:e2e",
    "test:e2e:smoke": "pnpm --filter @netmarket/web test:e2e:smoke",
    "smoke:staging": "node infrastructure/scripts/smoke-staging.mjs",
    "content:validate": "node infrastructure/scripts/content-validate.mjs",
    "migration:validate:case-studies": "node infrastructure/migrations/case-studies/validate.mjs",
    "migration:case-studies:write": "node infrastructure/migrations/case-studies/validate.mjs --write",
    "migration:validate:insights": "node infrastructure/migrations/insights/validate.mjs",
    "migration:insights:write": "node infrastructure/migrations/insights/validate.mjs --write",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "php:lint": "find apps/wordpress/plugins/netmarket-headless-core -name '*.php' -not -path '*/vendor/*' -print0 | xargs -0 -n1 php -l",
    "php:cs": "composer --working-dir=apps/wordpress/plugins/netmarket-headless-core run phpcs",
    "php:stan": "composer --working-dir=apps/wordpress/plugins/netmarket-headless-core run phpstan",
    "secrets:scan": "node infrastructure/scripts/scan-secrets.mjs",
    "validate": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm php:lint && pnpm php:cs && pnpm php:stan && pnpm secrets:scan"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@playwright/test": "^1.54.0",
    "@typescript-eslint/eslint-plugin": "^8.38.0",
    "@typescript-eslint/parser": "^8.38.0",
    "eslint": "^10.9.1",
    "eslint-plugin-astro": "^1.3.1",
    "prettier": "^3.6.2",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}

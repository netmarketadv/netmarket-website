=\"widget\" data-widget_type=\"heading.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t<span class=\"elementor-heading-title elementor-size-default\">Cliente</span>\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class=\"elementor-element elementor-element-54b5ba3 elementor-widget elementor-widget-heading\" data-id=\"54b5ba3\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"heading.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t<span class=\"elementor-heading-title elementor-size-default\">Sirene Blu</span>\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t<div class=\"elementor-element elementor-element-c53a80f e-con-full e-flex e-con e-child\" data-id=\"c53a80f\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t<div class=\"elementor-element elementor-element-caa048a elementor-widget__width-initial sc-reveal elementor-widget-mobile__width-initial elementor-widget elementor-widget-heading\" data-id=\"caa048a\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"heading.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t<h1 class=\"elementor-heading-title elementor-size-default\">Concorso a premi Sirene Blu 2024: ideazione, sviluppo e gestione completa</h1>\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class=\"elementor-element elementor-element-181f30d elementor-widget__width-initial elementor-widget elementor-widget-text-editor\" data-id=\"181f30d\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t\t\t<p data-start=\"823\" data-end=\"925\">Dalla strategia alla piattaforma digitale, fino alla gestione normativa e operativa</p>\t\t\t\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t<div class=\"elementor-element elementor-element-517f66f e-con-full e-flex e-con e-child\" data-id=\"517f66f\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t<div class=\"elementor-element elementor-element-67902aa elementor-widget elementor-widget-heading\" data-id=\"67902aa\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"heading.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t<span class=\"elementor-heading-title elementor-size-default\">Anno</span>\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class=\"elementor-element elementor-element-32ea5d4 elementor-widget elementor-widget-heading\" data-id=\"32ea5d4\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"heading.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t<span class=\"elementor-heading-title elementor-size-default\">2024</span>\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t<div class=\"elementor-element elementor-element-b243232 nm-text-reveal e-flex e-con-boxed e-con e-parent\" data-id=\"b243232\" data-element_type=\"container\" data-e-type=\"container\" data-settings=\"{&quot;background_background&quot;:&quot;classic&quot;}\">\n\t\t\t\t\t<div class=\"e-con-inner\">\n\t\t<div class=\"elementor-element elementor-element-578d7af e-con-full nm-reveal-wrap e-flex e-con e-child\" data-id=\"578d7af\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t<div class=\"elementor-element elementor-element-beeabc4 nm-fade-text elementor-widget elementor-widget-text-editor\" data-id=\"beeabc4\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t\t\t<p data-start=\"404\" data-end=\"656\">Il concorso a premi Sirene Blu 2024 nasce con l’obiettivo di aumentare il traffico nei punti vendita e incentivare la partecipazione attiva dei clienti attraverso una meccanica semplice ma efficace, garantendo al tempo stesso una gestione completamente conforme dal punto di vista normativo.</p><p data-start=\"404\" data-end=\"656\">Il progetto richiedeva un coordinamento completo tra strategia, creatività, tecnologia e burocrazia, con vincoli legati alla normativa sui concorsi a premi, alla gestione delle anagrafiche e al rispetto del GDPR.</p><p data-start=\"404\" data-end=\"656\">Per questo abbiamo sviluppato un intervento integrato che ha coperto tutte le fasi: ideazione della meccanica e del concept, definizione del naming e dell’identità visiva, realizzazione dei materiali di comunicazione per stampa e digitale, sviluppo di una piattaforma web dedicata per il caricamento degli scontrini e la verifica immediata delle vincite, gestione completa degli aspetti burocratici e normativi, e integrazione dei dati nel rispetto delle normative sulla privacy.</p>\t\t\t\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t<div class=\"elementor-element elementor-element-404897a e-flex e-con-boxed e-con e-parent\" data-id=\"404897a\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t\t<div class=\"e-con-inner\">\n\t\t\t\t<div class=\"elementor-element elementor-element-6727c92 elementor-widget elementor-widget-image\" data-id=\"6727c92\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"image.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<img loading=\"lazy\" decoding=\"async\" data-src=\"https://netmarket.it/wp-content/uploads/2024/10/branding-aziendale-sirene-blu-2-1024x576.jpg\" data-srcset=\"https://netmarket.it/wp-content/uploads/2024/10/branding-aziendale-sirene-blu-2-1024x576.jpg 1024w, https://netmarket.it/wp-content/uploads/2024/10/branding-aziendale-sirene-blu-2-300x169.jpg 300w, https://netmarket.it/wp-content/uploads/2024/10/branding-aziendale-sirene-blu-2-768x432.jpg 768w, https://netmarket.it/wp-content/uploads/2024/10/branding-aziendale-sirene-blu-2.jpg 1080w\" width=\"800\" height=\"450\" src=\"data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7\" class=\"attachment-large size-large wp-image-4651 lazyload\" alt=\"\"  sizes=\"(max-width: 800px) 100vw, 800px\" /><noscript><img loading=\"lazy\" decoding=\"async\" width=\"800\" height=\"450\" src=\"https://netmarket.it/wp-content/uploads/2024/10/branding-aziendale-sirene-blu-2-1024x576.jpg\" class=\"attachment-large size-large wp-image-4651\" alt=\"\" srcset=\"https://netmarket.it/wp-content/uploads/2024/10/branding-aziendale-sirene-blu-2-1024x576.jpg 1024w, https://netmarket.it/wp-content/uploads/2024/10/branding-aziendale-sirene-blu-2-300x169.jpg 300w, https://netmarket.it/wp-content/uploads/2024/10/branding-aziendale-sirene-blu-2-768x432.jpg 768w, https://netmarket.it/wp-content/uploads/2024/10/branding-aziendale-sirene-blu-2.jpg 1080w\" sizes=\"(max-width: 800px) 100vw, 800px\"></noscript>\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class=\"elementor-element elementor-element-a768184 elementor-widget elementor-widget-image\" data-id=\"a768184\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"image.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<img loading=\"lazy\" decoding=\"async\" data-src=\"https://netmarket.it/wp-content/uploads/2024/10/branding-aziendale--1024x576.jpg\" data-srcset=\"https://netmarket.it/wp-content/uploads/2024/10/branding-aziendale--1024x576.jpg 1024w, https://netmarket.it/wp-content/uploads/2024/10/branding-aziendale--300x169.jpg 300w, https://netmarket.it/wp-content/uploads/2024/10/branding-aziendale--768x432.jpg 768w, https://netmarket.it/wp-content/uploads/2024/10/branding-aziendale-.jpg 1080w\" width=\"800\" height=\"450\" src=\"data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7\" class=\"attachment-large size-large wp-image-4650 lazyload\" alt=\"\"  sizes=\"(max-width: 800px) 100vw, 800px\" /><noscript><img loading=\"lazy\" decoding=\"async\" width=\"800\" height=\"450\" src=\"https://netmarket.it/wp-content/uploads/2024/10/branding-aziendale--1024x576.jpg\" class=\"attachment-large size-large wp-image-4650\" alt=\"\" srcset=\"https://netmarket.it/wp-content/uploads/2024/10/branding-aziendale--1024x576.jpg 1024w, https://netmarket.it/wp-content/uploads/2024/10/branding-aziendale--300x169.jpg 300w, https://netmarket.it/wp-content/uploads/2024/10/branding-aziendale--768x432.jpg 768w, https://netmarket.it/wp-content/uploads/2024/10/branding-aziendale-.jpg 1080w\" sizes=\"(max-width: 800px) 100vw, 800px\"></noscript>\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t",

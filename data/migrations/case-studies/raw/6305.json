-element elementor-element-8160891 elementor-widget elementor-widget-heading\" data-id=\"8160891\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"heading.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t<h4 class=\"elementor-heading-title elementor-size-default\">Manutenzione</h4>\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class=\"elementor-element elementor-element-61ca434 elementor-widget elementor-widget-heading\" data-id=\"61ca434\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"heading.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t<h4 class=\"elementor-heading-title elementor-size-default\">Supporto documentale</h4>\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t<div class=\"elementor-element elementor-element-e79ae2d e-flex e-con-boxed e-con e-parent\" data-id=\"e79ae2d\" data-element_type=\"container\" data-e-type=\"container\" data-settings=\"{&quot;background_background&quot;:&quot;classic&quot;}\">\n\t\t\t\t\t<div class=\"e-con-inner\">\n\t\t<div class=\"elementor-element elementor-element-05d9816 e-con-full e-flex e-con e-child\" data-id=\"05d9816\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t<div class=\"elementor-element elementor-element-094691d elementor-widget elementor-widget-heading\" data-id=\"094691d\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"heading.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t<span class=\"elementor-heading-title elementor-size-default\">Cliente</span>\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class=\"elementor-element elementor-element-ebf019c elementor-widget elementor-widget-heading\" data-id=\"ebf019c\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"heading.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t<span class=\"elementor-heading-title elementor-size-default\">Venitaly</span>\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t<div class=\"elementor-element elementor-element-3355e11 e-con-full e-flex e-con e-child\" data-id=\"3355e11\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t<div class=\"elementor-element elementor-element-dee3dfa elementor-widget__width-initial sc-reveal elementor-widget-mobile__width-initial elementor-widget elementor-widget-heading\" data-id=\"dee3dfa\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"heading.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t<h1 class=\"elementor-heading-title elementor-size-default\">Sviluppo CRM VENITALY: software custom, manutenzione e supporto applicativo</h1>\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class=\"elementor-element elementor-element-1b495ae elementor-widget__width-initial elementor-widget elementor-widget-text-editor\" data-id=\"1b495ae\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t\t\t<p data-start=\"823\" data-end=\"925\">Un gestionale sviluppato da Netmarket per supportare le attività operative di VENITALY, con manutenzione continuativa, gestione degli account e interventi tecnici in contesti critici.</p>\t\t\t\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t<div class=\"elementor-element elementor-element-a6b6e2d e-con-full e-flex e-con e-child\" data-id=\"a6b6e2d\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t<div class=\"elementor-element elementor-element-01b4eb2 elementor-widget elementor-widget-heading\" data-id=\"01b4eb2\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"heading.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t<span class=\"elementor-heading-title elementor-size-default\">Anno</span>\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t<div class=\"elementor-element elementor-element-f2c2e9c nm-text-reveal e-flex e-con-boxed e-con e-parent\" data-id=\"f2c2e9c\" data-element_type=\"container\" data-e-type=\"container\" data-settings=\"{&quot;background_background&quot;:&quot;classic&quot;}\">\n\t\t\t\t\t<div class=\"e-con-inner\">\n\t\t<div class=\"elementor-element elementor-element-ad061f6 e-con-full nm-reveal-wrap e-flex e-con e-child\" data-id=\"ad061f6\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t<div class=\"elementor-element elementor-element-e61c1e5 nm-fade-text elementor-widget elementor-widget-text-editor\" data-id=\"e61c1e5\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t\t\t<p class=\"isSelectedEnd\">VENITALY utilizza un CRM custom sviluppato da Netmarket per gestire attività operative, dati e processi interni in modo più ordinato e strutturato.</p><p> </p><p class=\"isSelectedEnd\">Netmarket ha seguito lo sviluppo del gestionale e continua ad affiancare il cliente con manutenzione applicativa, supporto tecnico e interventi evolutivi. In un contesto operativo critico, l’attività ha incluso anche il censimento degli account, l’aggiornamento delle credenziali e il blocco degli accessi non autorizzati.</p><p> </p><p>Un progetto meno visibile dal punto di vista estetico, ma centrale per raccontare una competenza concreta: la capacità di sviluppare e mantenere software gestionali custom, garantendo supporto tecnico e continuità operativa nel tempo.</p>\t\t\t\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t<div class=\"elementor-element elementor-element-6288082 e-flex e-con-boxed e-con e-parent\" data-id=\"6288082\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t\t<div class=\"e-con-inner\">\n\t\t<div class=\"elementor-element elementor-element-8043011 e-flex e-con-boxed e-con e-child\" data-id=\"8043011\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t\t<div class=\"e-con-inner\">\n\t\t\t\t<div class=\"elementor-element elementor-element-cf95692 elementor-widget elementor-widget-image\" data-id=\"cf95692\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"image.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<img loading=\"lazy\" decoding=\"async\" data-src=\"https://netmarket.it/wp-content/uploads/2026/06/sviluppo-software-gestionale-venitaly-1024x576.webp\" data-srcset=\"https://netmarket.it/wp-content/uploads/2026/06/sviluppo-software-gestionale-venitaly-1024x576.webp 1024w, https://netmarket.it/wp-content/uploads/2026/06/sviluppo-software-gestionale-venitaly-300x169.webp 300w, https://netmarket.it/wp-content/uploads/2026/06/sviluppo-software-gestionale-venitaly-768x432.webp 768w, https://netmarket.it/wp-content/uploads/2026/06/sviluppo-software-gestionale-venitaly-1536x864.webp 1536w, https://netmarket.it/wp-content/uploads/2026/06/sviluppo-software-gestionale-venitaly.webp 1672w\" width=\"800\" height=\"450\" src=\"data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7\" class=\"attachment-large size-large wp-image-6307 lazyload\" alt=\"\"  sizes=\"(max-width: 800px) 100vw, 800px\" /><noscript><img loading=\"lazy\" decoding=\"async\" width=\"800\" height=\"450\" src=\"https://netmarket.it/wp-content/uploads/2026/06/sviluppo-software-gestionale-venitaly-1024x576.webp\" class=\"attachment-large size-large wp-image-6307\" alt=\"\" srcset=\"https://netmarket.it/wp-content/uploads/2026/06/sviluppo-software-gestionale-venitaly-1024x576.webp 1024w, https://netmarket.it/wp-content/uploads/2026/06/sviluppo-software-gestionale-venitaly-300x169.webp 300w, https://netmarket.it/wp-content/uploads/2026/06/sviluppo-software-gestionale-venitaly-768x432.webp 768w, https://netmarket.it/wp-content/uploads/2026/06/sviluppo-software-gestionale-v
ge-5961 lazyload\" alt=\"\"  sizes=\"(max-width: 526px) 100vw, 526px\" /><noscript><img loading=\"lazy\" decoding=\"async\" width=\"526\" height=\"702\" src=\"https://netmarket.it/wp-content/uploads/2025/01/feed-instagram-social-brb.png\" class=\"attachment-large size-large wp-image-5961\" alt=\"\" srcset=\"https://netmarket.it/wp-content/uploads/2025/01/feed-instagram-social-brb.png 526w, https://netmarket.it/wp-content/uploads/2025/01/feed-instagram-social-brb-225x300.png 225w\" sizes=\"(max-width: 526px) 100vw, 526px\"></noscript>\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t<div class=\"elementor-element elementor-element-89cc352 e-flex e-con-boxed e-con e-child\" data-id=\"89cc352\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t\t<div class=\"e-con-inner\">\n\t\t\t\t<div class=\"elementor-element elementor-element-dba1ccd elementor-widget elementor-widget-heading\" data-id=\"dba1ccd\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"heading.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t<h2 class=\"elementor-heading-title elementor-size-default\">Come lo abbiamo realizzato</h2>\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t<div class=\"elementor-element elementor-element-6b11659 e-con-full e-flex e-con e-child\" data-id=\"6b11659\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t<div class=\"elementor-element elementor-element-1141d62 elementor-widget elementor-widget-heading\" data-id=\"1141d62\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"heading.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t<h3 class=\"elementor-heading-title elementor-size-default\">Strategia e posizionamento</h3>\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class=\"elementor-element elementor-element-4d7d613 elementor-widget elementor-widget-text-editor\" data-id=\"4d7d613\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t\t\t<p data-start=\"1639\" data-end=\"1863\">Abbiamo ridefinito il progetto partendo dai dati e dal mercato, costruendo una strategia che integrasse social, contenuti e piattaforma e-commerce, con l’obiettivo di generare traffico qualificato e aumentare la conversione.</p>\t\t\t\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t<div class=\"elementor-element elementor-element-e9c42bf e-con-full e-flex e-con e-child\" data-id=\"e9c42bf\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t<div class=\"elementor-element elementor-element-77ce78f elementor-widget elementor-widget-heading\" data-id=\"77ce78f\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"heading.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t<h3 class=\"elementor-heading-title elementor-size-default\">Sistema contenuti e identità visiva</h3>\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class=\"elementor-element elementor-element-bec77d7 elementor-widget elementor-widget-text-editor\" data-id=\"bec77d7\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t\t\t<p data-start=\"1907\" data-end=\"2125\">È stata sviluppata una nuova linea visiva coerente e riconoscibile, progettata nel dettaglio anche a livello di griglia di pubblicazione, per aumentare la percezione del brand e migliorare la leggibilità dei contenuti.</p>\t\t\t\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t<div class=\"elementor-element elementor-element-586859f e-con-full e-flex e-con e-child\" data-id=\"586859f\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t<div class=\"elementor-element elementor-element-13debfb elementor-widget elementor-widget-heading\" data-id=\"13debfb\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"heading.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t<h3 class=\"elementor-heading-title elementor-size-default\">E-commerce e struttura SEO</h3>\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class=\"elementor-element elementor-element-df98f04 elementor-widget elementor-widget-text-editor\" data-id=\"df98f04\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t\t\t<p data-start=\"2160\" data-end=\"2367\">In contemporanea, abbiamo progettato e sviluppato il nuovo e-commerce, strutturato per intercettare traffico organico e supportare la conversione attraverso categorie, schede prodotto e contenuti editoriali.</p>\t\t\t\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t<div class=\"elementor-element elementor-element-c221567 e-flex e-con-boxed e-con e-parent\" data-id=\"c221567\" data-element_type=\"container\" data-e-type=\"container\" data-settings=\"{&quot;background_background&quot;:&quot;classic&quot;}\">\n\t\t\t\t\t<div class=\"e-con-inner\">\n\t\t\t\t<div class=\"elementor-element elementor-element-1dba246 elementor-widget__width-initial sc-reveal elementor-widget-mobile__width-initial elementor-widget elementor-widget-heading\" data-id=\"1dba246\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"heading.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t<h2 class=\"elementor-heading-title elementor-size-default\">Risultati</h2>\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class=\"elementor-element elementor-element-4d88631 elementor-widget__width-initial elementor-widget elementor-widget-text-editor\" data-id=\"4d88631\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t
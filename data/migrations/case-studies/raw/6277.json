e=\"container\" data-e-type=\"container\">\n\t\t<div class=\"elementor-element elementor-element-6a6b7e9 animated-fast e-flex e-con-boxed elementor-invisible e-con e-child\" data-id=\"6a6b7e9\" data-element_type=\"container\" data-e-type=\"container\" data-settings=\"{&quot;animation&quot;:&quot;fadeInUp&quot;}\">\n\t\t\t\t\t<div class=\"e-con-inner\">\n\t\t\t\t<div class=\"elementor-element elementor-element-5bd6fd2 elementor-widget elementor-widget-heading\" data-id=\"5bd6fd2\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"heading.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t<span class=\"elementor-heading-title elementor-size-default\">Analisi strategica</span>\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class=\"elementor-element elementor-element-cd6727d elementor-widget-mobile__width-initial elementor-widget elementor-widget-heading\" data-id=\"cd6727d\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"heading.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t<p class=\"elementor-heading-title elementor-size-default\">Studio del posizionamento, dei competitor e dell’offerta</p>\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t<div class=\"elementor-element elementor-element-7d8f582 animated-fast e-flex e-con-boxed elementor-invisible e-con e-child\" data-id=\"7d8f582\" data-element_type=\"container\" data-e-type=\"container\" data-settings=\"{&quot;animation&quot;:&quot;fadeInUp&quot;,&quot;animation_delay&quot;:200}\">\n\t\t\t\t\t<div class=\"e-con-inner\">\n\t\t\t\t<div class=\"elementor-element elementor-element-62b0d09 elementor-widget elementor-widget-heading\" data-id=\"62b0d09\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"heading.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t<span class=\"elementor-heading-title elementor-size-default\">Portfolio progetti</span>\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class=\"elementor-element elementor-element-e557520 elementor-widget-mobile__width-initial elementor-widget elementor-widget-heading\" data-id=\"e557520\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"heading.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t<p class=\"elementor-heading-title elementor-size-default\">Sezione dedicata alla raccolta e valorizzazione dei casi studio</p>\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t<div class=\"elementor-element elementor-element-c7fb3f8 animated-fast e-flex e-con-boxed elementor-invisible e-con e-child\" data-id=\"c7fb3f8\" data-element_type=\"container\" data-e-type=\"container\" data-settings=\"{&quot;animation&quot;:&quot;fadeInUp&quot;,&quot;animation_delay&quot;:400}\">\n\t\t\t\t\t<div class=\"e-con-inner\">\n\t\t\t\t<div class=\"elementor-element elementor-element-309840a elementor-widget elementor-widget-heading\" data-id=\"309840a\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"heading.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t<span class=\"elementor-heading-title elementor-size-default\">Lead generation</span>\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class=\"elementor-element elementor-element-4944f3b elementor-widget-mobile__width-initial elementor-widget elementor-widget-heading\" data-id=\"4944f3b\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"heading.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t<p class=\"elementor-heading-title elementor-size-default\">\nModulo con invio automatico del catalogo aziendale</p>\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t<div class=\"elementor-element elementor-element-b243232 nm-text-reveal e-flex e-con-boxed e-con e-parent\" data-id=\"b243232\" data-element_type=\"container\" data-e-type=\"container\" data-settings=\"{&quot;background_background&quot;:&quot;classic&quot;}\">\n\t\t\t\t\t<div class=\"e-con-inner\">\n\t\t<div class=\"elementor-element elementor-element-578d7af e-con-full nm-reveal-wrap e-flex e-con e-child\" data-id=\"578d7af\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t<div class=\"elementor-element elementor-element-beeabc4 nm-fade-text elementor-widget elementor-widget-text-editor\" data-id=\"beeabc4\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t\t\t<p class=\"isSelectedEnd\">Albertini Allestimenti aveva bisogno di rinnovare completamente la propria presenza digitale, con un sito capace di raccontare in modo più chiaro servizi, competenze e progetti realizzati.</p><p> </p><p class=\"isSelectedEnd\">Netmarket ha seguito il progetto partendo da analisi, studio grafico, analisi dei competitor, posizionamento, SEO research e definizione dell’alberatura. Il lavoro ha portato allo sviluppo di un nuovo sito istituzionale, con sezioni dedicate ai servizi, area casi studio e modulo per la richiesta automatizzata del catalogo.</p><p> </p><p>Il risultato è una piattaforma più moderna, ordinata e orientata al contatto, pensata per valorizzare l’esperienza di Albertini nel mondo degli allestimenti fieristici, degli showroom e dell’arredo contract.</p>\t\t\t\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t",

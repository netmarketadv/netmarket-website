    "rendered": "\t\t<div data-elementor-type=\"wp-post\" data-elementor-id=\"6312\" class=\"elementor elementor-6312\" data-elementor-post-type=\"caso-studio\">\n\t\t\t\t<div class=\"elementor-element elementor-element-ad3e1e7 e-flex e-con-boxed e-con e-parent\" data-id=\"ad3e1e7\" data-element_type=\"container\" data-e-type=\"container\" data-settings=\"{&quot;background_background&quot;:&quot;classic&quot;}\">\n\t\t\t\t\t<div class=\"e-con-inner\">\n\t\t\t\t<div class=\"elementor-element elementor-element-df0ae60 client-image-w  elementor-widget elementor-widget-image\" data-id=\"df0ae60\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"image.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<img fetchpriority=\"high\" decoding=\"async\" data-src=\"https://netmarket.it/wp-content/uploads/2026/04/sirene-blu-logo.svg\" width=\"1280\" height=\"1280\" src=\"data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7\" class=\"attachment-large size-large wp-image-5718 lazyload\" alt=\"logo cliente sirene blu\" /><noscript><img decoding=\"async\" width=\"1280\" height=\"1280\" src=\"https://netmarket.it/wp-content/uploads/2026/04/sirene-blu-logo.svg\" class=\"attachment-large size-large wp-image-5718\" alt=\"logo cliente sirene blu\"></noscript>\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t<div class=\"elementor-element elementor-element-8d4deac e-con-full e-flex e-con e-child\" data-id=\"8d4deac\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t<div class=\"elementor-element elementor-element-7c848a5 elementor-widget elementor-widget-heading\" data-id=\"7c848a5\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"heading.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t<h4 class=\"elementor-heading-title elementor-size-default\">Sviluppo app</h4>\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class=\"elementor-element elementor-element-8160891 elementor-widget elementor-widget-heading\" data-id=\"8160891\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"heading.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t<h4 class=\"elementor-heading-title elementor-size-default\">Software custom</h4>\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class=\"elementor-element elementor-element-61ca434 elementor-widget elementor-widget-heading\" data-id=\"61ca434\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"heading.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t<h4 class=\"elementor-heading-title elementor-size-default\">Programma fedeltà</h4>\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t<div class=\"elementor-element elementor-element-e79ae2d e-flex e-con-boxed e-con e-parent\" data-id=\"e79ae2d\" data-element_type=\"container\" data-e-type=\"container\" data-settings=\"{&quot;background_background&quot;:&quot;classic&quot;}\">\n\t\t\t\t\t<div class=\"e-con-inner\">\n\t\t<div class=\"elementor-element elementor-element-05d9816 e-con-full e-flex e-con e-child\" data-id=\"05d9816\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t<div class=\"elementor-element elementor-element-094691d elementor-widget elementor-widget-heading\" data-id=\"094691d\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"heading.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t<span class=\"elementor-heading-title elementor-size-default\">Cliente</span>\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class=\"elementor-element elementor-element-ebf019c elementor-widget elementor-widget-heading\" data-id=\"ebf019c\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"heading.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t<span class=\"elementor-heading-title elementor-size-default\">Sirene Blu</span>\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t<div class=\"elementor-element elementor-element-3355e11 e-con-full e-flex e-con e-child\" data-id=\"3355e11\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t<div class=\"elementor-element elementor-element-dee3dfa elementor-widget__width-initial sc-reveal elementor-widget-mobile__width-initial elementor-widget elementor-widget-heading\" data-id=\"dee3dfa\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"heading.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t<h1 class=\"elementor-heading-title elementor-size-default\">App mobile e programma fedeltà Sirene Blu</h1>\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class=\"elementor-element elementor-element-1b495ae elementor-widget__width-initial elementor-widget elementor-widget-text-editor\" data-id=\"1b495ae\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t\t\t<p data-start=\"823\" data-end=\"925\">Un ecosistema digitale per portare la carta fedeltà sempre con il cliente, collegare app, punti vendita e gestionale casse, e trasformare il programma loyalty in uno strumento di relazione e analisi.</p>\t\t\t\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t<div class=\"elementor-element elementor-element-a6b6e2d e-con-full e-flex e-con e-child\" data-id=\"a6b6e2d\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t<div class=\"elementor-element elementor-element-01b4eb2 elementor-widget elementor-widget-heading\" data-id=\"01b4eb2\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"heading.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t<span class=\"elementor-heading-title elementor-size-default\">Anno</span>\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class=\"elementor-element elementor-element-e4ef04f elementor-widget elementor-widget-heading\" data-id=\"e4ef04f\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"heading.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t<span class=\"elementor-heading-title elementor-size-default\">2025</span>\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t<div class=\"elementor-element elementor-element-36c4ee6 e-flex e-con-boxed e-con e-parent\" data-id=\"36c4ee6\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t\t<div class=\"e-con-inner\">\n\t\t<div class=\"elementor-element elementor-element-a12dff7 e-con-full e-flex e-con e-child\" data-id=\"a12dff7\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t<div class=\"elementor-element elementor-element-4d7d613 elementor-widget elementor-widget-text-editor\" data-id=\"4d7d613\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t\t\t<p class=\"isSelectedEnd\">Sirene Blu è una catena con oltre 70 negozi in Italia dedicati alla cura e all’igiene della persona e alla pulizia della casa. Un’insegna costruita su risparmio, assortimento, qualità e servizio, con un rapporto quotidiano e diretto con migliaia di clienti nei punti vendita.</p><p class=\"isSelectedEnd\">Il progetto affidato a Netmarket nasceva da un’esigenza precisa: trasformare il programma fedeltà in uno strumento digitale più accessibile, integrato e utile sia per il cliente finale sia per l’azienda.</p><p class=\"isSelectedEnd\">Netmarket ha sviluppato l’app mobile Sirene Blu e l’infrastruttura del programma fidelity, progettando un sistema capace di collegare carta fedeltà, anagrafica clienti, logiche di accumulo punti, sconti attivi, volantino mensile, punti vendita e gestionale casse.</p><p class=\"isSelectedEnd\">L’app permette ai clienti di avere la propria carta fedeltà sempre a portata di mano, accumulare punti, accedere a sconti immediati, visualizzare le promozioni disponibili, trovare il negozio più vicino e consultare il volantino mensile. Una soluzione semplice nell’esperienza utente, ma costruita su un impianto tecnico articolato.</p><p class=\"isSelectedEnd\">Il lavoro non si è limitato allo sviluppo dell’app. Netmarket ha progettato anche il programma fedeltà alla base del sistema: gestione dell’anagrafica, logiche di funzionamento, collegamento con i dati cliente e integrazione custom con il gestionale casse. Questo consente al programma fidelity di dialogare con l’operatività reale dei punti vendita, rendendo l’esperienza coerente tra app, negozio fisico e sistema gestionale.</p>\t\t\t\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class=\"elementor-element elementor-element-c0da0f1 elementor-widget elementor-widget-text-editor\" data-id=\"c0da0f1\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t\t\t<p>Il risultato è un ecosistema loyalty che oggi ha superato i 100.000 iscritti. Un dato importante non solo dal punto di vista quantitativo, ma anche strategico: il programma consente a Sirene Blu di costruire una relazione più diretta con i clienti, valorizzare promozioni e offerte, migliorare la fidelizzazione e raccogliere informazioni utili sui comportamenti d’acquisto.</p><p class=\"isSelectedEnd\">Per un’insegna retail con una rete ampia di punti vendita, la fidelity non è solo una carta sconto. È uno strumento di conoscenza. Permette di analizzare frequenza d’acquisto, preferenze, categorie più rilevanti, risposta alle promozioni e abitudini dei clienti nel tempo.</p><p class=\"isSelectedEnd\">Questo apre la strada ad attività più evolute: campagne mirate, offerte più pertinenti, analisi di mercato, segmentazione della base utenti e decisioni commerciali basate su dati reali.</p><p class=\"isSelectedEnd\">L’app Sirene Blu e il programma fedeltà rappresentano quindi un progetto digitale ad alto impatto: uno strumento pensato per semplificare l’esperienza del cliente, supportare i negozi e dare all’azienda una base dati solida su cui costruire strategie di marketing, vendita e relazione.</p><p>Un progetto che racconta bene il modo in cui Netmarket lavora sui software custom: partire da un’esigenza concreta, costruire un sistema stabile, integrarlo con i processi esistenti e trasformarlo in valore misurabile per l’azienda.</p>\t\t\t\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t<div class=\"elementor-element elementor-element-9b38838 e-flex e-con-boxed e-con e-parent\" data-id=\"9b38838\" data-element_type=\"container\" data-e-type=\"container\" data-settings=\"{&quot;background_background&quot;:&quot;classic&quot;}\">\n\t\t\t\t\t<div class=\"e-con-inner\">\n\t\t\t\t<div class=\"elementor-element elementor-element-03c8ed9 elementor-widget__width-initial sc-reveal elementor-widget-mobile__width-initial elementor-widget elementor-widget-heading\" data-id=\"03c8ed9\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"heading.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t<h2 class=\"elementor-heading-title elementor-size-default\">Risultati</h2>\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t<div class=\"elementor-element elementor-element-703b83a e-con-full e-flex e-con e-child\" data-id=\"703b83a\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t<div class=\"elementor-element elementor-element-8f22be5 animated-fast e-flex e-con-boxed elementor-invisible e-con e-child\" data-id=\"8f22be5\" data-element_type=\"container\" data-e-type=\"container\" data-settings=\"{&quot;animation&quot;:&quot;fadeInUp&quot;}\">\n\t\t\t\t\t<div class=\"e-con-inner\">\n\t\t\t\t<div class=\"elementor-element elementor-element-8229b2b elementor-widget elementor-widget-heading\" data-id=\"8229b2b\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"heading.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t<span class=\"elementor-heading-title elementor-size-default\">100<span style=\"opacity:40%\">mila</span></span>\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class=\"elementor-element elementor-element-e40fd81 elementor-widget-mobile__width-initial elementor-widget elementor-widget-heading\" data-id=\"e40fd81\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"heading.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t<p class=\"elementor-heading-title elementor-size-default\">Il programma fedeltà Sirene Blu ha superato quota 100.000 utenti registrati.</p>\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t<div class=\"elementor-element elementor-element-b817f8e animated-fast e-flex e-con-boxed elementor-invisible e-con e-child\" data-id=\"b817f8e\" data-element_type=\"container\" data-e-type=\"container\" data-settings=\"{&quot;animation&quot;:&quot;fadeInUp&quot;,&quot;animation_delay&quot;:200}\">\n\t\t\t\t\t<div class=\"e-con-inner\">\n\t\t\t\t<div class=\"elementor-element elementor-element-e1c0182 elementor-widget elementor-widget-heading\" data-id=\"e1c0182\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"heading.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t<span class=\"elementor-heading-title elementor-size-default\">App mobile</span>\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class=\"elementor-element elementor-element-47136e4 elementor-widget-mobile__width-initial elementor-widget elementor-widget-heading\" data-id=\"47136e4\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"heading.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t<p class=\"elementor-heading-title elementor-size-default\">Carta fedeltà, sconti, punti vendita e volantino sempre accessibili da smartphone.</p>\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t<div class=\"elementor-element elementor-element-b527692 animated-fast e-flex e-con-boxed elementor-invisible e-con e-child\" data-id=\"b527692\" data-element_type=\"container\" data-e-type=\"container\" data-settings=\"{&quot;animation&quot;:&quot;fadeInUp&quot;,&quot;animation_delay&quot;:400}\">\n\t\t\t\t\t<div class=\"e-con-inner\">\n\t\t\t\t<div class=\"elementor-element elementor-element-9fde949 elementor-widget elementor-widget-heading\" data-id=\"9fde949\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"heading.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t<span class=\"elementor-heading-title elementor-size-default\">Integrazione</span>\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class=\"elementor-element elementor-element-98542f2 elementor-widget-mobile__width-initial elementor-widget elementor-widget-heading\" data-id=\"98542f2\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"heading.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t<p class=\"elementor-heading-title elementor-size-default\">Collegamento tra programma fidelity, anagrafica clienti e gestionale casse.</p>\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t<div class=\"elementor-element elementor-element-6d2e021 e-flex e-con-boxed e-con e-parent\" data-id=\"6d2e021\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t\t<div class=\"e-con-inner\">\n\t\t\t\t<div class=\"elementor-element elementor-element-ff14767 elementor-widget elementor-widget-image-carousel\" data-id=\"ff14767\" data-element_type=\"widget\" data-e-type=\"widget\" data-settings=\"{&quot;slides_to_show&quot;:&quot;5&quot;,&quot;slides_to_show_tablet&quot;:&quot;3&quot;,&quot;slides_to_show_mobile&quot;:&quot;2&quot;,&quot;slides_to_scroll_mobile&quot;:&quot;1&q